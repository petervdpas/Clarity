/target
node_modules/
# The screen package's link to the IDE's packages (app/scripts/link-ui.mjs).
runtimes/web/node_modules
/app/dist

# Build output of the C# runtime and its tests.
bin/
obj/

# What Clarity generates and builds for the examples.
/examples/*/out/
# The backups Clarity takes of the examples' databases (docs/BACKUP-PLAN.md).
/examples/*/data/backups/
# The agents' test examples: local only, removed when the C# round is done.
/examples/agents/

# Settings folders older secrets tests left beside where they ran.
/clarity-secret-settings-*/

# Each person's own editor and assistant settings, with paths of their own machine.
/.vscode/
/.claude/
# The native Clarity.UI library a Release build copies in for packing.
/runtimes/csharp/Clarity.Ui/runtimes/
# The Clarity.UI library the IDE's installer carries (.github/scripts/stage-clarity-ui.sh).
/app/src-tauri/clarity-ui/
/app/src-tauri/clarity-ui-browser/

# The Release Helper's plans; it deletes each when done.
/releases/
/runtimes/csharp/Clarity.Audio/runtimes/
