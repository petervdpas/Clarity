# Cargo's build folders: the workspace's, and the one each engine (an
# example's engines/<name>/) and each runtime of its own builds in. An
# engine's built .wasm beside its folder is kept, so the example runs as checked out.
target/
node_modules/
# The screen package's link to the IDE's packages (app/scripts/link-ui.mjs).
runtimes/web/node_modules
/app/dist

# Build output of the C# runtime and its tests.
bin/
obj/

# What Clarity generates and builds for the examples.
/examples/*/out/
# The backups Clarity takes of the examples' databases (docs/ledger/backups.md).
/examples/*/data/backups/
# The files the examples' programs export, such as a saved invoice PDF.
/examples/*/data/exports/

# Settings folders older secrets tests left beside where they ran.
/clarity-secret-settings-*/

# Each person's own editor and assistant settings, with paths of their own machine.
/.vscode/
/.claude/
# The native Clarity.UI library a Release build copies in for packing.
/runtimes/csharp/Clarity.Ui/runtimes/
/runtimes/csharp/Clarity.Runtime/runtimes/
# The Clarity.UI library the IDE's installer carries (.github/scripts/stage-clarity-ui.sh).
/app/src-tauri/clarity-ui/
/app/src-tauri/clarity-ui-browser/
# The runtimes it carries for builds with no internet (.github/scripts/stage-runtimes.sh).
/app/src-tauri/runtimes/
/app/src-tauri/binaries/

# The Release Helper's plans; it deletes each when done.
/releases/
# The native libraries a Release build copies into each C# package for packing;
# the release workflow places every system's own.
/runtimes/csharp/Clarity.Audio/runtimes/
/runtimes/csharp/Clarity.Video/runtimes/
/runtimes/csharp/Clarity.Image/runtimes/
/runtimes/csharp/Clarity.Formats/runtimes/
/runtimes/csharp/Clarity.Auth/runtimes/
