{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clarity",
  "mainBinaryName": "clarity-app",
  "version": "0.1.0",
  "identifier": "dev.clarity.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clarity",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "msi"
    ],
    "publisher": "Peter van de Pas",
    "copyright": "Copyright (c) 2026 Peter van de Pas",
    "homepage": "https://github.com/petervdpas/Clarity",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Design an application once, generate it for every stack",
    "longDescription": "Clarity is a designer and a language for desktop applications: windows, data and logic are designed once and generated as real code for Rust, C# with Avalonia, Go, C and C++.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
