{
  "about": "An app's MCP service (docs/ledger/app-mcp.md) through Clarity.AppMcp, the shared core: each stack serves `tools` (the tool list clarity-gen writes) with the case's `options` and a host that answers as `host` says, and the person grants as `grants` says, one answer for each grant asked, in order. The stack feeds the `send` messages in order and gets every `expect` message in order, compared as JSON; `asked` are the grants asked of the person, each with its tool and kind. A host runs a tool by `print` (the call's text) or `refuse` (a tool error with its text); with `ask` it first asks the agent `message` with the answer's `schema`, then prints `print` when the answer is true, refuses with `kept` on any other answer, a decline or a cancel, and with `unanswered` when the agent's client cannot answer questions. `commandLines` gives the command line a call becomes, which the program reads with its own parser and runs as if typed: the command's words, each option given as `--name=value` (a number as JSON writes it, a bool option that is true as `--name` alone, false or null left out), then `--` and the arguments in their order. `questions` gives what a command's `ask` (its `form`, as command-line.json writes it) asks the agent (`schema`), and, for the agent's `reply`, the answer the command gets as the terminal would give it, or null when there is none (the program then refuses with its no-terminal message): a yes or no is a boolean, a declined or cancelled one is a no; a value is of its kind, with its default, and a declined one takes its default; a choice is one of its texts, answered by its number from 1. `words` are Clarity's own words of a refusal (translations AGENT_KEYS) in English, which a program gives the service as its texts in the language shown: `agentRefused` when the person refused, `agentClosed` while the app is closed; `agentMcp` is what the program's help says of `mcp`; `{app}` is the app's title.",
  "words": {
    "agentRefused": "The person using {app} refused this.",
    "agentClosed": "{app} is not open; open it to allow this.",
    "agentMcp": "Serves the commands for AI agents over MCP"
  },
  "tools": {
    "name": "shop",
    "instructions": "# Shop for agents\n\n## What the app is for\n\nKeeps customers.\n\n## The app's data\n\n- Customer: name (text), kind (Kind: Person, Business)\n",
    "whileClosed": {
      "read": false,
      "change": false
    },
    "atMost": 3,
    "tools": [
      {
        "name": "customer-add",
        "description": "Adds a customer",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "Person",
                "Business"
              ]
            },
            "limit": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000,
              "default": 1000
            },
            "vip": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "kind"
          ],
          "additionalProperties": false
        },
        "changes": {
          "data": true,
          "files": false,
          "settings": false,
          "net": false
        },
        "allow": false,
        "line": [
          "customer",
          "add"
        ],
        "arguments": [
          "name",
          "kind"
        ]
      },
      {
        "name": "customer-count",
        "description": "Counts the customers",
        "inputSchema": {
          "type": "object",
          "properties": {
            "since": {
              "type": "integer",
              "minimum": 2000
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "changes": {
          "data": false,
          "files": false,
          "settings": false,
          "net": false
        },
        "allow": false,
        "line": [
          "customer",
          "count"
        ],
        "arguments": []
      },
      {
        "name": "customer-remove",
        "description": "Removes a customer",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "changes": {
          "data": true,
          "files": false,
          "settings": false,
          "net": false
        },
        "allow": false,
        "line": [
          "customer",
          "remove"
        ],
        "arguments": [
          "name"
        ]
      },
      {
        "name": "report-send",
        "description": "Sends the report",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "changes": {
          "data": false,
          "files": false,
          "settings": false,
          "net": true
        },
        "allow": true,
        "line": [
          "report",
          "send"
        ],
        "arguments": []
      }
    ]
  },
  "host": {
    "customer-add": {
      "print": "Added a customer"
    },
    "customer-count": {
      "print": "2 customers"
    },
    "customer-remove": {
      "ask": {
        "message": "Remove Ada?",
        "schema": {
          "type": "boolean"
        }
      },
      "print": "Removed Ada",
      "kept": "Kept Ada",
      "unanswered": "Cannot ask"
