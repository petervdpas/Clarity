module shop

enum Size
    Small
    Large

entity Line
    price: money
    count: integer

entity Order
    number: text(12)
    total: money

engine Pricing from "test.wasm"
    uses clock, random, log, language
    limit 2 seconds, 64 MB
    function add(a: integer, b: integer) -> integer
    function greet(name: text) -> text
    function total(lines: list<Line>) -> money
    function size_of(n: integer) -> Size
    function discounted(order: Order) -> Order
    function fail(why: text) -> text
    function reverse(content: bytes) -> bytes
    function length(content: bytes) -> integer

engine Counter from "test.wasm"
    uses clock, random, log, language
    state per app
    on open
    function count() -> integer

engine Board from "test.wasm"
    uses clock, random, log, language
    state per window
    on open
    function count() -> integer

function answer(a: integer) -> integer
    return Pricing.add(a, 40)

function greeting(name: text) -> text
    return Pricing.greet(name)

function sum(lines: list<Line>) -> money
    return Pricing.total(lines)

function size_class(n: integer) -> Size
    return Pricing.size_of(n)

function cheaper(order: Order) -> Order
    return Pricing.discounted(order)

function refused(why: text) -> text
    return Pricing.fail(why)

function backwards(content: bytes) -> bytes
    return Pricing.reverse(content)

function measured(content: bytes) -> integer
    return Pricing.length(content) + content.size

function counted() -> integer
    return Counter.count()

page Main: window
    title "Engines"
    data moves: integer
    button "Move" name moveButton at 1,1 on click: moved

code Main
    handler moved
        moves = Board.count()
