  "write": [
    {
      "name": "fields and nested lay a value out where they say",
      "kind": {
        "kind": "records",
        "entity": "Order",
        "fields": [
          {
            "name": "number",
            "kind": "text"
          },
          {
            "name": "customer",
            "kind": "text"
          },
          {
            "kind": "records",
            "entity": "Line",
            "fields": [
              {
                "name": "product",
                "kind": "text"
              },
              {
                "name": "quantity",
                "kind": "integer"
              }
            ],
            "base": {
              "id": 0,
              "product": "",
              "quantity": 0
            },
            "name": "lines"
          }
        ],
        "base": {
          "id": 0,
          "number": "",
          "customer": "",
          "lines": []
        }
      },
      "options": {
        "at": "shop/orders/order",
        "fields": {
          "number": "@number",
          "customer": "customer/name"
        },
        "nested": {
          "lines": {
            "at": "lines/line",
            "fields": {
              "product": "@product"
            }
          }
        }
      },
      "value": "[{\"id\":1,\"number\":\"A-1\",\"customer\":\"Ada\",\"lines\":[{\"id\":0,\"product\":\"Tea\",\"quantity\":2}]}]",
      "written": {
        "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><shop><orders><order number=\"A-1\"><customer><name>Ada</name></customer><lines><line product=\"Tea\"><quantity>2</quantity></line></lines></order></orders></shop>"
      }
    },
