    {
      "name": "nested: records inside at their own path with their own fields, '..' the record around them",
      "kind": {
        "kind": "records",
        "entity": "Order",
        "fields": [
          {
            "name": "number",
            "kind": "text"
          },
          {
            "kind": "records",
            "entity": "Line",
            "fields": [
              {
                "name": "product",
                "kind": "text"
              },
              {
                "name": "quantity",
                "kind": "integer"
              },
              {
                "name": "order",
                "kind": "text"
              }
            ],
            "base": {
              "id": 0,
              "product": "",
              "quantity": 0,
              "order": ""
            },
            "name": "lines"
          }
        ],
        "base": {
          "id": 0,
          "number": "",
          "lines": []
        }
      },
      "options": {
        "at": "shop/orders/order",
        "nested": {
          "lines": {
            "at": "lines/line",
            "fields": {
              "product": "name",
              "order": "../number"
            }
          }
        }
      },
      "inputs": {
        "json": "{\"shop\":{\"orders\":{\"order\":[{\"number\":\"A-1\",\"lines\":{\"line\":[{\"name\":\"Tea\",\"quantity\":2},{\"name\":\"Coffee\"}]}},{\"number\":\"A-2\",\"lines\":{\"line\":[{\"name\":\"Milk\",\"quantity\":1}]}}]}}}",
        "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><shop><orders><order><number>A-1</number><lines><line><name>Tea</name><quantity>2</quantity></line><line><name>Coffee</name></line></lines></order><order><number>A-2</number><lines><line><name>Milk</name><quantity>1</quantity></line></lines></order></orders></shop>",
        "yaml": "shop:\n  orders:\n    order:\n    - number: A-1\n      lines:\n        line:\n        - {name: Tea, quantity: 2}\n        - name: Coffee\n    - number: A-2\n      lines:\n        line: [{name: Milk, quantity: 1}]\n"
      },
      "fitted": [
        {
          "id": 0,
          "number": "A-1",
          "lines": [
            {
              "id": 0,
              "product": "Tea",
              "quantity": 2,
              "order": "A-1"
            },
            {
              "id": 0,
              "product": "Coffee",
              "quantity": 0,
              "order": "A-1"
            }
          ]
        },
        {
          "id": 0,
          "number": "A-2",
          "lines": [
            {
              "id": 0,
              "product": "Milk",
              "quantity": 1,
              "order": "A-2"
            }
          ]
        }
      ]
    },
