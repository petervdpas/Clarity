            ],
            [
              "A-2"
            ]
          ]
        },
        {
          "name": "lines",
          "entity": "Line",
          "columns": [
            "order",
            "product",
            "quantity"
          ],
          "rows": [
            [
              1,
              "Tea",
              2
            ],
            [
              1,
              "Coffee",
              null
            ],
            [
              2,
              "Milk",
