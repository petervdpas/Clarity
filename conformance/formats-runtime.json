            "entity": "Line",
            "fields": [
              {
                "name": "product",
                "kind": "text"
              },
              {
                "name": "quantity",
                "kind": "integer"
              }
            ],
            "base": {
              "id": 0,
              "product": "",
              "quantity": 0
            }
          }
        ],
        "base": {
          "id": 0,
          "number": "",
          "total": "0",
          "placed": null,
          "lines": []
        }
      },
      "input": "[{\"number\": \"B-1\"}, {\"number\": \"B-2\", \"total\": \"3\"}]",
      "written": "[{\"id\":0,\"number\":\"B-1\",\"total\":\"0\",\"placed\":null,\"lines\":[]},{\"id\":0,\"number\":\"B-2\",\"total\":\"3\",\"placed\":null,\"lines\":[]}]"
    },
    {
      "name": "what does not fit stops with the library's message, word for word",
      "kind": {
        "kind": "record",
        "entity": "Order",
        "fields": [
          {
            "name": "number",
            "kind": "text"
          },
          {
