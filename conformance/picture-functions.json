      "picture": {
        "height": 2,
        "pixels": "ff0000ff00ff00ff0000ffffffffffff000000ffff0000ff",
        "width": 3
      },
      "result": {
        "height": 1,
        "pixels": "ff0000ff",
        "width": 1
      }
    },
