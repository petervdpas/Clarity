        1,
        0,
        1,
        2
      ],
      "function": "crop",
      "name": "crop the middle column",
      "picture": {
        "height": 2,
        "pixels": "ff0000ff00ff00ff0000ffffffffffff000000ffff0000ff",
        "width": 3
      },
      "result": {
        "height": 2,
        "pixels": "00ff00ff000000ff",
        "width": 1
      }
    },
    {
      "args": [
        2,
        1,
        5,
        5
      ],
