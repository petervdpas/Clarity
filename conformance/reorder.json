{
  "about": "Reordering (DESIGN 5.30), as every renderer does it. `rows` are the records of the list in its order, each with its `id` and, in a tree, the id of its `parent` or null (as in trees.json). A move is a drag, `{ \"row\": place, \"where\": \"before\" | \"after\" | \"into\", \"target\": place }`, or a key, `{ \"row\": place, \"key\": \"up\" | \"down\" | \"left\" | \"right\" }`, places counted from 0 in the list. Up and down swap the row with the row before or after it at its level. In a tree, left puts the row after its parent, at its parent's level, and right makes it the last row under the row before it at its level. A drag before or after a row puts it at that row's level beside it; a drag into a row makes it the last row under that row. A row moves with the rows under it. The result is the list's new order as the places of the old list (`order`), each row's parent in that order (`parents`, trees only), and each row's number (`numbers`): its place at its level counted from 1, in the order of the list. A move that keeps every row's parent and number changes nothing and is `refused`: a key at the end of a level, a drag onto the row itself or where it already is, a drag into a row under the row, left at the top level, and left or right or into in a list that is no tree.",
  "lists": [
    { "name": "drag a row before the first", "rows": [{ "id": 1 }, { "id": 2 }, { "id": 3 }], "move": { "row": 2, "where": "before", "target": 0 }, "order": [2, 0, 1], "numbers": [1, 2, 3] },
    { "name": "drag the first row after the last", "rows": [{ "id": 1 }, { "id": 2 }, { "id": 3 }], "move": { "row": 0, "where": "after", "target": 2 }, "order": [1, 2, 0], "numbers": [1, 2, 3] },
    { "name": "down swaps with the next row", "rows": [{ "id": 1 }, { "id": 2 }, { "id": 3 }], "move": { "row": 0, "key": "down" }, "order": [1, 0, 2], "numbers": [1, 2, 3] },
    { "name": "up swaps with the row before", "rows": [{ "id": 1 }, { "id": 2 }, { "id": 3 }], "move": { "row": 2, "key": "up" }, "order": [0, 2, 1], "numbers": [1, 2, 3] },
    { "name": "up on the first row", "rows": [{ "id": 1 }, { "id": 2 }, { "id": 3 }], "move": { "row": 0, "key": "up" }, "refused": true },
    { "name": "down on the last row", "rows": [{ "id": 1 }, { "id": 2 }, { "id": 3 }], "move": { "row": 2, "key": "down" }, "refused": true },
    { "name": "a drag to where the row already is", "rows": [{ "id": 1 }, { "id": 2 }, { "id": 3 }], "move": { "row": 1, "where": "before", "target": 2 }, "refused": true },
    { "name": "a drag onto the row itself", "rows": [{ "id": 1 }, { "id": 2 }, { "id": 3 }], "move": { "row": 1, "where": "after", "target": 1 }, "refused": true },
