          "password_hash"
        ]
      },
      {
        "name": "account",
        "columns": [
          "login"
        ]
      },
      {
        "name": "token",
        "columns": [
          "api_token"
        ]
      },
      {
        "name": "recovery",
        "columns": [
          "email",
          "recovery_codes"
        ]
      }
    ],
    "sessionMinutes": 480,
    "tries": 3,
    "triesMinutes": 15,
    "program": "clarity-signin-conformance"
  },
