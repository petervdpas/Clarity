<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="{namespace}.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- Parts fill their cells, as on the web; labels sit in the middle of their row. -->
    <Style Selector="Grid > Button, Grid > ComboBox, Grid > CalendarDatePicker">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid > Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label, TextBlock.value, TextBlock.status">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.help">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.help.error">
      <Setter Property="Foreground" Value="#c4314b" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.number">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.panel, Border.form, Border.placeholder">
      <Setter Property="BorderBrush" Value="#40808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.form">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.legend">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.placeholder > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.toolbar, Border.footer">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="#14808080" />
    </Style>
    <Style Selector="Border.sidebar">
      <Setter Property="Padding" Value="8" />
      <Setter Property="Background" Value="#14808080" />
    </Style>
    <!-- Tabs of a window are parts, not the window's pages: headers in the text size. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Separator.vertical">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background" Value="#40808080" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="Margin" Value="4,0,12,0" />
    </Style>
    <Style Selector="TextBlock.group">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.message">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Button.message.warning">
      <Setter Property="BorderBrush" Value="#d9a400" />
    </Style>
    <Style Selector="Button.message.error">
      <Setter Property="BorderBrush" Value="#c4314b" />
      <Setter Property="Foreground" Value="#c4314b" />
    </Style>
  </Application.Styles>
</Application>
