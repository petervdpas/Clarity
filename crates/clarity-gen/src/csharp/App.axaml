<!-- Generated by Clarity. Do not edit: change the project in Clarity instead. -->
<!-- The application's styles read the values of the theme shown
     (Themes/*.axaml, merged with Clarity's own), so a theme switch changes
     them all. -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Clarity.Avalonia"
             x:Class="{namespace}.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- The window in the theme's colors and font. -->
    <Style Selector=":is(Window)">
      <Setter Property="Background" Value="{DynamicResource ClarityBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ClarityText}" />
      <Setter Property="FontFamily" Value="{DynamicResource ClarityFont}" />
      <Setter Property="FontSize" Value="{DynamicResource ClarityFontSize}" />
    </Style>

    <!-- Parts fill their cells, as on the web; labels sit in the middle of their row. -->
    <Style Selector="Grid > Button, Grid > ComboBox, Grid > CalendarDatePicker">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid > Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="{DynamicResource ClarityRadiusButton}" />
      <Setter Property="FontWeight" Value="{DynamicResource ClarityButtonWeight}" />
    </Style>
    <Style Selector="TextBox, ComboBox, CalendarDatePicker">
      <Setter Property="CornerRadius" Value="{DynamicResource ClarityRadiusInput}" />
    </Style>
    <Style Selector="TextBlock.label, TextBlock.value, TextBlock.status">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A text over several rows: read from the top, wrapped; its ScrollViewer scrolls it. -->
    <Style Selector="TextBlock.value.lines">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.help">
      <Setter Property="FontSize" Value="{DynamicResource ClaritySizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource ClarityMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.help.error">
      <Setter Property="Foreground" Value="{DynamicResource ClarityError}" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="{DynamicResource ClaritySizeHeading}" />
      <Setter Property="FontFamily" Value="{DynamicResource ClarityFontHeading}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.number">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <!-- An input in a table cell sits flush in the cell, as in a spreadsheet. -->
    <Style Selector="TextBox.cell, ComboBox.cell, CalendarDatePicker.cell, c|ChoiceInput.cell ComboBox, c|DateTimeInput.cell CalendarDatePicker, c|DateTimeInput.cell TextBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- Typed text that is no value: no number in a number input, no time in a moment. -->
    <Style Selector="TextBox.error">
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityError}" />
    </Style>
    <Style Selector="ToggleSwitch.cell">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="CheckBox.cell">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Border.panel, Border.form, Border.placeholder">
      <Setter Property="Background" Value="{DynamicResource ClarityPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ClarityBorderWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ClarityRadiusPanel}" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <!-- A panel's frame sits out between the columns (3 pixels each side), so its grid has the
         window's column lines; a foldable panel or form (an Expander) likewise. A form without
         a fold has no frame, so its grid already has them. -->
    <Style Selector="TabControl.tabs">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Margin" Value="-3,0" />
      <Setter Property="Padding" Value="{DynamicResource ClarityFramePadding}" />
    </Style>
    <Style Selector="Expander.panel, Expander.form">
      <Setter Property="Margin" Value="-3,0" />
      <Setter Property="Padding" Value="{DynamicResource ClarityFramePadding}" />
    </Style>
    <Style Selector="Border.form">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.legend">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.placeholder > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ClarityMuted}" />
    </Style>
    <!-- The frame: menu, toolbar, sidebars and footer. -->
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource ClarityFrame}" />
    </Style>
    <Style Selector="Border.toolbar, Border.footer, Border.sidebar">
      <Setter Property="Background" Value="{DynamicResource ClarityFrame}" />
    </Style>
    <Style Selector="Menu > MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource ClarityFrameText}" />
    </Style>
    <Style Selector="Border.toolbar TextBlock, Border.footer TextBlock, Border.sidebar TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ClarityFrameText}" />
    </Style>
    <Style Selector="Border.toolbar, Border.footer">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityBorder}" />
    </Style>
    <Style Selector="Border.toolbar">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.footer">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.sidebar">
      <Setter Property="Padding" Value="8" />
    </Style>
    <!-- Tabs of a window are parts, not the window's pages: headers in the text size. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource ClarityFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource ClarityTabWeight}" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontWeight" Value="{DynamicResource ClarityHeaderWeight}" />
    </Style>
    <Style Selector="Separator.vertical">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background" Value="{DynamicResource ClarityBorder}" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="Margin" Value="4,0,12,0" />
    </Style>
    <Style Selector="TextBlock.group">
      <Setter Property="FontSize" Value="{DynamicResource ClaritySizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource ClarityMuted}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- An icon (Lucide's, drawn from the generated Icons class): a round line in the foreground around it. -->
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="{Binding $self.(TextElement.Foreground)}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <!-- A button group: its buttons and toggles joined, only the outer corners round. -->
    <Style Selector="Border.buttons">
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="CornerRadius" Value="{DynamicResource ClarityRadiusButton}" />
    </Style>
    <Style Selector="Border.buttons Button, Border.buttons ToggleButton">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.toggle">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- The small parts: a separator line, a badge, a progress bar and a busy indicator. -->
    <Style Selector="Border.separator">
      <Setter Property="Height" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ClarityBorder}" />
    </Style>
    <Style Selector="Border.separator.vertical">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Width" Value="1" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{DynamicResource ClarityAccent}" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ClarityOnAccent}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ProgressBar.progress">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.busy">
      <Setter Property="Spacing" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.busy > ProgressBar">
      <Setter Property="Width" Value="48" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.busy > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- What a typed or search dropdown offers below its box (U1c). -->
    <Style Selector="Border.offered">
      <Setter Property="Background" Value="{DynamicResource ClarityPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ClarityRadiusPanel}" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
    </Style>
    <!-- The items of a tags input (U1c), each a chip with the button that removes it. -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource ClarityPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.chip Button.remove">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- A popover: its own grid in a raised panel next to its part (DESIGN 5.16). -->
    <Style Selector="Border.popover">
      <Setter Property="Background" Value="{DynamicResource ClarityPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ClarityRadiusPanel}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
    </Style>
    <!-- A note at the top right, with a small x that closes it. -->
    <Style Selector="Border.message">
      <Setter Property="Padding" Value="14,10,8,10" />
      <Setter Property="Background" Value="{DynamicResource ClarityPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.message Button.close">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource ClarityMuted}" />
    </Style>
    <!-- A warning or an error, said in Clarity's dialog. -->
    <Style Selector="TextBlock.said.error">
      <Setter Property="Foreground" Value="{DynamicResource ClarityError}" />
    </Style>
    <!-- A splitter: framed, its panes padded, the divider between them dragged. -->
    <Style Selector="Border.splitter">
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityStrongBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ClarityBorderWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ClarityRadiusPanel}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.pane">
      <Setter Property="Padding" Value="{DynamicResource ClarityPanePadding}" />
    </Style>
    <Style Selector="Border.splitter GridSplitter">
      <Setter Property="Background" Value="{DynamicResource ClarityStrongBorder}" />
    </Style>
    <!-- A list and its rows, as the theme's part list says (hover, selected). -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource ClarityListBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ClarityListText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityListBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ClarityBorderWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ClarityListRadius}" />
    </Style>
    <Style Selector="ListBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ClarityListHoverBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ClarityListHoverText}" />
    </Style>
    <Style Selector="ListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ClarityListSelectedBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ClarityListSelectedText}" />
    </Style>
    <!-- A list of cards: no frame of its own; each row a card, as the theme's
         part card and part card_line say, the one chosen in its selected look. -->
    <Style Selector="ListBox.cards">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="{DynamicResource ClarityCardGap}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource ClarityCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityCardBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource ClarityBorderWidth}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ClarityCardRadius}" />
      <Setter Property="Padding" Value="{DynamicResource ClarityCardPadding}" />
    </Style>
    <Style Selector="Border.card TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.card TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource ClarityCardText}" />
      <Setter Property="FontWeight" Value="{DynamicResource ClarityCardWeight}" />
    </Style>
    <Style Selector="Border.card TextBlock.line">
      <Setter Property="Foreground" Value="{DynamicResource ClarityCardLineText}" />
      <Setter Property="FontWeight" Value="{DynamicResource ClarityCardLineWeight}" />
      <Setter Property="FontSize" Value="{DynamicResource ClaritySizeSmall}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.card">
      <Setter Property="Background" Value="{DynamicResource ClarityCardHoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityCardHoverBorder}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.card TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource ClarityCardHoverText}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.card TextBlock.line">
      <Setter Property="Foreground" Value="{DynamicResource ClarityCardLineHoverText}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.card">
      <Setter Property="Background" Value="{DynamicResource ClarityCardSelectedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ClarityCardSelectedBorder}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.card TextBlock.title">
      <Setter Property="Foreground" Value="{DynamicResource ClarityCardSelectedText}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.card TextBlock.line">
      <Setter Property="Foreground" Value="{DynamicResource ClarityCardLineSelectedText}" />
    </Style>

    <!-- {styles} -->
  </Application.Styles>
</Application>
