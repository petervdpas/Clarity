// A test project, not an example: a command-line program that calls a web
// API (DESIGN 5.23), which tests/http_build.rs builds on every stack and
// runs against a small server of its own.
module calls
use store

enum Kind
    Person
    Business

entity Order
    number: text(20)
    total: money
    lines: integer
    paid: bool
    kind: Kind
    placed: date
    tags: list<text>

cli Calls
    help "Calls a web API"

// A token the person keeps for a second web API, in the system's protected
// store (DESIGN 5.27), which that API signs its calls with.
settings
    apiToken: secret

command token(value: text)
    help "Keeps the token of the vault"
    settings.apiToken = value

command vaulted(path: text)
    help "Calls the vault, signed with the token kept"
    let reply = http get path from vault
    print reply.text

action post_to(url: text, body: text) -> integer
    effects net
    let reply = http post url with body header "Content-Type": "text/plain"
    return reply.status

command fetch(url: text)
    help "Gets a page and prints its status, whether it is ok, and its text"
    let reply = http get url header "X-Test": "blue"
    print "{reply.status} {reply.ok} {reply.text}"

command send(url: text, body: text)
    help "Posts a text and prints the status"
    let status = post_to(url, body)
    print "{status}"

command replace(url: text, body: text)
    help "Puts a text and prints the answer"
    let reply = http put url with body
    print reply.text

command remove(url: text)
    help "Deletes and prints the answer"
    let reply = http delete url
    print reply.text

command orders(url: text)
    help "Reads the orders a service lists and prints each"
    let reply = http get url
    let found = read list<Order> from json reply.text at "data"
    for o in found
        let tags = count(o.tags)
        print "{o.number} {o.total} {o.lines} {o.paid} {o.kind} {o.placed} {tags}"

command order(url: text)
    help "Sends an order as JSON and prints what the service read"
    let o = new Order
    o.number = "A-9"
    o.total = 12.5
    o.lines = 2
    o.paid = true
    o.kind = Business
    let reply = http post url with json of o header "Content-Type": "application/json"
    print reply.text

command broken(url: text)
    help "Reads an order from what is no JSON"
    let reply = http get url
    let o = read Order from json reply.text
    print o.number

command store(status: text)
    help "Lists the items of the shop's web API, then what it was asked and how it was signed"
    for item in items_in(status)
        print "{item.name} {item.price}"
    print asked(status)
    print asked(status, page: 2)
    print asked(sort: "name", status: status, page: 3)
    print signed()
    let b = basket()
    print "{b.title} for {b.buyer.name}"
    for line in b.lines
        print "{line.name} {line.price}"
