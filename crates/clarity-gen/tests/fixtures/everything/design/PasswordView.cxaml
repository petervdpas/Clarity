<?xml version="1.0" encoding="UTF-8"?>
<!-- Signing in with an e-mail address and a password. -->
<View class="everything.PasswordView">
  <SigninLanguage name="language" at="1,1" span="12" rows="2" />
  <SigninField name="passwordName" at="1,3" span="12" rows="2" input="name" />
  <SigninField name="passwordField" at="1,5" span="12" rows="2" input="password" />
  <SigninRemember name="remember" at="1,7" span="12" />
  <SigninButton name="passwordButton" at="1,8" span="12" strategy="password" />
  <SigninOther name="useCode" at="1,9" span="12" shows="CodeView" />
  <SigninRefusal name="passwordRefusal" at="1,10" span="12" />
</View>
