<?xml version="1.0" encoding="UTF-8"?>
<!-- A toolbox of every kind of tool part, for the sketch canvas. -->
<Toolbox class="everything.SketchTools" columns="4">
  <ToolGroup name="drawGroup" at="1,1" span="1">
    <Tool name="penTool" at="1,1" span="1" does="pen" />
    <Tool name="eraserTool" at="1,1" span="1" does="eraser" />
  </ToolGroup>
  <Tool name="stampTool" at="2,1" span="1" icon="star" onclick="stamped" />
  <ToolSize name="sizeOption" at="1,2" span="4" />
  <ToolOpacity name="opacityOption" at="1,3" span="4" />
  <ToolColors name="colorOption" at="1,4" span="2" />
  <ToolLayers name="layerList" at="1,5" span="4" rows="3" />
</Toolbox>
