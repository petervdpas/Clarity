// Functions named like other declarations once they are Go or C# names:
// a type, an enum value, a constructor, a window (tests/go*.rs, csharp*.rs).
module shop

enum Size
    Small
    Large

entity Order
    total: money

function size(n: integer) -> Size
    if n < 10
        return Small
    return Large

function sizeSmall() -> Size
    return size(1)

function newOrder() -> Order
    return new Order

function mainWindow() -> integer
    return 1

function sources() -> integer
    return mainWindow()

page Main: window
    title "Shop"
