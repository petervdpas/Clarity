// A test project's second module, not an example: entities in a web API
// (DESIGN 5.23), which tests/http_build.rs points at its test server, and
// the actions that read and send them with `http ... from shop`.
module store
source shop

entity Item
    name: text(40)
    price: money

// Records inside records (DESIGN 5.25), as the service nests them.
entity Buyer
    name: text

entity Basket
    title: text
    buyer: Buyer
    lines: list<Item>

action items_in(status: text) -> list<Item>
    effects net
    let reply = http get "/items" from shop query "status": status
    if not reply.ok
        refuse "shop answered {reply.status}: {reply.text}"
    return read list<Item> from json reply.text at "items"

// A page and an order only when asked for (DESIGN 5.24): a call may leave
// them out or name them, and a pair whose `when` does not hold is not sent.
action asked(status: text, page: integer = 0, sort: text = "") -> text
    effects net
    let reply = http get "/query" from shop query "status": status query "page": "{page}" when page != 0 query "sort": sort when sort != ""
    return reply.text

action signed() -> text
    effects net
    let reply = http get "auth" from shop
    return reply.text

action basket() -> Basket
    effects net
    let reply = http get "/basket" from shop
    return read Basket from json reply.text
