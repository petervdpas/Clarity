{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "fileTypes": [
    "clarity"
  ],
  "name": "Clarity",
  "patterns": [
    {
      "include": "#translation"
    },
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#text"
        },
        {
          "include": "#key"
        },
        {
          "include": "#number"
        },
        {
          "include": "#name"
        },
        {
          "include": "#literal"
        },
        {
          "include": "#type"
        },
        {
          "include": "#keyword"
        }
      ]
    },
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.clarity"
    },
    "key": {
      "match": "@[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.constant.key.clarity"
    },
    "keyword": {
      "match": "\\b(MB|accordion|action|add|after|align|and|app|as|ask|at|auth|background|badge|baseline|before|bend|beside|bind|binds|border|busy|button|buttons|by|cancel|canvas|cascade|change|chart|checkbox|cli|click|close|cmake|code|collapsed|collapsible|color|column|columns|command|compiled|computed|const|contains|copy|crate|currency|cursor|dark|data|datasource|date|default|delete|desc|display|dll|drag|draw|drop|dropdown|edit|effects|else|engine|engines|ensure|enter|entity|enum|error|every|exit|external|field|file|files|filestore|find|finish|foldable|folded|folder|font|footer|for|form|format|from|function|get|gives|go|grid|group|handler|header|heading|hears|help|horizontal|http|icon|if|image|in|info|interpreted|item|items|json|keep|key|label|labels|language|large|leave|let|library|light|limit|link|list|main|map|markdown|matches|max|maximizable|memo|menu|message|migration|min|mode|module|name|native|new|next|no|not|nuget|number|of|offset|on|open|openapi|option|or|order|output|owned|padding|page|paging|pane|panel|part|password|patch|pattern|per|pick|placeholder|pointer|popover|post|preview|print|progress|project|put|query|quit|radio|radius|read|readonly|record|redo|refuse|reload|remove|rename|reorder|require|required|resizable|return|ribbon|rows|save|says|schema|scroll|search|seconds|section|select|separator|settings|shadow|show|sidebar|size|slider|sortable|sound|source|span|spinbox|split|splitter|stack|start|state|status|step|steps|store|style|submit|surface|switch|system|tab|table|taborder|tabs|tags|tell|tells|text|textbox|theme|then|tick|timer|title|to|toggle|toolbar|tooltip|translation|tree|treetable|trend|unconnected|undo|unique|units|use|uses|vertical|warning|weight|when|where|width|window|with|write|x|yes)\\b",
      "name": "keyword.other.clarity"
    },
    "literal": {
      "match": "\\b(true|false|none)\\b",
      "name": "constant.language.clarity"
    },
    "name": {
      "comment": "A word set, called or reached into is a name, whatever it is elsewhere.",
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "keyword.other.clarity"
            },
            "2": {
              "name": "variable.other.clarity"
            }
          },
          "match": "\\b(name|bind|handler|function|action|let|for|data|keep|const|module|use|source|store|datasource|filestore)\\s+([a-z_][A-Za-z0-9_]*)\\b"
        },
        {
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.property.clarity"
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "name": "entity.name.function.clarity"
        },
        {
          "match": "(?<!\\bon\\s)\\b([a-z_][A-Za-z0-9_]*)(?=\\s*(=(?!=)|\\[|:))",
          "name": "variable.other.clarity"
        }
      ]
    },
    "number": {
      "match": "(?<![A-Za-z0-9_])-?[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.clarity"
    },
    "text": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.clarity",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.clarity"
        },
        {
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.clarity"
        },
        {
          "match": "\\{[^{}\"]*\\}",
          "name": "variable.other.slot.clarity"
        }
      ]
    },
    "translation": {
      "begin": "^(translation)\\s+([A-Za-z_][A-Za-z0-9_-]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.clarity"
        },
        "2": {
          "name": "constant.language.clarity"
        }
      },
      "comment": "A language file: each line a key and its text.",
      "end": "(?!)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "captures": {
            "1": {
              "name": "variable.other.constant.key.clarity"
            },
            "2": {
              "name": "keyword.other.clarity"
            }
          },
          "match": "^\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(resource)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "variable.other.constant.key.clarity"
            }
          },
          "match": "^\\s+([A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "include": "#text"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "match": "\\b(text|integer|decimal|money|bool|date|datetime|duration|file|bytes|list|email|url|color|id|ref|image|picture)\\b",
          "name": "storage.type.clarity"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.clarity"
        }
      ]
    }
  },
  "scopeName": "source.clarity"
}
