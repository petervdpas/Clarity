{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "fileTypes": [
    "clarity"
  ],
  "name": "Clarity",
  "patterns": [
    {
      "include": "#translation"
    },
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#text"
        },
        {
          "include": "#setting"
        },
        {
          "include": "#key"
        },
        {
          "include": "#number"
        },
        {
          "include": "#name"
        },
        {
          "include": "#literal"
        },
        {
          "include": "#type"
        },
        {
          "include": "#keyword"
        }
      ]
    },
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.clarity"
    },
    "key": {
      "match": "@[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.constant.key.clarity"
    },
    "keyword": {
      "match": "\\b(MB|accordion|action|add|after|align|and|app|as|ask|at|auth|average|background|badge|baseline|before|bend|beside|bind|binds|border|bottom|brush|busy|button|buttons|by|cancel|canvas|cards|cascade|change|chart|check|checkbox|children|cli|click|close|cmake|code|collapsed|collapsible|color|column|columns|command|compiled|computed|confirm|connect|const|contains|content|copy|count|crate|csv|currency|cursor|dark|data|datasource|date|default|delete|desc|digits|display|div|dll|dots|drag|draw|drop|dropdown|edit|editable|effects|else|end|engine|engines|ensure|enter|entity|enum|error|every|exit|external|fail|field|file|files|filestore|find|finish|foldable|folded|folder|font|footer|for|form|format|frame|from|function|get|gives|go|graph|grid|group|grows|handler|header|heading|hears|help|horizontal|http|icon|if|image|in|info|ink|interpreted|is|item|items|json|keep|key|keys|label|labels|language|large|leave|let|level|library|light|limit|link|list|main|map|mapping|markdown|matches|max|maximizable|memo|menu|message|migration|min|mod|mode|module|name|native|new|next|no|not|nuget|number|objects|of|offset|on|open|openapi|option|or|order|output|owned|padding|page|paging|paint|pane|panel|parent|part|password|patch|pattern|per|pick|pinnable|placeholder|pointer|points|popover|port|post|preview|print|progress|project|put|query|quit|radio|radius|read|readonly|record|redo|refuse|reload|remove|rename|renderer|reorder|repeat|require|required|resizable|resize|return|ribbon|rows|runs|save|says|schema|scroll|search|seconds|section|select|separator|settings|shadow|show|side|sidebar|size|slideout|slider|snap|sortable|sound|source|span|spinbox|splash|split|splitter|stack|start|state|status|step|steps|store|striped|style|submit|sum|surface|switch|system|tab|table|taborder|tabs|tags|tell|tells|text|textbox|theme|then|tick|timer|title|to|toggle|tool|toolbar|toolcolors|toolgroup|toollayers|toolopacity|tools|toolsize|tooltip|top|translation|tree|treetable|trend|typed|ui|unconnected|under|undo|unique|units|use|uses|using|value|values|vector|version|vertical|video|view|volume|warning|weight|when|where|width|window|with|write|x|xml|yaml|yes|zoom)\\b",
      "name": "keyword.other.clarity"
    },
    "literal": {
      "match": "\\b(true|false|none)\\b",
      "name": "constant.language.clarity"
    },
    "name": {
      "comment": "A word set, called or reached into is a name, whatever it is elsewhere.",
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "keyword.other.clarity"
            },
            "2": {
              "name": "variable.other.clarity"
            }
          },
          "match": "\\b(name|bind|handler|function|action|let|for|data|keep|const|module|use|source|store|datasource|filestore|mapping)\\s+([a-z_][A-Za-z0-9_]*)\\b"
        },
        {
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.property.clarity"
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "name": "entity.name.function.clarity"
        },
        {
          "match": "(?<!\\bon\\s)\\b([a-z_][A-Za-z0-9_]*)(?=\\s*(=(?!=)|\\[|:))",
          "name": "variable.other.clarity"
        }
      ]
    },
    "number": {
      "match": "(?<![A-Za-z0-9_])-?[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.clarity"
    },
    "setting": {
      "captures": {
        "1": {
          "name": "keyword.other.clarity"
        },
        "2": {
          "name": "keyword.other.clarity"
        }
      },
      "comment": "Settings of two words at the start of a project file's line: `row height 30`. Alone, `row` is a name.",
      "match": "^\\s*(row)\\s+(height)\\b"
    },
    "text": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.clarity",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.clarity"
        },
        {
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.clarity"
        },
        {
          "match": "\\{[^{}\"]*\\}",
          "name": "variable.other.slot.clarity"
        }
      ]
    },
    "translation": {
      "begin": "^(translation)\\s+([A-Za-z_][A-Za-z0-9_-]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.clarity"
        },
        "2": {
          "name": "constant.language.clarity"
        }
      },
      "comment": "A language file: each line a key and its text.",
      "end": "(?!)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "captures": {
            "1": {
              "name": "variable.other.constant.key.clarity"
            },
            "2": {
              "name": "keyword.other.clarity"
            }
          },
          "match": "^\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(resource)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "variable.other.constant.key.clarity"
            }
          },
          "match": "^\\s+([A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "include": "#text"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "match": "\\b(text|integer|decimal|money|bool|date|datetime|duration|file|bytes|list|email|url|color|id|ref|image|picture)\\b",
          "name": "storage.type.clarity"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.clarity"
        }
      ]
    }
  },
  "scopeName": "source.clarity"
}
