module calculator

app Calculator
    title "Calculator"
    main Main

theme Calculator
    title "Calculator"
    mode system
    color lcd "#c7d3a8" dark "#1d2618"
    color lcd_text "#1f2a14" dark "#a8e890"
    style display background lcd, text lcd_text, border none, radius 6, size 40, font mono, align right
    style operator background accent_soft, text accent, weight bold
    style equals background accent, text on_accent, weight bold

enum Operation
    Nothing
    Add
    Subtract
    Multiply
    Divide

function calculate(a: decimal, op: Operation, b: decimal) -> decimal
    if op == Add
        return a + b
    if op == Subtract
        return a - b
    if op == Multiply
        return a * b
    if op == Divide
        if b == 0
            refuse "Cannot divide by zero"
        return a / b
    return b

page Main: window
    title "Calculator"
    size 320 x 340
    data shown: decimal
    data entry: decimal
    data total: decimal
    data pending: Operation
    data factor: decimal, default 1
    data fresh: bool, default true
    grid 4 columns

    text name display at 1,1 span 4 rows 2 bind shown style display
    button "C" at 1,3 span 1 key "Escape" on click: clear
    button "+/-" at 2,3 span 1 on click: change_sign
    button "%" at 3,3 span 1 on click: percent
    button "÷" at 4,3 span 1 style operator on click: operation(Divide)
    button "7" at 1,4 span 1 key "7" on click: digit(7)
    button "8" at 2,4 span 1 key "8" on click: digit(8)
    button "9" at 3,4 span 1 key "9" on click: digit(9)
    button "×" at 4,4 span 1 style operator on click: operation(Multiply)
    button "4" at 1,5 span 1 key "4" on click: digit(4)
    button "5" at 2,5 span 1 key "5" on click: digit(5)
    button "6" at 3,5 span 1 key "6" on click: digit(6)
    button "−" at 4,5 span 1 style operator on click: operation(Subtract)
    button "1" at 1,6 span 1 key "1" on click: digit(1)
    button "2" at 2,6 span 1 key "2" on click: digit(2)
    button "3" at 3,6 span 1 key "3" on click: digit(3)
    button "+" at 4,6 span 1 style operator on click: operation(Add)
    button "0" at 1,7 span 2 key "0" on click: digit(0)
    button "." at 3,7 span 1 on click: point
    button "=" at 4,7 span 1 style equals default on click: equals

code Main
    handler digit(d: integer)
        if fresh
            entry = 0
            factor = 1
            fresh = false
        if factor == 1
            entry = entry * 10 + d
        else
            entry = entry + d * factor
            factor = factor / 10
        shown = entry

    handler point
        if fresh
            entry = 0
            shown = 0
            fresh = false
            factor = 0.1
        else if factor == 1
            factor = 0.1

    handler operation(op: Operation)
        if pending == Nothing
            total = entry
        else if not fresh
            total = calculate(total, pending, entry)
        shown = total
        pending = op
        fresh = true

    handler equals
        if pending != Nothing
            entry = calculate(total, pending, entry)
            total = entry
            shown = entry
            pending = Nothing
        fresh = true

    handler clear
        shown = 0
        entry = 0
        total = 0
        pending = Nothing
        factor = 1
        fresh = true

    handler change_sign
        entry = -entry
        shown = entry

    handler percent
        entry = entry / 100
        shown = entry
