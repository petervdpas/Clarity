module calculator

app Calculator
    title "Calculator"
    main Main

theme Calculator
    title "Calculator"
    mode system
    color lcd "#c7d3a8" dark "#1d2618"
    color lcd_text "#1f2a14" dark "#a8e890"
    style display background lcd, text lcd_text, border none, radius 6
    style operator background accent_soft, text accent, weight bold
    style equals background accent, text on_accent, weight bold

enum Operation
    Nothing
    Add
    Subtract
    Multiply
    Divide

function calculate(a: decimal, op: Operation, b: decimal) -> decimal
    if op == Add
        return a + b
    if op == Subtract
        return a - b
    if op == Multiply
        return a * b
    if op == Divide
        if b == 0
            refuse "Cannot divide by zero"
        return a / b
    return b

page Main: window
    title "Calculator"
    size 320 x 340
    data shown: decimal
    data entry: decimal
    data total: decimal
    data pending: Operation
    data factor: decimal, default 1
    data fresh: bool, default true
    data digits: integer
    grid 4 columns

    display name screen at 1,1 span 4 rows 2 bind shown digits 12 style display
    button "C" name button1 at 1,3 span 1 key "Escape" on click: clear
    button "+/-" name button2 at 2,3 span 1 on click: changeSign
    button "%" name button3 at 3,3 span 1 on click: percent
    button "÷" name button4 at 4,3 span 1 style operator key "/" on click: operation(Divide)
    button "7" name button5 at 1,4 span 1 key "7" on click: digit(7)
    button "8" name button6 at 2,4 span 1 key "8" on click: digit(8)
    button "9" name button7 at 3,4 span 1 key "9" on click: digit(9)
    button "×" name button8 at 4,4 span 1 style operator key "*" on click: operation(Multiply)
    button "4" name button9 at 1,5 span 1 key "4" on click: digit(4)
    button "5" name button10 at 2,5 span 1 key "5" on click: digit(5)
    button "6" name button11 at 3,5 span 1 key "6" on click: digit(6)
    button "−" name button12 at 4,5 span 1 style operator key "-" on click: operation(Subtract)
    button "1" name button13 at 1,6 span 1 key "1" on click: digit(1)
    button "2" name button14 at 2,6 span 1 key "2" on click: digit(2)
    button "3" name button15 at 3,6 span 1 key "3" on click: digit(3)
    button "+" name button16 at 4,6 span 1 style operator key "+" on click: operation(Add)
    button "0" name button17 at 1,7 span 2 key "0" on click: digit(0)
    button "." name button18 at 3,7 span 1 key "." on click: point
    button "=" name button19 at 4,7 span 1 style equals key "=" default on click: equals

code Main
    handler digit(d: integer)
        if fresh
            entry = 0
            factor = 1
            digits = 0
            fresh = false
        // A display holds 12 digits; a leading zero is none.
        if digits == 12
            return
        if d == 0 and entry == 0 and factor == 1
            shown = entry
            return
        digits = digits + 1
        if factor == 1
            entry = entry * 10 + d
        else
            entry = entry + d * factor
            factor = factor / 10
        shown = entry

    handler point
        if fresh
            entry = 0
            shown = 0
            fresh = false
            factor = 0.1
        else if factor == 1
            factor = 0.1

    handler operation(op: Operation)
        if pending == Nothing
            total = entry
        else if not fresh
            total = calculate(total, pending, entry)
        shown = total
        pending = op
        fresh = true

    handler equals
        if pending != Nothing
            entry = calculate(total, pending, entry)
            total = entry
            shown = entry
            pending = Nothing
        fresh = true

    handler clear
        shown = 0
        entry = 0
        total = 0
        pending = Nothing
        factor = 1
        fresh = true

    handler changeSign
        entry = -entry
        shown = entry

    handler percent
        entry = entry / 100
        shown = entry
