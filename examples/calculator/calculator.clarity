module calculator

app Calculator
    title @calculatorTitle
    main Main
    menu name mainMenu
        item @calculatorItem name calculatorItem
            item @preferencesItem name preferencesItem on click -> Preferences
            separator
            item @quitItem name quitItem key "Ctrl+Q" on click -> quit

// What each person sets for themselves, kept on their machine: the
// language, the look, and the decimals a result is rounded to.
settings
    language
    theme
    decimals: integer, min 0, max 8, default 4, label @settingsDecimalsLabel

theme Calculator
    title @calculatorTheme
    mode system
    color lcd "#c7d3a8" dark "#1d2618"
    color lcd_text "#1f2a14" dark "#a8e890"
    style display background lcd, text lcd_text, border none, radius 6
    style operator background accent_soft, text accent, weight bold
    style equals background accent, text on_accent, weight bold

enum Operation
    Nothing label @operationNothing
    Add label @operationAdd
    Subtract label @operationSubtract
    Multiply label @operationMultiply
    Divide label @operationDivide

function calculate(a: decimal, op: Operation, b: decimal) -> decimal
    if op == Add
        return a + b
    if op == Subtract
        return a - b
    if op == Multiply
        return a * b
    if op == Divide
        if b == 0
            refuse @cannotDivideByZero
        return a / b
    return b

page Main: window
    title @mainTitle
    size 320 x 370
    data shown: decimal
    data entry: decimal
    data total: decimal
    data pending: Operation
    data factor: decimal, default 1
    data fresh: bool, default true
    data digits: integer
    grid 4 columns

    display name screen at 1,1 span 4 rows 2 bind shown digits 12 style display
    button @clearKeyCaption name clearKey at 1,3 span 1 key "Escape" on click: clear
    button "+/-" name signKey at 2,3 span 1 on click: changeSign
    button "%" name percentKey at 3,3 span 1 on click: percent
    button "÷" name divideKey at 4,3 span 1 style operator key "/" on click: operation(Divide)
    button "7" name digit7 at 1,4 span 1 key "7" on click: digit(7)
    button "8" name digit8 at 2,4 span 1 key "8" on click: digit(8)
    button "9" name digit9 at 3,4 span 1 key "9" on click: digit(9)
    button "×" name multiplyKey at 4,4 span 1 style operator key "*" on click: operation(Multiply)
    button "4" name digit4 at 1,5 span 1 key "4" on click: digit(4)
    button "5" name digit5 at 2,5 span 1 key "5" on click: digit(5)
    button "6" name digit6 at 3,5 span 1 key "6" on click: digit(6)
    button "−" name subtractKey at 4,5 span 1 style operator key "-" on click: operation(Subtract)
    button "1" name digit1 at 1,6 span 1 key "1" on click: digit(1)
    button "2" name digit2 at 2,6 span 1 key "2" on click: digit(2)
    button "3" name digit3 at 3,6 span 1 key "3" on click: digit(3)
    button "+" name addKey at 4,6 span 1 style operator key "+" on click: operation(Add)
    button "0" name digit0 at 1,7 span 2 key "0" on click: digit(0)
    button "." name pointKey at 3,7 span 1 key "." on click: point
    button "=" name equalsKey at 4,7 span 1 style equals key "=" default on click: equals

page Preferences: dialog
    title @preferencesTitle
    size 320 x 200
    grid 4 columns

    form name settingsForm at 1,1 span 4 rows 3 bind settings labels 2
        dropdown name languageBox at 3,1 span 2 bind settings.language
        dropdown name themeBox at 3,2 span 2 bind settings.theme
        spinbox name decimalsBox at 3,3 span 2 bind settings.decimals
    button @closeButtonCaption name closeButton at 3,5 span 2 cancel on click -> close

code Main
    handler digit(d: integer)
        if fresh
            entry = 0
            factor = 1
            digits = 0
            fresh = false
        // A display holds 12 digits; a leading zero is none.
        if digits == 12
            return
        if d == 0 and entry == 0 and factor == 1
            shown = entry
            return
        digits = digits + 1
        if factor == 1
            entry = entry * 10 + d
        else
            entry = entry + d * factor
            factor = factor / 10
        shown = entry

    handler point
        if fresh
            entry = 0
            shown = 0
            fresh = false
            factor = 0.1
        else if factor == 1
            factor = 0.1

    handler operation(op: Operation)
        if pending == Nothing
            total = entry
        else if not fresh
            total = calculate(total, pending, entry)
        shown = round(total, settings.decimals)
        pending = op
        fresh = true

    handler equals
        if pending != Nothing
            entry = calculate(total, pending, entry)
            total = entry
            shown = round(entry, settings.decimals)
            pending = Nothing
        fresh = true

    handler clear
        shown = 0
        entry = 0
        total = 0
        pending = Nothing
        factor = 1
        fresh = true

    handler changeSign
        entry = -entry
        shown = entry

    handler percent
        entry = entry / 100
        shown = entry
