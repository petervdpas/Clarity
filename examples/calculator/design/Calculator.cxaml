<?xml version="1.0" encoding="UTF-8"?>
<App class="calculator.Calculator" title="@calculatorTitle" main="Main">
  <Menu name="mainMenu">
    <Item caption="@calculatorItem" name="calculatorItem">
      <Item caption="@preferencesItem" name="preferencesItem" opens="Preferences" />
      <Item kind="separator" />
      <Item caption="@quitItem" name="quitItem" key="Ctrl+Q" opens="quit" />
    </Item>
  </Menu>
</App>
