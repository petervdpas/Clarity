module dial

// Where the needle points and what colour it has; its source is in
// engines/gauge.
engine Gauge from "gauge.wasm"
    function angle(speed: integer, maximum: integer) -> integer
    function zone(speed: integer) -> text

app Dial
    title @dialTitle
    main Main

code MainView
    // The needle turns from 210 degrees at 0 km/h to -30 at 200, and
    // warns as it gets fast.
    handler drawDial
        let angle = Gauge.angle(speed, 200)
        dial.clear("panel")
        dial.ring(50, 50, 42, "border", 3)
        dial.line(50 + 36 * cos(210), 50 - 36 * sin(210), 50 + 42 * cos(210), 50 - 42 * sin(210), "muted", 2)
        dial.line(50, 14, 50, 8, "muted", 2)
        dial.line(50 + 36 * cos(-30), 50 - 36 * sin(-30), 50 + 42 * cos(-30), 50 - 42 * sin(-30), "muted", 2)
        dial.line(50, 50, 50 + 34 * cos(angle), 50 - 34 * sin(angle), Gauge.zone(speed), 3)
        dial.circle(50, 50, 4, Gauge.zone(speed))
        dial.text(50, 72, "{speed} km/h", "text", 9)

    // The dial draws again after every handler.
    handler speedSet
        if speed > 200
            speed = 200

    handler change(by: integer)
        if speed + by >= 0 and speed + by <= 200
            speed = speed + by
