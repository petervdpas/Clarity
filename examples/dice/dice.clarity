module dice

// One roll: how many dice were thrown, what they showed, and when.
entity Roll
    dice: integer, label @rollDiceLabel
    total: integer, label @rollTotalLabel
    faces: text(40), label @rollFacesLabel
    rolled: datetime, label @rollRolledLabel

// Dice on a felt table, drawn in 3D with Bevy: told to roll, they tumble,
// bounce and land, then tell what they show.
part Dice
    crate "parts/Dice"
    count: integer, min 1, max 6, default 2
    tells landed(total: integer, faces: text)
    hears roll
    size 8 x 10

// Rolls the dice many times and counts how often each total comes up: a
// million rolls take a while, so the window shows how far it is, with Stop.
// Its source is in engines/odds.
engine Odds from "odds.wasm"
    uses random, progress
    limit 120 seconds
    function simulate(dice: integer, rolls: integer) -> list<integer>

page Table: window
    title @tableTitle
    size 980 x 640
    data count: integer, default 2
    data shown: integer
    sound name rattle source "roll.wav" volume 80
    sound name fanfare volume 60
    Dice name board at 1,1 span 8 rows 12 count 2 on landed: diceLanded
    label @countLabel name countLabel for countSlider at 9,1 span 4
    slider name countSlider at 9,2 span 4 bind count min 1 max 6 on change: countChanged
    label @shownLabel name shownLabel at 9,3 span 4
    display name shownBox at 9,4 span 4 rows 2 bind shown digits 2
    button @rollCaption name rollButton at 9,6 span 4 on click: rollClicked

    slideout @historySlideout name historyPanel view RollHistory width 420 resizable min 300 max 800 pinnable span 6 rows 12
    slideout @oddsSlideout name oddsPanel side bottom view DiceOdds height 320 resizable min 200 max 600 pinnable span 12 rows 7

// Every roll, the last first.
page RollHistory: view
    data rolls: list<Roll>

    table name history at 1,1 span 6 rows 12 bind rolls columns rolled, faces, total order by rolled desc

// How often each total comes up when the dice on the table roll a million
// times; the window tells it how many dice there are.
page DiceOdds: view
    data dice: integer, default 2
    data odds: list<integer>

    button @simulateCaption name simulateButton at 1,1 span 4 on click: simulateClicked
    chart bar name oddsChart at 1,2 span 12 rows 6 bind odds

code Table
    handler diceLanded(total: integer, faces: text)
        shown = total
        // Every die a six: a fanfare.
        if total == count * 6
            fanfare.melody("C5/2 E5/2 G5/2 C6*2", 160)
        let roll = new Roll
        roll.dice = count
        roll.total = total
        roll.faces = faces
        roll.rolled = now()
        save roll
        reload rolls

    handler countChanged
        board.count = count
        dice = count

    handler rollClicked
        rattle.play()
        board.roll()

code DiceOdds
    // How often each total comes up in a million rolls of the dice on the table.
    handler simulateClicked
        odds = Odds.simulate(dice, 1000000)
