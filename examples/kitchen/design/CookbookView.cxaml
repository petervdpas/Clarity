<?xml version="1.0" encoding="UTF-8"?>
<!-- What the window Cookbook shows: its parts, data and code. -->
<View class="kitchen.CookbookView">
  <Data name="recipes" type="list&lt;Recipe&gt;" />
  <Data name="recipe" type="Recipe" />
  <Data name="timerMinutes" type="integer" default="10" />
  <Data name="secondsLeft" type="integer" />
  <Table name="recipeTable" at="1,1" span="4" rows="14" bind="recipes" columns="name, course, minutes" sortable="true" add="true" remove="true" confirm="true" onadd="addRecipe" onremove="removeRecipe" onselect="recipePicked" />
  <Accordion name="recipeParts" at="5,1" span="8" rows="14" orientation="horizontal">
    <Section title="@overviewSection">
      <Content name="recipeOverviewContent" at="1,1" span="8" rows="14">
        <View name="RecipeOverview" onsaved="recipeSaved" />
      </Content>
    </Section>
    <Section title="@ingredientsSection">
      <Content name="ingredientListContent" at="1,1" span="8" rows="14">
        <View name="IngredientList" />
      </Content>
    </Section>
    <Section title="@methodSection">
      <Content name="methodStepsContent" at="1,1" span="8" rows="14">
        <View name="MethodSteps" />
      </Content>
    </Section>
    <Section title="@timerSection">
      <Label name="timerMinutesLabel" at="1,1" span="3" caption="@timerMinutesLabel" for="timerBox" />
      <Spinbox name="timerBox" at="4,1" span="2" bind="timerMinutes" max="240" min="1" />
      <Button name="startTimerButton" at="1,2" span="3" caption="@startTimerCaption" onclick="startTimer" />
      <Button name="stopTimerButton" at="4,2" span="3" caption="@stopTimerCaption" onclick="stopTimer" />
      <Label name="secondsLeftLabel" at="1,3" span="6" caption="@secondsLeftLabel" />
      <Display name="timerShown" at="1,4" span="6" rows="2" bind="secondsLeft" digits="5" />
    </Section>
  </Accordion>
  <Timer name="clock" at="1,1" span="1" every="1" ontick="ticked" />
  <Sound name="alarm" at="1,1" span="1" volume="80" />
</View>
