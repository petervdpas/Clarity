module kitchen

// When in a meal a dish is served.
enum Course
    Starter label @courseStarter
    Main label @courseMain
    Dessert label @courseDessert

entity Recipe
    name: text(80), required, unique, label @recipeNameLabel
    course: Course, default Main, label @recipeCourseLabel
    serves: integer, default 4, min 1, max 40, label @recipeServesLabel
    minutes: integer, default 30, min 0, max 1440, label @recipeMinutesLabel
    notes: text(2000), label @recipeNotesLabel

// What goes into a recipe, in the order it is listed.
entity Ingredient
    recipe: ref Recipe, required, label @ingredientRecipeLabel
    position: integer, label @ingredientPositionLabel
    name: text(80), required, label @ingredientNameLabel
    amount: text(40), label @ingredientAmountLabel

// A step of a recipe's method, in the order it is done.
entity Step
    recipe: ref Recipe, required, label @stepRecipeLabel
    position: integer, label @stepPositionLabel
    instruction: text(400), label @stepInstructionLabel

app Kitchen
    title @kitchenTitle
    main Cookbook

// The recipes at the left; the one picked opens at the right in an
// accordion of views, its headers side by side.
page Cookbook: window
    title @kitchenTitle
    size 1200 x 720
    data recipes: list<Recipe>
    data recipe: Recipe
    data timerMinutes: integer, default 10
    data secondsLeft: integer
    on open: kitchenOpened

    table name recipeTable at 1,1 span 4 rows 14 bind recipes columns name, course, minutes sortable add remove confirm on add: addRecipe on remove: removeRecipe on select: recipePicked
    accordion name recipeParts at 5,1 span 8 rows 14 horizontal on change: partOpened
        section @overviewSection view RecipeOverview
        section @ingredientsSection view IngredientList
        section @methodSection view MethodSteps
        section @timerSection
            label @timerMinutesLabel name timerMinutesLabel at 1,1 span 3 for timerBox
            spinbox name timerBox at 4,1 span 2 bind timerMinutes min 1 max 240
            button @startTimerCaption name startTimerButton at 1,2 span 3 on click: startTimer
            button @stopTimerCaption name stopTimerButton at 4,2 span 3 on click: stopTimer
            label @secondsLeftLabel name secondsLeftLabel at 1,3 span 6
            display name timerShown at 1,4 span 6 rows 2 bind secondsLeft digits 5
    timer name clock every 1 on tick: ticked
    footer
        status @kitchenStatus

// A recipe's name, course, how many it serves, how long it takes, and notes.
page RecipeOverview: view
    data dish: Recipe

    label @recipeNameLabel name dishNameLabel at 1,1 span 2 for dishNameBox
    textbox name dishNameBox at 3,1 span 6 bind dish.name
    label @recipeCourseLabel name dishCourseLabel at 1,2 span 2 for dishCourseBox
    dropdown name dishCourseBox at 3,2 span 3 bind dish.course
    label @recipeServesLabel name dishServesLabel at 1,3 span 2 for dishServesBox
    spinbox name dishServesBox at 3,3 span 2 bind dish.serves min 1 max 40
    label @recipeMinutesLabel name dishMinutesLabel at 1,4 span 2 for dishMinutesBox
    spinbox name dishMinutesBox at 3,4 span 2 bind dish.minutes min 0 max 1440
    label @recipeNotesLabel name dishNotesLabel at 1,5 span 2 for dishNotesBox
    memo name dishNotesBox at 3,5 span 6 rows 6 bind dish.notes
    button @saveRecipeCaption name saveRecipeButton at 7,12 span 2 default on click: saveDish

// What goes into the recipe, in order; Add and the trash edit the list.
page IngredientList: view
    data ingredientsOf: Recipe
    data ingredients: list<Ingredient>

    table name ingredientTable at 1,1 span 8 rows 13 bind ingredients columns name 300, amount 200 edit name, amount reorder by position add remove confirm on add: addIngredient on remove: removeIngredient on change: ingredientChanged on reorder: ingredientsMoved

// The method, step by step; drag a step to move it.
page MethodSteps: view
    data stepsOf: Recipe
    data steps: list<Step>

    table name stepTable at 1,1 span 8 rows 13 bind steps columns position 60, instruction 560 edit instruction reorder by position add remove confirm on add: addStep on remove: removeStep on change: stepChanged on reorder: stepsMoved

code Cookbook
    handler kitchenOpened
        clock.enabled = false
        stopTimerButton.enabled = false
        refreshRecipes()
        showRecipe()

    handler refreshRecipes
        recipes = find r in Recipe order by r.name

    // The views show the recipe picked; without one there is nothing to edit.
    handler showRecipe
        let picked = recipe.id != 0
        dish = recipe
        ingredientsOf = recipe
        stepsOf = recipe
        ingredients = find i in Ingredient where i.recipe == recipe order by i.position
        steps = find s in Step where s.recipe == recipe order by s.position
        saveRecipeButton.enabled = picked
        ingredientTable.enabled = picked
        stepTable.enabled = picked

    handler recipePicked
        let picked = recipeTable.selected
        recipe = picked
        timerMinutes = recipe.minutes
        showRecipe()

    handler addRecipe
        let r = new Recipe
        r.name = free_name(@newRecipeName, find x in Recipe order by x.name)
        save r
        recipe = r
        refreshRecipes()
        recipeTable.selected = r
        recipeParts.open = 1
        showRecipe()

    // A recipe goes with its ingredients and its method.
    handler removeRecipe
        let gone = recipeTable.selected
        for i in find i in Ingredient where i.recipe == gone
            delete i
        for s in find s in Step where s.recipe == gone
            delete s
        delete gone
        recipe = new Recipe
        refreshRecipes()
        showRecipe()

    // What the overview saved shows in the list once another section opens.
    handler partOpened
        refreshRecipes()

    handler startTimer
        secondsLeft = timerMinutes * 60
        clock.enabled = true
        startTimerButton.enabled = false
        stopTimerButton.enabled = true

    handler stopTimer
        clock.enabled = false
        startTimerButton.enabled = true
        stopTimerButton.enabled = false

    handler ticked
        secondsLeft = secondsLeft - 1
        if secondsLeft <= 0
            secondsLeft = 0
            stopTimer()
            message @timerDone

code RecipeOverview
    handler saveDish
        save dish

code IngredientList
    handler addIngredient
        if ingredientsOf.id == 0
            return
        let i = new Ingredient
        i.recipe = ingredientsOf
        i.position = count(ingredients) + 1
        i.name = @newIngredientName
        save i
        ingredients = find x in Ingredient where x.recipe == ingredientsOf order by x.position

    handler removeIngredient
        delete ingredientTable.selected
        ingredients = find x in Ingredient where x.recipe == ingredientsOf order by x.position

    handler ingredientChanged
        save ingredientTable.selected

    handler ingredientsMoved
        for i in ingredients
            save i

code MethodSteps
    handler addStep
        if stepsOf.id == 0
            return
        let s = new Step
        s.recipe = stepsOf
        s.position = count(steps) + 1
        save s
        steps = find x in Step where x.recipe == stepsOf order by x.position

    handler removeStep
        delete stepTable.selected
        steps = find x in Step where x.recipe == stepsOf order by x.position

    handler stepChanged
        save stepTable.selected

    handler stepsMoved
        for s in steps
            save s

// The word, or the word with the first number no recipe has.
function free_name(word: text, all: list<Recipe>) -> text
    let name = word
    let n = 1
    for step in 1 to 1000
        let taken = false
        for r in all
            if r.name == name
                taken = true
        if not taken
            return name
        n = n + 1
        name = "{word} {n}"
    return name
