<?xml version="1.0" encoding="UTF-8"?>
<!-- The ledger of the project picked: the projects and the ledger's entries
     in the sidebar at the left, grouped as the ledger's index, the entry
     picked on the right, and its review in a slide-out. -->
<Window class="maintenance.Main" title="@mainTitle" width="1280" height="800" onopen="windowOpened" onreturn="windowReturned">
  <Data name="projects" type="list&lt;Project&gt;" />
  <Data name="entries" type="list&lt;Entry&gt;" />
  <Data name="projectName" type="text" />
  <Data name="piece" type="text" />
  <Data name="related" type="text" />
  <Data name="codePaths" type="text" />
  <Data name="oldReferences" type="text" />
  <Data name="reviewed" type="bool" />
  <Data name="reviewer" type="Reviewer" />
  <Data name="reviewedOn" type="text" />
  <Data name="notes" type="text" />
  <Data name="ownReferences" type="text" />
  <Toolbar name="mainToolbar">
    <Item kind="button" caption="@projectsButtonCaption" name="projectsButton" icon="folder" opens="Projects" />
    <Item kind="separator" />
    <Item kind="button" caption="@reloadButtonCaption" name="reloadButton" icon="refresh-cw" onclick="reloadClicked" />
    <Item kind="button" caption="@reviewButtonCaption" name="reviewButton" icon="square-check" onclick="reviewClicked" />
  </Toolbar>
  <Sidebar side="left" name="ledgerSidebar" width="420" min="280" max="800" resizable="true" columns="6">
    <List name="projectList" at="1,1" span="6" rows="4" bind="projects" show="name" onselect="projectPicked" />
    <Text name="projectNameText" at="1,5" span="6" bind="projectName" />
    <TreeTable name="entryTree" at="1,6" span="6" rows="18" bind="entries" columns="label, status, reviewed" resizable="true" rowKey="key" parentKey="parent" onselect="entryPicked" />
  </Sidebar>
  <Content name="main" at="1,1" span="12" rows="16">
    <View name="MainView" />
  </Content>
  <Slideout name="reviewPanel" at="1,1" span="6" rows="22" caption="@reviewSlideout" resizable="true" side="right" slideWidth="480" pinnable="true" max="900" min="320">
    <Checkbox name="reviewedBox" at="1,1" span="6" caption="@reviewedLabel" bind="reviewed" />
    <Label name="reviewerLabel" at="1,2" span="2" caption="@reviewerLabel" />
    <Dropdown name="reviewerBox" at="3,2" span="4" bind="reviewer" />
    <Label name="reviewedOnLabel" at="1,3" span="2" caption="@reviewedOnLabel" />
    <Textbox name="reviewedOnBox" at="3,3" span="4" bind="reviewedOn" />
    <Label name="notesLabel" at="1,4" span="6" caption="@notesLabel" />
    <Memo name="notesBox" at="1,5" span="6" rows="5" bind="notes" markdown="true" />
    <Label name="ownReferencesLabel" at="1,10" span="6" caption="@ownReferencesLabel" />
    <Memo name="ownReferencesBox" at="1,11" span="6" rows="2" bind="ownReferences" />
    <Label name="relatedLabel" at="1,13" span="6" caption="@relatedLabel" />
    <Memo name="relatedBox" at="1,14" span="6" rows="2" bind="related" readonly="true" />
    <Label name="codePathsLabel" at="1,16" span="6" caption="@codePathsLabel" />
    <Memo name="codePathsBox" at="1,17" span="6" rows="2" bind="codePaths" readonly="true" />
    <Label name="oldReferencesLabel" at="1,19" span="6" caption="@oldReferencesLabel" />
    <Memo name="oldReferencesBox" at="1,20" span="6" rows="2" bind="oldReferences" readonly="true" />
    <Button name="saveReviewButton" at="5,22" span="2" caption="@saveReviewCaption" icon="save" default="true" onclick="saveReviewClicked" />
  </Slideout>
</Window>
