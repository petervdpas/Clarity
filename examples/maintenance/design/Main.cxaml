<?xml version="1.0" encoding="UTF-8"?>
<!-- The ledger of the project picked: the projects and the ledger's entries
     in the sidebar at the left, grouped as the ledger's index, the entry
     picked on the right, and its review in a slide-out. -->
<Window class="maintenance.Main" title="@mainTitle" width="1280" height="756" onopen="windowOpened" onreturn="windowReturned">
  <Data name="projects" type="list&lt;Project&gt;" />
  <Data name="project" type="Project" />
  <Data name="entryProgress" type="integer" />
  <Data name="dossier" type="Dossier" />
  <Data name="review" type="Review" />
  <Data name="categories" type="list&lt;Category&gt;" />
  <Data name="reviewItems" type="list&lt;ReviewItem&gt;" />
  <Data name="dossierCards" type="list&lt;DossierCard&gt;" />
  <Menu name="mainMenu" width="140">
    <Item caption="@maintenanceItem" name="maintenanceItem">
      <Item caption="@projectsButtonCaption" name="projectsItem" icon="folder" opens="Projects" />
      <Item caption="@categoriesTitle" name="categoriesItem" icon="tags" opens="Categories" />
      <Item caption="@preferencesButtonCaption" name="preferencesItem" icon="settings" opens="Preferences" />
      <Item caption="@importDossiersCaption" name="importDossiersItem" icon="files" onclick="importDossiersClicked" />
      <Item caption="@quitItem" name="quitItem" opens="quit" />
    </Item>
  </Menu>
  <Toolbar name="mainToolbar">
    <Item kind="separator" />
    <Item kind="button" caption="@reloadButtonCaption" name="reloadButton" icon="refresh-cw" onclick="reloadClicked" />
    <Item kind="button" caption="@addDossierCaption" name="addDossierButton" icon="folder-plus" onclick="addDossierClicked" />
    <Item kind="button" caption="@saveDossierCaption" name="saveDossierButton" icon="save" onclick="saveDossierClicked" />
    <Item kind="separator" />
  </Toolbar>
  <Sidebar side="left" name="ledgerSidebar" width="420" min="280" max="800" resizable="true" columns="6">
    <Splitter name="ledgerSplitter" at="1,1" span="6" rows="15" orientation="vertical">
      <Pane rows="4">
        <List name="projectList" at="1,1" span="6" rows="2" bind="projects" show="name" onselect="projectPicked" />
      </Pane>
      <Pane>
        <List name="dossierList" at="1,1" span="6" rows="4" bind="dossierCards" show="name, category, done" cards="true" cardColor="categoryColor" cardChip="category" onselect="dossierPicked" />
      </Pane>
    </Splitter>
  </Sidebar>
  <Footer status="@mainStatus" columns="12">
    <StatusItem name="progressItem" at="7,1" span="2" caption="@progressItemCaption" bind="entryProgress" icon="gauge" max="100" />
    <StatusItem name="reviewItem" at="9,1" span="2" caption="@reviewItemCaption" icon="clipboard-check" onclick="reviewClicked" />
    <StatusItem name="ledgerItem" at="11,1" span="2" caption="@ledgerItemCaption" icon="database" />
  </Footer>
  <Content name="main" at="1,1" span="12" rows="14">
    <View name="MainView" />
  </Content>
  <Slideout name="reviewPanel" at="1,1" span="6" rows="14" caption="@reviewSlideout" resizable="true" side="right" slideWidth="680" pinnable="true" max="900" min="320">
    <Label name="categoryLabel" at="1,1" span="2" caption="@dossierCategoryLabel" />
    <Dropdown name="categoryBox" at="3,1" span="4" bind="dossier.category" />
    <Checkbox name="reviewedBox" at="1,2" span="6" caption="@reviewedLabel" bind="review.reviewed" />
    <Label name="reviewerLabel" at="1,3" span="2" caption="@reviewerLabel" />
    <Dropdown name="reviewerBox" at="3,3" span="4" bind="review.reviewer" />
    <Label name="reviewedOnLabel" at="1,4" span="2" caption="@reviewedOnLabel" />
    <Date name="reviewedOnBox" at="3,4" span="4" bind="review.reviewedOn" />
    <Label name="percentDoneLabel" at="1,5" span="2" caption="@reviewPercentLabel" />
    <Progress name="percentDoneBar" at="3,5" span="4" bind="review.percentDone" />
    <Label name="notesLabel" at="1,6" span="6" caption="@notesLabel" />
    <Memo name="notesBox" at="1,7" span="6" rows="3" bind="review.notes" />
    <Label name="reviewItemsLabel" at="1,10" span="6" caption="@reviewItemsLabelCaption" />
    <Table name="itemTable" at="1,11" span="6" rows="4" bind="reviewItems" columns="done, summary, kind" edit="done, summary, kind" switches="done" widths="{&quot;done&quot;:60,&quot;kind&quot;:110,&quot;summary&quot;:440}" add="true" remove="true" confirm="true" onchange="itemChanged" onadd="itemAdded" onremove="itemRemoved" />
    <Button name="saveReviewButton" at="5,15" span="2" caption="@saveReviewCaption" onclick="saveReviewClicked" />
  </Slideout>
</Window>
