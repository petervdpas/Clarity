classDiagram
    namespace maintenance {
        class Project {
            +name: text(80), required, unique
        }
        class Category {
            +name: text(80), required, unique
            +folder: folder, extensions "*.md"
            +color: color
        }
        class Dossier {
            +name: text(200), required
            +category: Category, required
            +inFolder: text(200)
            +project: Project, required, cascade
        }
        class Review {
            +dossier: Dossier, required, unique, cascade
            +reviewed: bool
            +reviewer: Reviewer, default Peter
            +reviewedOn: date
            +reviewedAt: datetime
            +notes: text
            +percentDone: integer, min 0, max 100
        }
        class ReviewItem {
            +summary: text(400), required
            +kind: ItemKind, default Missing
            +notes: text
            +review: Review, required, cascade
            +done: bool
        }
        class Reviewer {
            <<enumeration>>
            Peter
            Claude
        }
        class ItemKind {
            <<enumeration>>
            Missing
            New
            Differs
            Wrong
        }
    }
    class maintenance {
        <<module>>
        +lineAfter(body: text, prefix: text) text
        +titleOf(body: text, fileName: text) text
        +percentOf(items: List~ReviewItem~) integer
        +changedSince(modified: datetime, one: Review) bool
        +cardOf(d: Dossier, reviews: List~Review~) DossierCard
        +staleSince(modified: datetime, d: Dossier, reviews: List~Review~) bool
        +hasFile(d: Dossier) bool
        +fileOf(d: Dossier) List~file~
        +recount(r: Review)
    }
    Dossier "*" --> "1" Project : project
    Dossier "*" --> "1" Category : category
    Review "0..1" --> "1" Dossier : dossier
    ReviewItem "*" --> "1" Review : review
