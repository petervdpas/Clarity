erDiagram
    Project {
        text(80) name UK "required"
    }
    Category {
        text(80) name UK "required"
        folder folder
        color color
    }
    Dossier {
        text(200) name "required"
        Category category FK "required"
        text(200) inFolder
        Project project FK "required"
    }
    Review {
        Dossier dossier FK, UK "required"
        bool reviewed
        Reviewer reviewer
        date reviewedOn
        datetime reviewedAt
        text notes
        integer percentDone
    }
    ReviewItem {
        text(400) summary "required"
        ItemKind kind
        text notes
        Review review FK "required"
        bool done
    }
    Dossier }o..|| Category : category
    Dossier }o..|| Project : project
    Review }o..|| Dossier : dossier
    ReviewItem }o..|| Review : review
