module maintenance

// A project whose development ledger is reviewed: its name and the folder
// of its ledger, which holds an index (README.md) and one Markdown file per
// piece. Clarity is one of them.
entity Project
    name: text(80), required, unique, label @projectNameLabel
    ledgerFolder: text(400), required, label @projectLedgerFolderLabel

// Who reviewed an entry.
enum Reviewer
    Peter label @reviewerPeter
    Claude label @reviewerClaude

// The review of one entry of a project's ledger: kept in the app's own
// database, never in the ledger.
entity Review
    piece: text(120), required, label @reviewPieceLabel
    reviewed: bool, label @reviewedLabel
    reviewer: Reviewer, default Peter, label @reviewerLabel
    reviewedOn: date, label @reviewedOnLabel
    notes: text, label @notesLabel
    ownReferences: text, label @ownReferencesLabel
    project: ref Project, required, cascade, label @reviewProjectLabel

// A row of the ledger's tree: a group of the index, or an entry under it.
record Entry
    key: text
    parent: text
    label: text
    status: text
    reviewed: text
    body: text

// What the person sets for themselves: the ledger folder the picked project
// points the ledger store at, the project picked last, and what AI agents
// may do while the app is closed.
settings
    language
    theme
    ledgerFolder: folder, label @ledgerFolderSetting
    lastProject: text, label @lastProjectSetting
    agentReadsWhileClosed
    agentChangesWhileClosed

// The rest of the first line that starts with `prefix`; empty when none does.
function lineAfter(body: text, prefix: text) -> text
    for line in split(body, "\n")
        if startsWith(line, prefix)
            return trim(slice(line, length(prefix) + 1, length(line)))
    return ""

// An entry's title, its first heading; the piece's name when it has none.
function titleOf(body: text, piece: text) -> text
    let title = lineAfter(body, "# ")
    if title == ""
        return piece
    return title

// The word of an entry's status line: built, partial, not built, needs decision.
function statusOf(body: text) -> text
    let line = lineAfter(body, "Status: ")
    let stop = indexOf(line, ".")
    if stop == 0
        return line
    return slice(line, 1, stop - 1)

// The lines under a `## heading`, up to the next heading.
function sectionOf(body: text, heading: text) -> text
    let lines: list<text> = []
    let inside = false
    for line in split(body, "\n")
        if startsWith(line, "## ")
            inside = trim(slice(line, 4, length(line))) == heading
        else
            if inside
                lines = lines + [line]
    return trim(join(lines, "\n"))

// The other entries an entry links to, as `[name](name.md)`, each once.
function linksOf(body: text) -> text
    let names: list<text> = []
    let pieces = split(body, "](")
    for i in 2 to count(pieces)
        let rest = pieces[i]
        let stop = indexOf(rest, ".md)")
        if stop > 1
            let name = slice(rest, 1, stop - 1)
            if indexOf(name, "/") == 0 and not (names contains name)
                names = names + [name]
    return join(names, ", ")

// The piece a ledger file is about: its name without `.md`.
function pieceOf(fileName: text) -> text
    return slice(fileName, 1, length(fileName) - 3)

code Main
    handler windowOpened
        loadProjects()

    // Projects may have been added, changed or removed.
    handler windowReturned
        loadProjects()

    // The ledger is read again only when the picked project changed (another
    // one, or its folder): coming back from a dialog keeps the entry shown,
    // and what was typed in it and not saved yet.
    handler loadProjects
        projects = find p in Project order by p.name
        for p in projects
            if p.name == settings.lastProject
                projectList.selected = p
                if project.name != p.name or project.ledgerFolder != p.ledgerFolder
                    showLedger(p)

    handler projectPicked
        showLedger(projectList.selected)

    // Points the ledger store at the project's ledger and lists its entries.
    handler showLedger(picked: Project)
        settings.ledgerFolder = picked.ledgerFolder
        settings.lastProject = picked.name
        project = picked
        loadEntries()

    handler reloadClicked
        loadEntries()

    // The entries in the groups and order of the ledger's index, then the
    // entries the index does not list yet.
    handler loadEntries
        let rows: list<Entry> = []
        let done: list<text> = []
        let reviews = find r in Review where r.project == project and r.reviewed
        for one in reviews
            done = done + [one.piece]
        let found = files f in ledger where f.extension == "md" order by f.path
        let index = ""
        for f in found
            if f.path == "README.md"
                index = read text of f
        let listed: list<text> = []
        let group = ""
        for line in split(index, "\n")
            if startsWith(line, "### ")
                group = trim(slice(line, 5, length(line)))
                let g = new Entry
                g.key = "group:" + group
                g.label = group
                rows = rows + [g]
            else
                if startsWith(line, "| [")
                    let listedPiece = slice(line, 4, indexOf(line, "]") - 4)
                    listed = listed + [listedPiece]
                    rows = rows + [entryOf(found, listedPiece, "group:" + group, done)]
        let unlisted: list<Entry> = []
        for f in found
            let filePiece = pieceOf(f.name)
            if indexOf(f.path, "/") == 0 and f.path != "README.md" and not (listed contains filePiece)
                unlisted = unlisted + [entryOf(found, filePiece, "group:unlisted", done)]
        if count(unlisted) > 0
            let g = new Entry
            g.key = "group:unlisted"
            g.label = @notInIndexGroup
            rows = rows + [g] + unlisted
        entries = rows
        clearEntry()

    handler clearEntry
        piece = ""
        entryBody = ""

    // Shows the entry picked, with its review from the app's database, or a
    // new review when it has none yet.
    handler entryPicked
        let e = entryTree.selected
        if e.parent == ""
            return
        piece = e.key
        entryBody = e.body
        related = linksOf(e.body)
        codePaths = sectionOf(e.body, "Code") + "\n\n" + sectionOf(e.body, "Tests")
        oldReferences = sectionOf(e.body, "Was")
        let found = find r in Review where r.project == project and r.piece == piece
        if count(found) > 0
            review = found[1]
        else
            let fresh = new Review
            fresh.project = project
            fresh.piece = piece
            review = fresh

    handler reviewClicked
        if piece == ""
            message info @pickAnEntry
            return
        reviewPanel.visible = true

    // Writes the entry as edited back into its file in the ledger, and keeps
    // the tree and the review's references in step with it.
    handler saveEntryClicked
        if piece == ""
            message info @pickAnEntry
            return
        write entryBody to ledger piece + ".md"
        let rows: list<Entry> = []
        for e in entries
            if e.key == piece
                e.body = entryBody
                e.label = titleOf(entryBody, piece)
                e.status = statusOf(entryBody)
            rows = rows + [e]
        entries = rows
        related = linksOf(entryBody)
        codePaths = sectionOf(entryBody, "Code") + "\n\n" + sectionOf(entryBody, "Tests")
        oldReferences = sectionOf(entryBody, "Was")
        message info @entrySaved(piece = piece)

    // Stores the review in the app's database and marks the entry in the tree.
    handler saveReviewClicked
        if piece == ""
            return
        if review.reviewed and review.reviewedOn == none
            review.reviewedOn = today()
        save review
        let rows: list<Entry> = []
        for e in entries
            if e.key == piece
                if review.reviewed
                    e.reviewed = "yes"
                else
                    e.reviewed = ""
            rows = rows + [e]
        entries = rows
        message info @reviewSaved(piece = piece)

// One row of the tree for the ledger file of `piece`, marked when it is
// among the pieces reviewed (`done`).
action entryOf(found: list<file>, piece: text, parent: text, done: list<text>) -> Entry
    effects files.read
    let e = new Entry
    e.key = piece
    e.parent = parent
    e.label = piece
    for f in found
        if f.path == piece + ".md"
            e.body = read text of f
            e.label = titleOf(e.body, piece)
            e.status = statusOf(e.body)
    if done contains piece
        e.reviewed = "yes"
    return e

code Projects
    handler projectsOpened
        projects = find p in Project order by p.name

code ProjectsView
    handler projectAdded
        let p = new Project
        p.name = @newProjectName
        p.ledgerFolder = @newProjectFolder
        save p
        projects = find x in Project order by x.name

    handler projectChanged
        save projectTable.selected

    handler projectRemoved
        delete projectTable.selected
        projects = find x in Project order by x.name

// The commands for AI agents, which the app serves itself (`maintenance mcp`):
// the projects and their reviews, kept in the app's own database.
command project list
    help @projectListHelp
    agent
    let found = find p in Project order by p.name
    print found columns name, ledgerFolder

command project add(name: text, folder: text)
    help @projectAddHelp
    agent
    let p = new Project
    p.name = name
    p.ledgerFolder = folder
    save p
    print @projectAdded(name = p.name)

command review list(project: text)
    help @reviewListHelp
    agent
    option all: bool, help @reviewListAllHelp
    let owners = find p in Project where p.name == project
    if count(owners) == 0
        refuse @noSuchProject(name = project)
    let reviews = find r in Review where r.project == owners[1] and r.reviewed order by r.piece
    if all
        reviews = find r in Review where r.project == owners[1] order by r.piece
    print reviews columns piece, reviewed, reviewer, reviewedOn

command review show(project: text, piece: text)
    help @reviewShowHelp
    agent
    let owners = find p in Project where p.name == project
    if count(owners) == 0
        refuse @noSuchProject(name = project)
    let kept = find r in Review where r.project == owners[1] and r.piece == piece
    if count(kept) == 0
        refuse @noReviewYet(piece = piece)
    print kept columns piece, reviewed, reviewer, reviewedOn
    print kept[1].notes

// Reviewed when --reviewed is given, else not; the notes stay as they were when none are given.
command review set(project: text, piece: text)
    help @reviewSetHelp
    agent
    option reviewed: bool, help @reviewSetReviewedHelp
    option reviewer: Reviewer, default Claude, help @reviewSetReviewerHelp
    option notes: text, help @reviewSetNotesHelp
    let owners = find p in Project where p.name == project
    if count(owners) == 0
        refuse @noSuchProject(name = project)
    let kept = find r in Review where r.project == owners[1] and r.piece == piece
    let r = new Review
    if count(kept) > 0
        r = kept[1]
    else
        r.project = owners[1]
        r.piece = piece
    r.reviewed = reviewed
    r.reviewer = reviewer
    if notes != ""
        r.notes = notes
    if reviewed and r.reviewedOn == none
        r.reviewedOn = today()
    save r
    print @reviewStored(piece = piece, project = project)
