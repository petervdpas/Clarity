// Written by Clarity from the changes in the data dictionary. Check it
// before it runs; once a step has run on a database, it never changes.
migration "Projects, dossiers, their reviews and review items"
    add entity Project
        version
        name: text(80), unique
        ledgerFolder: text(400)
    add entity Category
        version
        name: text(80), unique
    add entity Dossier
        version
        name: text(200)
        category: ref Category
        page: text(200)
        project: ref Project
    add entity Review
        version
        dossier: ref Dossier, unique
        reviewed: bool
        reviewer: Reviewer, default Peter
        reviewedOn: date
        reviewedAt: datetime
        notes: text
        percentDone: integer
    add entity ReviewItem
        version
        summary: text(400)
        kind: ItemKind, default NotInManual
        ledgerRef: text(200)
        notes: text
        review: ref Review
