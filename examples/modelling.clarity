// The data modelling example: domains with their classes, edited in a
// workspace of views. A tree of domains and classes stands at the left; a
// class opens in the class editor, a view in the middle of the window, and
// the domain's class diagram or ERD slides up from the bottom. Its modules are
// in the modelling folder next to this file.
project Modelling
    title "Data Modelling"
    stack rust desktop
    output "out"
    language "en"
    theme Studio Midnight
    filestore adapter "setting:adapterFolder"
    datasource main sqlite "data/modelling.db"
