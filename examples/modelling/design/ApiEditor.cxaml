<?xml version="1.0" encoding="UTF-8"?>
<!-- A version of an API: its number, the views it makes in their order, and
     the FcdmApi-vN.json the app writes for it into the adapter folder. A view
     is added from its table. It tells the window when it saved. -->
<View class="modelling.ApiEditor" columns="8">
  <Data name="editedApi" type="ApiVersion" />
  <Data name="apiViews" type="list&lt;ApiView&gt;" />
  <Data name="jsonText" type="text" />
  <Tells message="saved" />
  <Tabs name="apiTabs" at="1,1" span="8" rows="14">
    <Tab title="@apiVersionTab">
      <Label name="apiMajorLabel" at="1,1" span="2" caption="@apiMajorLabel" for="apiMajorBox" />
      <Spinbox name="apiMajorBox" at="3,1" span="1" bind="editedApi.major" max="99" min="1" />
      <Textbox name="apiVersionBox" at="4,1" span="2" bind="editedApi.version" placeholder="@apiVersionPlaceholder" />
      <Button name="saveApiButton" at="7,1" span="2" caption="@saveApiCaption" default="true" onclick="saveApiClicked" />
      <Label name="apiViewsLabel" at="1,2" span="8" caption="@viewsCaption" />
      <Table name="apiViewTable" at="1,3" span="8" rows="11" bind="apiViews" columns="entity, adapterTable" widths="{&quot;adapterTable&quot;:280,&quot;entity&quot;:280}" remove="true" confirm="true" reorder="position" onremove="removeApiViewClicked" onreorder="apiViewsMoved" />
    </Tab>
    <Tab title="@apiJsonTab">
      <Memo name="jsonBox" at="1,1" span="8" rows="12" bind="jsonText" code="json" copy="true" readonly="true" />
      <Label name="apiFolderLabel" at="1,13" span="2" caption="@adapterFolderLabel" for="apiFolderBox" />
      <Folder name="apiFolderBox" at="3,13" span="4" bind="settings.adapterFolder" />
      <Button name="writeApiButton" at="7,13" span="2" caption="@writeApiCaption" icon="save" onclick="writeApiClicked" />
    </Tab>
  </Tabs>
</View>
