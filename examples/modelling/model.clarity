module model

// A part of the business the model covers, as Hr or Education: its classes
// are designed together and drawn on one diagram.
entity Domain
    name: text(80), required, unique, label @domainNameLabel
    summary: text, label @domainSummaryLabel

// A class of a domain: a box of the class diagram and a table of the ERD.
entity ModelClass
    domain: ref Domain, required, cascade, label @classDomainLabel
    name: text(80), required, label @classNameLabel
    summary: text, label @classSummaryLabel
    // Where its box is on the domain's diagrams, in the canvas's units.
    x: integer, label @classXLabel
    y: integer, label @classYLabel

// A property of a class. Its type is a value type (string, int, decimal,
// bool, DateTime) or the name of another class of the domain, or a list of
// one (list<Name>): a line on the class diagram, a foreign key in the ERD.
entity Property
    owner: ref ModelClass, required, cascade, label @propertyOwnerLabel
    position: integer, min 1, default 1, label @propertyPositionLabel
    name: text(60), required, label @propertyNameLabel
    type: text(60), required, default "string", label @propertyTypeLabel
    optional: bool, default false, label @propertyOptionalLabel
    // The bend points of its line on the diagrams, when it names a class: x, y, x, y, ...
    via: list<integer>, label @propertyViaLabel
