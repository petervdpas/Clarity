module model

// A domain of the canonical data model, as Hr or Onderwijs: one namespace,
// and the two packages its data objects and their events are published in.
entity Domain
    name: text(80), required, unique, label @domainNameLabel
    summary: text, label @domainSummaryLabel
    modelPackage: text(120), label @domainModelPackageLabel
    modelVersion: text(20), label @domainModelVersionLabel
    messagesPackage: text(120), label @domainMessagesPackageLabel
    messagesVersion: text(20), label @domainMessagesVersionLabel
    // Whether its model project uses Newtonsoft.Json, so its enums get that converter too.
    newtonsoft: bool, default true, label @domainNewtonsoftLabel

// A data object stands on its own (a root, with a business key and an
// interface) or lives in the lists of another (a child).
enum ObjectKind
    Root label @objectKindRoot
    Child label @objectKindChild

// A data object of a domain, as Medewerker or Arbeidscontract, whatever its
// versions: its classes and entities are made from its versions.
entity DataObject
    domain: ref Domain, required, cascade, label @objectDomainLabel
    name: text(80), required, label @objectNameLabel
    kind: ObjectKind, default Root, label @objectKindLabel
    // Whether it has a business key (Bk): every root has, but a few.
    keyed: bool, default true, label @objectKeyedLabel
    summary: text, label @objectSummaryLabel
    // Where its box is on the domain's diagrams, in the canvas's units.
    x: integer, label @objectXLabel
    y: integer, label @objectYLabel

// What a data object looks like from a version on: 1 is the domain's own
// namespace, 2 and up its vN namespaces. A version of the domain holds each
// data object at its newest version up to that number.
entity ObjectVersion
    owner: ref DataObject, required, cascade, label @versionOwnerLabel
    number: integer, min 1, default 1, label @versionNumberLabel
    // Why it is no longer to be used; empty while it is.
    obsolete: text(400), label @versionObsoleteLabel
    // Why someone should look at it (the import changed a public name); empty when nothing asks for it.
    review: text(400), label @reviewLabel

// A table the adapter keeps a data object in. A data object can have
// several: the adapter makes a new entity (Models.V2) when it needs other
// columns, and keeps the old table while older API versions read it. A
// table of the adapter's own (DeletedEntities) has no data object.
entity AdapterTable
    // The data object kept in it; none for a table of the adapter's own.
    owner: ref DataObject, cascade, label @tableOwnerLabel
    name: text(120), required, label @tableNameLabel
    // The adapter entity's class, as Cursus or DeletedEntity.
    entityName: text(120), label @tableEntityNameLabel
    // The adapter entity kept in it: 1 for Models, N for Models.VN.
    entityVersion: integer, min 1, default 1, label @tableEntityVersionLabel
    // Its columns and primary key as the adapter's model class has them (`Bk: string`).
    columns: list<text>, label @tableColumnsLabel
    keys: list<text>, label @tableKeysLabel
    // Where a table of the adapter's own stands on the ERD; 0, 0 until it is moved.
    x: integer, label @objectXLabel
    y: integer, label @objectYLabel

// An event that fills an adapter table, as the adapter's data-intake
// handler takes it: it writes a row, or a deleted event deletes one (and
// adds one to DeletedEntities). Tables are filled from events only.
entity TableIntake
    table: ref AdapterTable, required, cascade, label @intakeTableLabel
    event: ref EventType, required, cascade, label @intakeEventLabel
    deletes: bool, default false, label @intakeDeletesLabel

// What a property holds: a value, one of the domain's enums, a data object
// held inside, a list of those, or the business key of another data object.
enum PropertyKind
    TextValue label @kindText
    WholeNumber label @kindWholeNumber
    DecimalNumber label @kindDecimalNumber
    YesNo label @kindYesNo
    Moment label @kindMoment
    MomentWithOffset label @kindMomentWithOffset
    DayOnly label @kindDayOnly
    EnumChoice label @kindEnumChoice
    HeldObject label @kindHeldObject
    HeldObjects label @kindHeldObjects
    BusinessKey label @kindBusinessKey

// A property of a version of a data object, in its order.
entity Property
    owner: ref ObjectVersion, required, cascade, label @propertyOwnerLabel
    position: integer, min 1, default 1, label @propertyPositionLabel
    name: text(80), required, label @propertyNameLabel
    kind: PropertyKind, default TextValue, label @propertyKindLabel
    nullable: bool, default false, label @propertyNullableLabel
    // The enum of an enum choice.
    choice: ref EnumType, label @propertyChoiceLabel
    // The data object it holds, or whose business key it is (in any domain).
    target: ref DataObject, label @propertyTargetLabel
    // What it starts as when it was added later (null, 0): it is not breaking then.
    initial: text(80), label @propertyInitialLabel
    // Worked out from the others, never stored: an expression in C#.
    computed: text(400), label @propertyComputedLabel
    obsolete: text(400), label @propertyObsoleteLabel
    // The bend points of its line on the diagrams: x, y, x, y, ...
    via: list<integer>, label @propertyViaLabel

// An enum of a domain, never versioned.
entity EnumType
    domain: ref Domain, required, cascade, label @enumDomainLabel
    name: text(80), required, label @enumNameLabel
    summary: text, label @enumSummaryLabel
    // Where its box is on the class diagram, in the canvas's units; 0, 0 until it is moved.
    x: integer, label @objectXLabel
    y: integer, label @objectYLabel

// A value of an enum, with the number it is kept as.
entity EnumValue
    owner: ref EnumType, required, cascade, label @enumValueOwnerLabel
    position: integer, min 1, default 1, label @enumValuePositionLabel
    name: text(80), required, label @enumValueNameLabel
    number: integer, label @enumValueNumberLabel

// What an event tells: that a data object changed, was deleted, made or
// updated, or something of its own.
enum EventKind
    Changed label @eventKindChanged
    Deleted label @eventKindDeleted
    Created label @eventKindCreated
    Updated label @eventKindUpdated
    Other label @eventKindOther

// An event a domain's messages project publishes, under Events/ (version 1)
// or Events/vN. A base event is one line on fcdm's base classes and carries
// one version of a data object; any other has fields of its own. Its
// namespace is kept as published: NServiceBus routes a message by it.
entity EventType
    domain: ref Domain, required, cascade, label @eventDomainLabel
    name: text(120), required, label @eventNameLabel
    number: integer, min 1, default 1, label @eventNumberLabel
    namespace: text(200), label @eventNamespaceLabel
    kind: EventKind, default Changed, label @eventKindLabel
    base: bool, default true, label @eventBaseLabel
    // For a base event: the version of the data object it carries.
    carries: ref ObjectVersion, label @eventCarriesLabel
    obsolete: text(400), label @eventObsoleteLabel
    // Why someone should look at it; empty when nothing asks for it.
    review: text(400), label @reviewLabel
    summary: text, label @eventSummaryLabel

// How a field that holds several is typed.
enum ListStyle
    Single label @listSingle
    Sequence label @listSequence
    ArrayOf label @listArray
    ListOf label @listList

// Which accessors a field has.
enum Access
    InitOnly label @accessInit
    GetOnly label @accessGet
    GetSet label @accessSet

// A field of an event that is no base event, in its constructor's order.
entity EventField
    owner: ref EventType, required, cascade, label @eventFieldOwnerLabel
    position: integer, min 1, default 1, label @eventFieldPositionLabel
    name: text(80), required, label @eventFieldNameLabel
    kind: PropertyKind, default TextValue, label @eventFieldKindLabel
    nullable: bool, default false, label @eventFieldNullableLabel
    // The version of the data object it holds.
    holds: ref ObjectVersion, label @eventFieldHoldsLabel
    // The data object whose business key it is.
    keyOf: ref DataObject, label @eventFieldKeyOfLabel
    list: ListStyle, default Single, label @eventFieldListLabel
    access: Access, default InitOnly, label @eventFieldAccessLabel
    obsolete: text(400), label @eventFieldObsoleteLabel
