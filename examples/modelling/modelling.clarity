module modelling

use model

app Modelling
    title @modellingTitle
    main Workspace

// A row of the tree at the left: a domain, or a class under its domain.
record Node
    key: text
    parent: text
    label: text
    kind: text
    domain: ref Domain
    model: ref ModelClass

// What the diagram view draws of the domain.
enum DiagramKind
    ClassDiagram label @diagramKindClass
    Erd label @diagramKindErd

// The workspace: the domains and their classes in the tree at the left, the
// domain picked in the middle. A class picked opens the class editor, which
// slides out from the right; the domain's diagrams slide up from the footer.
page Workspace: window
    title @workspaceTitle
    size 1280 x 800
    data nodes: list<Node>
    data domain: Domain
    on open: workspaceOpened

    heading @domainHeading name domainHeading at 1,1 span 8
    label @pickADomain name pickADomain at 1,2 span 8
    label @domainNameCaption name domainNameLabel at 1,3 span 2 for domainNameBox
    textbox name domainNameBox at 3,3 span 5 bind domain.name
    label @domainSummaryCaption name domainSummaryLabel at 1,4 span 2 for domainSummaryBox
    memo name domainSummaryBox at 3,4 span 5 rows 3 bind domain.summary
    button @saveDomainCaption name saveDomainButton at 6,7 span 2 on click: saveDomainClicked

    slideout @classSlideout name classPanel view ClassEditor width 560 resizable min 420 max 1000 pinnable span 6 rows 13 on close: classPanelClosed
    slideout @diagramSlideout name diagramPanel side bottom view DiagramCanvas height 400 resizable min 220 max 900 pinnable span 12 rows 9

    sidebar left name explorer width 300 grid 6 columns
        button @newDomainCaption name newDomainButton at 1,1 span 3 icon "plus" on click: newDomainClicked
        button @newClassCaption name newClassButton at 4,1 span 3 icon "plus" on click: newClassClicked
        tree name modelTree at 1,2 span 6 rows 15 bind nodes key key parent parent show label on select: nodePicked
        button @deleteCaption name deleteButton at 4,17 span 3 icon "trash" on click: deleteClicked
    footer
        status @workspaceStatus

// A class: its name, what it is, and its properties in order.
page ClassEditor: view
    data editedClass: ModelClass
    data properties: list<Property>

    label @classNameCaption name classNameLabel at 1,1 span 2 for classNameBox
    textbox name classNameBox at 3,1 span 4 bind editedClass.name
    label @classSummaryCaption name classSummaryLabel at 1,2 span 2 for classSummaryBox
    memo name classSummaryBox at 3,2 span 4 rows 2 bind editedClass.summary
    heading @propertiesHeading name propertiesHeading at 1,4 span 6
    table name propertyTable at 1,5 span 6 rows 7 bind properties columns name 180, type 160, optional edit name, type, optional reorder by position add remove confirm on add: addPropertyClicked on remove: removePropertyClicked on change: propertyChanged on reorder: propertiesMoved
    button @saveClassCaption name saveClassButton at 5,13 span 2 default on click: saveClassClicked

// The diagrams of a domain: its classes with their properties and lines, or
// the tables the adapter keeps them in, with their keys.
page DiagramCanvas: view
    data kind: DiagramKind
    data classes: list<ModelClass>
    data members: list<Property>

    radio name diagramKindRadio at 1,1 span 6 bind kind horizontal
    canvas name diagramCanvas at 1,2 span 12 rows 8 units 1600 x 600 zoom grid 20 snap background panel mode objects classes at x, y on draw: drawDiagram on change: classMoved

code Workspace
    handler workspaceOpened
        refreshTree()
        showDomain()

    handler refreshTree
        let domains = find d in Domain order by d.name
        let allClasses = find c in ModelClass order by c.name
        nodes = outline(domains, allClasses)

    // Picks the row of that key in the tree, which opens the rows above it.
    handler pickNode(key: text)
        for n in nodes
            if n.key == key
                modelTree.selected = n

    // The middle shows the domain picked, or says to pick one.
    handler showDomain
        let picked = domain.id != 0
        pickADomain.visible = not picked
        domainNameBox.enabled = picked
        domainSummaryBox.enabled = picked
        saveDomainButton.enabled = picked
        newClassButton.enabled = picked

    handler nodePicked
        let node = modelTree.selected
        if node.key == ""
            return
        let chosen = node.domain
        domain = chosen
        loadDiagram()
        showDomain()
        if node.kind == "class"
            let found = node.model
            editedClass = found
            properties = find p in Property where p.owner == editedClass order by p.position
            classPanel.visible = true

    // The diagram view shows the classes of the domain picked; it draws the properties of those.
    handler loadDiagram
        classes = find c in ModelClass where c.domain == domain order by c.name
        members = find p in Property order by p.position

    handler newDomainClicked
        let d = new Domain
        d.name = new_name("Domain", find x in Domain order by x.name)
        save d
        domain = d
        refreshTree()
        pickNode("d{d.id}")
        loadDiagram()
        showDomain()

    handler newClassClicked
        if domain.id == 0
            return
        let existing = find c in ModelClass where c.domain == domain order by c.name
        let c = new ModelClass
        let next = count(existing) + 1
        c.domain = domain
        c.name = "Class{next}"
        c.x = 40 + 320 * column_of(count(existing))
        c.y = 40 + 300 * row_of(count(existing))
        save c
        editedClass = c
        properties = find p in Property where p.owner == c order by p.position
        refreshTree()
        pickNode("c{c.id}")
        loadDiagram()
        classPanel.visible = true

    handler saveDomainClicked
        save domain
        refreshTree()

    // Deletes the domain or class picked in the tree, after asking.
    handler deleteClicked
        let node = modelTree.selected
        if node.key == ""
            return
        ask @deleteNode(name = node.label) yes @delete no @keep then deleteConfirmed

    handler deleteConfirmed
        let node = modelTree.selected
        if node.kind == "class"
            let gone = node.model
            delete gone
            classPanel.visible = false
        else
            let gone = node.domain
            delete gone
            domain = new Domain
            classPanel.visible = false
        refreshTree()
        loadDiagram()
        showDomain()

    // What the class editor saved shows in the tree and on the diagram once it slides away.
    handler classPanelClosed
        refreshTree()
        loadDiagram()

code ClassEditor
    handler addPropertyClicked
        if editedClass.id == 0
            save editedClass
        let p = new Property
        p.owner = editedClass
        let next = count(properties) + 1
        p.position = next
        p.name = "property{next}"
        p.type = "string"
        save p
        properties = find x in Property where x.owner == editedClass order by x.position

    handler removePropertyClicked
        delete propertyTable.selected
        properties = find x in Property where x.owner == editedClass order by x.position

    handler propertyChanged
        save propertyTable.selected

    handler propertiesMoved
        for p in properties
            save p

    handler saveClassClicked
        save editedClass

code DiagramCanvas
    handler drawDiagram
        diagramCanvas.clear()
        if kind == DiagramKind.Erd
            drawErd()
        else
            drawClasses()

    // The class diagram: a box per class with its properties, and a line to
    // each class a property's type names.
    handler drawClasses
        for c in classes
            for p in members
                if p.owner.id == c.id
                    for target in classes
                        if refers_to(p.type, target.name)
                            diagramCanvas.line(c.x + 130, c.y + 20, target.x + 130, target.y + 20, "muted", 2)
        for c in classes
            let lines: list<text> = []
            for p in members
                if p.owner.id == c.id
                    lines = lines + [property_line(p.name, p.type, p.optional)]
            drawBox(c, c.name, lines, "accent")

    // The ERD: a table per class as the adapter keeps it, its business key
    // first, a foreign key for each class a property names, and its two
    // moments; a line to each table a foreign key points at.
    handler drawErd
        for c in classes
            for p in members
                if p.owner.id == c.id
                    for target in classes
                        if refers_to(p.type, target.name)
                            diagramCanvas.line(c.x + 130, c.y + 20, target.x + 130, target.y + 20, "muted", 2)
        for c in classes
            let lines: list<text> = ["PK  Bk"]
            for p in members
                if p.owner.id == c.id
                    lines = lines + [column_line(p.name, p.type, class_names(classes))]
            lines = lines + ["    LastModified", "    LastProcessed"]
            drawBox(c, c.name, lines, "success")

    handler drawBox(c: ModelClass, title: text, lines: list<text>, edge: text)
        let h = 40 + 22 * count(lines)
        diagramCanvas.object(c, c.x, c.y, 260, h)
        diagramCanvas.rect(c.x - 2, c.y - 2, 264, h + 4, edge)
        diagramCanvas.rect(c.x, c.y, 260, h, "raised")
        diagramCanvas.rect(c.x, c.y, 260, 32, "accent_soft")
        diagramCanvas.text(c.x + 130, c.y + 16, title, "text", 13, "center", "bold")
        let row = c.y + 50
        for line in lines
            diagramCanvas.text(c.x + 12, row, line, "text", 11, "left", "mono")
            row = row + 22

    handler classMoved
        save diagramCanvas.selected

// The tree's rows: each domain, and its classes under it.
function outline(domains: list<Domain>, classes: list<ModelClass>) -> list<Node>
    let all: list<Node> = []
    for d in domains
        let n = new Node
        n.key = "d{d.id}"
        n.label = d.name
        n.kind = "domain"
        n.domain = d
        all = all + [n]
        for c in classes
            if c.domain.id == d.id
                let m = new Node
                m.key = "c{c.id}"
                m.parent = "d{d.id}"
                m.label = c.name
                m.kind = "class"
                m.domain = d
                m.model = c
                all = all + [m]
    return all

// A name not taken yet: the word, or the word with the first number free.
function new_name(word: text, domains: list<Domain>) -> text
    let name = word
    let n = 1
    for step in 1 to 1000
        let taken = false
        for d in domains
            if d.name == name
                taken = true
        if not taken
            return name
        n = n + 1
        name = "{word}{n}"
    return name

// Whether a property's type names the class: the class itself or a list of it.
function refers_to(type: text, name: text) -> bool
    return type == name or type == "list<{name}>"

function class_names(classes: list<ModelClass>) -> list<text>
    let names: list<text> = []
    for c in classes
        names = names + [c.name]
    return names

// A line of a class box: its name and type, a question mark when it may be empty.
function property_line(name: text, type: text, optional: bool) -> text
    if optional
        return "{name}: {type}?"
    return "{name}: {type}"

// A column of a table: a foreign key for a class, the property itself otherwise.
function column_line(name: text, type: text, classes: list<text>) -> text
    for c in classes
        if type == c
            return "FK  {name}Bk"
    return "    {name}"

// Where the n-th box of a domain goes, from 0: five to a row.
function column_of(n: integer) -> integer
    let left = n
    for step in 1 to 1000
        if left >= 5
            left = left - 5
    return left

function row_of(n: integer) -> integer
    let left = n
    let row = 0
    for step in 1 to 1000
        if left >= 5
            left = left - 5
            row = row + 1
    return row
