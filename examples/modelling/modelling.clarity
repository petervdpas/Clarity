module modelling

use model

// What each person sets for themselves, kept on their machine.
settings
    language
    theme
    // The folder of the adapter-fcdmapi repository, whose DbContext and mappers name the tables.
    adapterFolder: folder, label @adapterFolderLabel

app Modelling
    title @modellingTitle
    main Workspace
    menu name mainMenu
        item @viewMenu name viewMenu
            item @languageCaption name languageItem on click -> language
            item @themeCaption name themeItem on click -> theme

// Writes the C# of the data objects and enums as the fcdm repository has
// it; its source is in engines/fcdm.
engine Fcdm from "fcdm.wasm"
    function classCode(object: ObjectSpec, properties: list<PropertySpec>) -> text
    function interfaceCode(object: ObjectSpec, properties: list<PropertySpec>) -> text
    function enumCode(spec: EnumSpec, values: list<EnumValueSpec>) -> text
    function eventCode(spec: EventSpec, fields: list<EventFieldSpec>) -> text
    function arrangeBoxes(boxes: list<LayoutBox>, links: list<LayoutLink>, grid: integer, width: integer) -> list<LayoutBox>
    function routeLinks(boxes: list<LayoutBox>, links: list<LayoutLink>, grid: integer, width: integer) -> list<LayoutLink>

// A data object and the number of one of its versions, as an editor picks them.
record VersionPick
    object: ref DataObject
    number: integer

// The API version a table gets a view in, as its editor picks it.
record ApiPick
    api: ref ApiVersion

// A table filled from a class definition of a data object, for its tables
// tab: the class version, the table, and the API versions with a view on it.
record ApiUse
    version: integer
    table: text
    apis: text

// A box the engine arranges: its id, its size, and where it puts it.
record LayoutBox
    id: integer
    width: integer
    height: integer
    x: integer
    y: integer

// A line between two boxes the engine arranges, by their ids: its
// property (key), and the bend points the engine routes it through.
record LayoutLink
    from: integer
    to: integer
    key: integer
    via: list<integer>

// A box on the diagrams: a data object's or an enum's, where it stands.
record DiagramBox
    // Different for each box: a data object's id, an enum's from 1000000.
    id: integer
    key: text
    x: integer
    y: integer
    dataObject: ref DataObject
    enumType: ref EnumType

// An event, as the engine writes it.
record EventSpec
    domain: text
    name: text
    version: integer
    namespace: text
    kind: text
    base: bool
    typeName: text
    typeVersion: integer
    obsolete: text

// A field of an event, as the engine writes it.
record EventFieldSpec
    name: text
    kind: PropertyKind
    nullable: bool
    typeName: text
    typeVersion: integer
    list: text
    access: text
    obsolete: text

// A version of a data object, as the engine writes it.
record ObjectSpec
    domain: text
    name: text
    root: bool
    keyed: bool
    newtonsoft: bool
    version: integer
    summary: text
    obsolete: text

// A property, as the engine writes it: the version of a held object is the
// newest up to the version it is in.
record PropertySpec
    name: text
    kind: PropertyKind
    nullable: bool
    typeName: text
    typeVersion: integer
    initial: text
    computed: text
    obsolete: text

record EnumSpec
    domain: text
    name: text

record EnumValueSpec
    name: text
    number: integer

// What is picked in the tree: its kind, what it says, and the records it is about.
record Picked
    kind: text
    label: text
    project: ref Project
    domain: ref Domain
    dataObject: ref DataObject
    version: ref ClassDefinition
    enumType: ref EnumType
    eventType: ref EventDefinition
    adapterTable: ref AdapterTable
    view: ref ApiView
    apiVersion: ref ApiVersion

// What the diagram view draws of the domain.
enum DiagramKind
    ClassDiagram label @diagramKindClass
    Erd label @diagramKindErd

code Workspace
    handler workspaceOpened
        showDomain()
        loadDiagram()

    handler refreshTree
        modelTree.reload()

    // What the buttons can do with the domain picked.
    handler showDomain
        let has = domain.id != 0
        newObjectButton.enabled = has
        newEnumButton.enabled = has
        newEventButton.enabled = has

    // What is picked: its kind and what it says, in the project and domain it stands in.
    handler pick(kind: text, label: text, pr: Project, d: Domain)
        chosen = new Picked
        chosen.kind = kind
        chosen.label = label
        chosen.project = pr
        project = pr
        domain = d
        showDomain()
        main.swap(StartView)
        if d.id != 0
            chosen.domain = d
            main.swap(DomainEditor)
        loadDiagram()

    handler projectPicked(p: Project)
        pick("project", p.name, p, new Domain)
        editedProject = p
        main.swap(ProjectEditor)

    handler domainPicked(d: Domain)
        let pr = d.project
        pick("domain", d.name, pr, d)

    // A data object opens at its newest class definition, when it has one.
    handler objectPicked(o: DataObject)
        let d = o.domain
        let pr = d.project
        pick("object", o.name, pr, d)
        chosen.dataObject = o
        let all = find v in ClassDefinition where v.owner == o order by v.number
        if count(all) > 0
            openVersion(all[count(all)])

    handler classPicked(v: ClassDefinition)
        let o = v.owner
        let d = o.domain
        let pr = d.project
        pick("version", versionTitle(o.name, v.number), pr, d)
        chosen.dataObject = o
        chosen.version = v
        openVersion(v)

    handler eventPicked(e: EventDefinition)
        let o = e.owner
        let d = o.domain
        let pr = d.project
        pick("event", e.name, pr, d)
        chosen.dataObject = o
        chosen.eventType = e
        openEvent(e)

    handler tablePicked(t: AdapterTable)
        let o = t.owner
        let d = o.domain
        let pr = d.project
        pick("table", t.name, pr, d)
        chosen.dataObject = o
        chosen.adapterTable = t
        openTable(t)

    handler apiViewPicked(w: ApiView)
        let t = w.adapterTable
        let o = t.owner
        let d = o.domain
        let pr = d.project
        pick("view", w.entity, pr, d)
        chosen.dataObject = o
        chosen.view = w
        openTable(t)

    handler enumPicked(e: EnumType)
        let d = e.domain
        let pr = d.project
        pick("enum", e.name, pr, d)
        chosen.enumType = e
        openEnum(e)

    handler apiPicked(a: ApiVersion)
        let pr = a.project
        pick("api", a.version, pr, new Domain)
        chosen.apiVersion = a
        openApi(a)

    // The object editor shows a version of a data object, its properties and its C#.
    handler openVersion(v: ClassDefinition)
        editedVersion = v
        let owner = v.owner
        editedObject = owner
        properties = find p in Property where p.owner == v order by p.position
        picked = new Property
        classText = classText(editedObject, editedVersion, properties)
        interfaceText = interfaceText(editedObject, editedVersion, properties)
        apiUses = apiUsesOf(owner)
        main.swap(ObjectEditor)

    handler openEnum(e: EnumType)
        editedEnum = e
        values = find x in EnumValue where x.owner == e order by x.position
        enumText = enumText(e, values)
        main.swap(EnumEditor)

    // The event editor shows an event: what it carries or its fields, and its C#.
    handler openEvent(e: EventDefinition)
        editedEvent = e
        fields = find f in EventField where f.owner == e order by f.position
        pickedField = new EventField
        heldPick = new VersionPick
        heldPick.number = 1
        carriedPick = new VersionPick
        carriedPick.number = 1
        if e.carries != none
            let v = e.carries
            carriedPick.object = v.owner
            carriedPick.number = v.number
        eventText = eventText(e, fields)
        // A base event carries a data object; any other has fields.
        carriesPanel.visible = e.base
        fieldsPanel.visible = not e.base
        main.swap(EventEditor)

    // The API editor shows a version of the API, its views and its JSON.
    handler openApi(v: ApiVersion)
        editedApi = v
        apiViews = find x in ApiView where x.api == v order by x.position
        jsonText = apiJsonOf(v)
        main.swap(ApiEditor)

    // The table editor shows a table of the adapter, its columns and its views.
    handler openTable(t: AdapterTable)
        editedTable = t
        columns = find x in AdapterColumn where x.owner == t order by x.position
        blueprintPick = new VersionPick
        blueprintPick.number = 1
        if t.blueprint != none
            let b = t.blueprint
            blueprintPick.object = b.owner
            blueprintPick.number = b.number
        tableViews = find x in ApiView where x.adapterTable == t order by x.position
        pickedView = new ApiView
        addTo = new ApiPick
        rolesText = ""
        relations = []
        apiEnums = []
        main.swap(TableEditor)

    // A new API version of the project picked starts as a copy of its newest: its views with their relations and enum columns.
    handler newApiClicked
        if project.id == 0
            return
        let all = find x in ApiVersion where x.project == project order by x.major
        let v = new ApiVersion
        v.project = project
        v.major = 1
        if count(all) > 0
            v.major = all[count(all)].major + 1
        v.version = "{v.major}.0"
        save v
        if count(all) > 0
            copyApi(all[count(all)], v)
        refreshTree()
        openApi(v)

    handler apiSaved
        refreshTree()
        loadDiagram()

    // The diagram view shows the domain's data objects as they are in the version chosen.
    handler loadDiagram
        let versions = find v in ClassDefinition order by v.number
        let objects = find o in DataObject where o.domain == domain order by o.name
        // The dial goes up to the domain's newest version, and no further.
        let top = 1
        for v in versions
            for o in objects
                if v.owner.id == o.id and v.number > top
                    top = v.number
        levelBox.max = top
        if level > top
            level = top
        shown = asIn(objects, versions, level)
        boxes = diagramBoxes(objects, find e in EnumType where e.domain == domain order by e.name)
        enumValues = find x in EnumValue order by x.position
        members = find p in Property order by p.position
        erdTables = find t in AdapterTable order by t.name
        currentDomain = domain

    // A new project, empty.
    handler newProjectClicked
        let all = find x in Project order by x.name
        let pr = new Project
        let next = count(all) + 1
        pr.name = "Project{next}"
        save pr
        project = pr
        domain = new Domain
        refreshTree()
        showDomain()
        editedProject = pr
        main.swap(ProjectEditor)

    // A new domain of the project picked.
    handler newDomainClicked
        if project.id == 0
            return
        let d = new Domain
        d.project = project
        d.name = freeDomainName(@newDomainName, find x in Domain where x.project == project order by x.name)
        save d
        domain = d
        refreshTree()
        loadDiagram()
        showDomain()

    // A new data object starts with its first version, empty.
    handler newObjectClicked
        if domain.id == 0
            return
        let existing = find o in DataObject where o.domain == domain order by o.name
        let o = new DataObject
        let next = count(existing) + 1
        o.domain = domain
        o.name = "Object{next}"
        o.x = 40 + 320 * columnOf(count(existing))
        o.y = 40 + 300 * rowOf(count(existing))
        save o
        let v = new ClassDefinition
        v.owner = o
        v.number = 1
        save v
        refreshTree()
        loadDiagram()
        openVersion(v)

    handler newEnumClicked
        if domain.id == 0
            return
        let e = new EnumType
        e.domain = domain
        e.name = @newEnumName
        save e
        refreshTree()
        openEnum(e)

    // A new event of the data object picked starts as a base Changed event in its newest event version.
    handler newEventClicked
        if chosen.dataObject == none
            return
        let o = chosen.dataObject
        let highest = 1
        for x in find x in EventDefinition where x.owner == o
            if x.number > highest
                highest = x.number
        let dom = o.domain
        let e = new EventDefinition
        e.owner = o
        e.name = @newEventName
        e.number = highest
        e.namespace = folderNamespace(dom.name, highest)
        e.kind = EventKind.Changed
        e.base = true
        save e
        refreshTree()
        openEvent(e)

    // A new table of the adapter for the data object picked.
    handler newTableClicked
        if chosen.dataObject == none
            return
        let o = chosen.dataObject
        let t = new AdapterTable
        t.owner = o
        t.name = @newTableName
        t.className = o.name
        save t
        refreshTree()
        openTable(t)

    handler domainSaved
        refreshTree()

    handler projectSaved
        refreshTree()

    // Deletes what is picked in the tree, after asking.
    handler deleteClicked
        if chosen.kind == ""
            return
        ask @deleteNode(name = chosen.label) yes @delete no @keep then deleteConfirmed

    handler deleteConfirmed
        let node = chosen
        if node.kind == "object"
            let gone = node.dataObject
            delete gone
        else if node.kind == "version"
            let gone = node.version
            delete gone
        else if node.kind == "enum"
            let gone = node.enumType
            delete gone
            main.swap(StartView)
        else if node.kind == "event"
            let gone = node.eventType
            delete gone
            main.swap(StartView)
        else if node.kind == "api"
            let gone = node.apiVersion
            delete gone
            main.swap(StartView)
        else if node.kind == "table"
            let gone = node.adapterTable
            delete gone
            main.swap(StartView)
        else if node.kind == "view"
            let gone = node.view
            delete gone
            main.swap(StartView)
        else if node.kind == "project"
            let gone = node.project
            delete gone
            project = new Project
            domain = new Domain
        else
            let gone = node.domain
            delete gone
            domain = new Domain
        chosen = new Picked
        main.swap(StartView)
        refreshTree()
        loadDiagram()
        showDomain()

    // What the editors saved shows in the tree and on the diagram at once.
    handler objectSaved
        refreshTree()
        loadDiagram()

    handler enumSaved
        refreshTree()

    handler eventSaved
        refreshTree()

    handler tableSaved
        refreshTree()

code DomainEditor
    handler saveDomainClicked
        save domain
        tell saved()

code ProjectEditor
    handler saveProjectClicked
        save editedProject
        tell saved()

code ObjectEditor
    handler showCode
        classText = classText(editedObject, editedVersion, properties)
        interfaceText = interfaceText(editedObject, editedVersion, properties)

    handler reloadProperties
        properties = find x in Property where x.owner == editedVersion order by x.position
        showCode()

    handler addPropertyClicked
        if editedVersion.id == 0
            return
        let p = new Property
        p.owner = editedVersion
        let next = count(properties) + 1
        p.position = next
        p.name = "Property{next}"
        save p
        reloadProperties()

    handler removePropertyClicked
        delete propertyTable.selected
        picked = new Property
        reloadProperties()

    handler propertyChanged
        save propertyTable.selected
        showCode()

    handler propertiesMoved
        for p in properties
            save p
        showCode()

    // The details below the table are the property picked.
    handler propertyPicked
        let p = propertyTable.selected
        picked = p

    handler pickedChanged
        if picked.id == 0
            return
        save picked
        reloadProperties()

    // A new version starts as a copy of the one shown, numbered after the newest.
    handler newVersionClicked
        if editedVersion.id == 0
            return
        let all = find v in ClassDefinition where v.owner == editedObject order by v.number
        let v = new ClassDefinition
        v.owner = editedObject
        v.number = all[count(all)].number + 1
        save v
        for p in properties
            let copy = new Property
            copy.owner = v
            copy.position = p.position
            copy.name = p.name
            copy.kind = p.kind
            copy.nullable = p.nullable
            copy.choice = p.choice
            copy.target = p.target
            copy.initial = p.initial
            copy.computed = p.computed
            copy.obsolete = p.obsolete
            save copy
        editedVersion = v
        reloadProperties()
        tell saved()

    handler saveObjectClicked
        save editedObject
        save editedVersion
        showCode()
        tell saved()

code EnumEditor
    handler reloadValues
        values = find x in EnumValue where x.owner == editedEnum order by x.position
        enumText = enumText(editedEnum, values)

    handler addValueClicked
        if editedEnum.id == 0
            return
        let v = new EnumValue
        v.owner = editedEnum
        v.position = count(values) + 1
        v.number = count(values)
        let next = count(values) + 1
        v.name = "VALUE{next}"
        save v
        reloadValues()

    handler removeValueClicked
        delete valueTable.selected
        reloadValues()

    handler valueChanged
        save valueTable.selected
        reloadValues()

    handler valuesMoved
        for v in values
            save v
        reloadValues()

    handler saveEnumClicked
        save editedEnum
        reloadValues()
        tell saved()

code EventEditor
    handler showEventCode
        eventText = eventText(editedEvent, fields)

    // A base event carries a data object; any other has fields.
    handler eventShapeChanged
        carriesPanel.visible = editedEvent.base
        fieldsPanel.visible = not editedEvent.base
        showEventCode()

    // The data object and its version picked: the version it carries, when there is one.
    handler carriedChanged
        let v = versionOf(carriedPick.object, carriedPick.number)
        carriedNumberBox.error = ""
        if v.id != 0
            editedEvent.carries = v
        else
            editedEvent.carries = none
            if carriedPick.object != none
                carriedNumberBox.error = @noSuchVersion(number = carriedPick.number)
        showEventCode()

    handler reloadFields
        fields = find f in EventField where f.owner == editedEvent order by f.position
        showEventCode()

    handler addFieldClicked
        let f = new EventField
        f.owner = editedEvent
        f.position = count(fields) + 1
        f.name = @newFieldName
        f.kind = TextValue
        save f
        reloadFields()

    handler removeFieldClicked
        delete fieldTable.selected
        reloadFields()

    handler fieldChanged
        save fieldTable.selected
        reloadFields()

    handler fieldsMoved
        for f in fields
            save f
        reloadFields()

    handler fieldPicked
        pickedField = fieldTable.selected
        heldPick = new VersionPick
        heldPick.number = 1
        if pickedField.holds != none
            let v = pickedField.holds
            heldPick.object = v.owner
            heldPick.number = v.number

    handler heldChanged
        if pickedField.id == 0
            return
        let v = versionOf(heldPick.object, heldPick.number)
        heldNumberBox.error = ""
        if v.id != 0
            pickedField.holds = v
            save pickedField
            reloadFields()
        else if heldPick.object != none
            heldNumberBox.error = @noSuchVersion(number = heldPick.number)

    handler pickedFieldChanged
        if pickedField.id == 0
            return
        save pickedField
        reloadFields()

    // Looked at: the event no longer asks for a review.
    handler eventReviewedClicked
        editedEvent.review = ""
        save editedEvent
        tell saved()

    handler saveEventClicked
        save editedEvent
        showEventCode()
        tell saved()

code ApiEditor
    handler showJson
        jsonText = apiJsonOf(editedApi)

    handler saveApiClicked
        save editedApi
        showJson()
        tell saved()

    handler reloadApiViews
        apiViews = find x in ApiView where x.api == editedApi order by x.position
        showJson()

    handler removeApiViewClicked
        delete apiViewTable.selected
        reloadApiViews()
        tell saved()

    handler apiViewsMoved
        for w in apiViews
            save w
        showJson()

    // Writes FcdmApi-vN.json where the adapter's generator reads it.
    handler writeApiClicked
        if editedApi.id == 0
            return
        writeApi(editedApi)
        message @apiWritten(path = apiPath(editedApi.major))

code TableEditor
    handler reloadColumns
        columns = find x in AdapterColumn where x.owner == editedTable order by x.position

    handler addColumnClicked
        if editedTable.id == 0
            return
        let c = new AdapterColumn
        c.owner = editedTable
        let next = count(columns) + 1
        c.position = next
        c.name = "Column{next}"
        save c
        reloadColumns()

    handler removeColumnClicked
        delete columnTable.selected
        reloadColumns()

    handler columnChanged
        save columnTable.selected

    handler columnsMoved
        for c in columns
            save c

    // The data object and its version picked: the class definition the table is filled from.
    handler blueprintChanged
        if editedTable.id == 0
            return
        blueprintNumberBox.error = ""
        let v = versionOf(blueprintPick.object, blueprintPick.number)
        if v.id == 0
            if blueprintPick.object != none
                blueprintNumberBox.error = @noSuchVersion(number = blueprintPick.number)
                return
            editedTable.blueprint = none
        else
            editedTable.blueprint = v
        save editedTable
        tell saved()

    handler saveTableClicked
        save editedTable
        tell saved()

    handler reloadTableViews
        tableViews = find x in ApiView where x.adapterTable == editedTable order by x.position

    // A view of this table in the API version picked, at the end of its views, named as the table's class.
    handler addViewClicked
        if editedTable.id == 0 or addTo.api == none
            return
        let a = addTo.api
        let there = find x in ApiView where x.api == a order by x.position
        for x in there
            if x.adapterTable.id == editedTable.id
                message @viewThere(api = a.version)
                return
        let w = new ApiView
        w.api = a
        w.adapterTable = editedTable
        w.position = count(there) + 1
        w.entity = editedTable.className
        w.className = editedTable.className
        w.propertyName = editedTable.className
        w.propertyPluralName = editedTable.name
        save w
        reloadTableViews()
        tell saved()

    handler removeTableViewClicked
        delete tableViewTable.selected
        pickedView = new ApiView
        rolesText = ""
        relations = []
        apiEnums = []
        reloadTableViews()
        tell saved()

    // The details below, and the relations and enum columns, are the view picked.
    handler viewPicked
        let w = tableViewTable.selected
        pickedView = w
        rolesText = join(w.roles, ", ")
        relations = find x in ApiRelation where x.owner == w order by x.position
        apiEnums = find x in ApiEnum where x.owner == w order by x.position

    // The roles are typed apart by commas.
    handler rolesChanged
        if pickedView.id == 0
            return
        let roles: list<text> = []
        for r in split(rolesText, ",")
            if trim(r) != ""
                roles = roles + [trim(r)]
        pickedView.roles = roles
        save pickedView

    handler pickedViewChanged
        if pickedView.id == 0
            return
        save pickedView
        reloadTableViews()
        tell saved()

    handler reloadRelations
        relations = find x in ApiRelation where x.owner == pickedView order by x.position
        apiEnums = find x in ApiEnum where x.owner == pickedView order by x.position

    handler addRelationClicked
        if pickedView.id == 0
            return
        let r = new ApiRelation
        r.owner = pickedView
        r.position = count(relations) + 1
        r.foreignEntity = @newForeignEntity
        save r
        reloadRelations()

    handler removeRelationClicked
        delete relationTable.selected
        reloadRelations()

    handler relationChanged
        save relationTable.selected

    handler relationsMoved
        for r in relations
            save r

    handler addApiEnumClicked
        if pickedView.id == 0
            return
        let n = new ApiEnum
        n.owner = pickedView
        n.position = count(apiEnums) + 1
        n.propertyName = @newEnumColumn
        save n
        reloadRelations()

    handler removeApiEnumClicked
        delete apiEnumTable.selected
        reloadRelations()

    handler apiEnumChanged
        save apiEnumTable.selected

    handler apiEnumsMoved
        for n in apiEnums
            save n

code DiagramCanvas
    handler levelPicked
        tell levelChanged()

    // The next click on the paper places a new data object there.
    handler newObjectToolClicked
        adding = true
        diagramCanvas.tool = "select"

    // The tools a kind of diagram has: the ERD shows the adapter's tables, so no new data object is placed there.
    handler kindPicked
        newObjectTool.visible = kind != DiagramKind.Erd
        adding = false

    // A line drawn from one box to another: on the class diagram the data
    // object it starts at holds the other (or takes the enum it ends at),
    // on the ERD it names the other's business key. It is a new property of
    // the version shown, at the end of its properties.
    handler linesDrawn
        let laid = laidOutBoxes(boxes, shown, members, enumValues, erdTables, kind == DiagramKind.Erd)
        let fromId = boxAt(laid, diagramCanvas.fromX, diagramCanvas.fromY)
        let toId = boxAt(laid, diagramCanvas.x, diagramCanvas.y)
        if fromId == 0 or toId == 0 or fromId == toId
            return
        for v in shown
            if v.owner.id == fromId
                let p = new Property
                p.owner = v
                let last = 0
                for m in members
                    if m.owner.id == v.id and m.position > last
                        last = m.position
                p.position = last + 1
                if toId >= 1000000 and toId < 2000000 and kind != DiagramKind.Erd
                    for b in boxes
                        if b.id == toId
                            let e = b.enumType
                            p.kind = EnumChoice
                            p.choice = e
                            p.name = e.name
                            save p
                if toId < 1000000
                    for b in boxes
                        if b.id == toId
                            let target = b.dataObject
                            p.target = target
                            if kind == DiagramKind.Erd
                                p.kind = BusinessKey
                                p.name = "{target.name}Bk"
                            else
                                p.kind = HeldObject
                                p.name = target.name
                            save p
        tell added()

    // With the new data object tool pressed, a click on the paper places one there, with its first version.
    handler paperClicked
        if not adding or currentDomain.id == 0
            return
        adding = false
        let existing = find o in DataObject where o.domain == currentDomain order by o.name
        let next = count(existing) + 1
        let base = @newObjectName
        let o = new DataObject
        o.domain = currentDomain
        o.name = "{base}{next}"
        o.x = snapped(diagramCanvas.x, 20)
        o.y = snapped(diagramCanvas.y, 20)
        save o
        let v = new ClassDefinition
        v.owner = o
        v.number = 1
        save v
        tell added()

    // Places the boxes of the diagram shown by their links (the engine
    // arranges them in rows, a box above what it links to), keeps where
    // they stand, and has the window load them there.
    handler arrangeClicked
        let erd = kind == DiagramKind.Erd
        let wanted = laidOutBoxes(boxes, shown, members, enumValues, erdTables, erd)
        let links: list<LayoutLink> = []
        for v in shown
            for p in members
                if p.owner.id == v.id and p.target != none and (not erd or p.kind == BusinessKey)
                    let link = new LayoutLink
                    link.from = v.owner.id
                    link.to = p.target.id
                    link.key = p.id
                    links = links + [link]
                if p.owner.id == v.id and p.kind == EnumChoice and p.choice != none and not erd
                    let link = new LayoutLink
                    link.from = v.owner.id
                    link.to = 1000000 + p.choice.id
                    link.key = p.id
                    links = links + [link]
        // Each line keeps the bend points it is routed through, around the boxes between.
        for routed in Fcdm.routeLinks(wanted, links, 20, 4000)
            for p in members
                if p.id == routed.key
                    p.via = routed.via
                    save p
        for spot in Fcdm.arrangeBoxes(wanted, links, 20, 4000)
            for b in boxes
                if b.id == spot.id
                    if b.dataObject != none
                        let o = b.dataObject
                        o.x = spot.x
                        o.y = spot.y
                        save o
                    if b.enumType != none
                        let e = b.enumType
                        e.x = spot.x
                        e.y = spot.y
                        save e
        tell arranged()

    handler drawDiagram
        diagramCanvas.clear()
        if kind == DiagramKind.Erd
            drawErd()
        else
            drawClasses()

    // The class diagram: a box per data object with its properties, a line to
    // each object it holds, a dashed one to each it names by business key.
    handler drawClasses
        for v in shown
            let o = v.owner
            let ownLines = classLines(v, members)
            let ow = boxWidth(versionTitle(o.name, v.number), ownLines)
            let oh = 40 + 22 * count(ownLines)
            for p in members
                if p.owner.id == v.id and p.target != none
                    for target in shown
                        if p.target.id == target.owner.id
                            let t = target.owner
                            let theirLines = classLines(target, members)
                            let tw = boxWidth(versionTitle(t.name, target.number), theirLines)
                            let th = 40 + 22 * count(theirLines)
                            // From the edge of one box that faces the other to the other's facing edge.
                            let e = lineEnds(o.x, o.y, ow, oh, t.x, t.y, tw, th)
                            if p.kind == BusinessKey
                                diagramCanvas.link("p{p.id}", e[1], e[2], e[3], e[4], p.via, "muted", 2, "", "arrow", "", "dashed")
                            else if p.kind == HeldObjects
                                diagramCanvas.link("p{p.id}", e[1], e[2], e[3], e[4], p.via, "muted", 2, "filledDiamond", "many")
                            else if p.kind == HeldObject
                                diagramCanvas.link("p{p.id}", e[1], e[2], e[3], e[4], p.via, "muted", 2, "filledDiamond", "one")
                // A dashed line to the enum it takes, as the class holds it.
                if p.owner.id == v.id and p.kind == EnumChoice and p.choice != none
                    for b in boxes
                        if b.enumType != none and b.enumType.id == p.choice.id
                            let en = b.enumType
                            let valueLines = enumLines(en, enumValues)
                            let e = lineEnds(o.x, o.y, ow, oh, b.x, b.y, boxWidth(en.name, valueLines), 40 + 22 * count(valueLines))
                            diagramCanvas.link("p{p.id}", e[1], e[2], e[3], e[4], p.via, "muted", 2, "", "arrow", "", "dashed")
        for v in shown
            drawBox(boxFor(boxes, v.owner), versionTitle(v.owner.name, v.number), classLines(v, members), "accent")
        for b in boxes
            if b.enumType != none
                let e = b.enumType
                drawBox(b, e.name, enumLines(e, enumValues), "warning")

    // The ERD: a table per data object as the newest API version serving it names it, its business
    // key first, its values, and its two moments; a line to each table a
    // business key points at.
    handler drawErd
        for v in shown
            let fromTable = tableTitle(v, erdTables)
            let ownLines = erdLines(v, members)
            let o = v.owner
            for p in members
                if p.owner.id == v.id and p.kind == BusinessKey and p.target != none and fromTable != ""
                    for target in shown
                        let toTable = tableTitle(target, erdTables)
                        // Only between tables the adapter has.
                        if p.target.id == target.owner.id and toTable != ""
                            let t = target.owner
                            let theirLines = erdLines(target, members)
                            let e = lineEnds(o.x, o.y, boxWidth(fromTable, ownLines), 40 + 22 * count(ownLines), t.x, t.y, boxWidth(toTable, theirLines), 40 + 22 * count(theirLines))
                            diagramCanvas.link("p{p.id}", e[1], e[2], e[3], e[4], p.via, "muted", 2, "many", "one")
        // A data object the adapter keeps in no table is not on the ERD.
        for v in shown
            let title = tableTitle(v, erdTables)
            if title != ""
                drawBox(boxFor(boxes, v.owner), title, erdLines(v, members), "success")

    // A box as wide as its title and its longest line ask.
    handler drawBox(o: DiagramBox, title: text, lines: list<text>, edge: text)
        let w = boxWidth(title, lines)
        let h = 40 + 22 * count(lines)
        diagramCanvas.object(o, o.x, o.y, w, h)
        diagramCanvas.rect(o.x - 2, o.y - 2, w + 4, h + 4, edge)
        diagramCanvas.rect(o.x, o.y, w, h, "raised")
        diagramCanvas.rect(o.x, o.y, w, 32, "accent_soft")
        diagramCanvas.text(o.x + w / 2, o.y + 16, title, "text", 13, "center", "bold")
        // Its rows, every other one on a stripe so the eye keeps the line.
        let row = o.y + 50
        let striped = false
        for line in lines
            if striped
                diagramCanvas.rect(o.x + 1, row - 11, w - 2, 22, "accent_soft")
            diagramCanvas.text(o.x + 12, row, line, "text", 11, "left", "mono")
            row = row + 22
            striped = not striped

    // A box moved: its data object or enum keeps where it stands.
    handler boxMoved
        let b = diagramCanvas.selected
        if b.dataObject != none
            let o = b.dataObject
            o.x = b.x
            o.y = b.y
            save o
        if b.enumType != none
            let e = b.enumType
            e.x = b.x
            e.y = b.y
            save e

    // A line bent: its property keeps the points.
    handler lineBent
        for p in members
            if "p{p.id}" == diagramCanvas.bent
                p.via = diagramCanvas.via
                save p
        members = find p in Property order by p.position

// The version `number` of a data object; an empty one (id 0) when it has no such version.
action versionOf(o: DataObject, number: integer) -> ClassDefinition
    effects db.read
    if o.id == 0
        return new ClassDefinition
    let v = find x in ClassDefinition where x.owner == o and x.number == number
    if count(v) == 0
        return new ClassDefinition
    return v[1]

function eventKindWord(kind: EventKind) -> text
    if kind == EventKind.Deleted
        return "Deleted"
    if kind == EventKind.Created
        return "Created"
    if kind == EventKind.Updated
        return "Updated"
    if kind == EventKind.Other
        return "Other"
    return "Changed"

function listWord(style: ListStyle) -> text
    if style == Sequence
        return "IEnumerable"
    if style == ArrayOf
        return "Array"
    if style == ListOf
        return "List"
    return ""

function accessWord(access: Access) -> text
    if access == GetOnly
        return "get"
    if access == GetSet
        return "set"
    return "init"

// The namespace an event's folder gives, which a new event starts with.
function folderNamespace(domain: text, number: integer) -> text
    if number > 1
        return "Fontys.Messages.{domain}.Events.v{number}"
    return "Fontys.Messages.{domain}.Events"

// The C# of an event, as the engine writes it.
function eventText(e: EventDefinition, fields: list<EventField>) -> text
    let spec = new EventSpec
    let owner = e.owner
    let d = owner.domain
    spec.domain = d.name
    spec.name = e.name
    spec.version = e.number
    spec.namespace = e.namespace
    spec.kind = eventKindWord(e.kind)
    spec.base = e.base
    spec.obsolete = e.obsolete
    if e.carries != none
        let v = e.carries
        let o = v.owner
        spec.typeName = o.name
        spec.typeVersion = v.number
    let specs: list<EventFieldSpec> = []
    for f in fields
        let fs = new EventFieldSpec
        fs.name = f.name
        fs.kind = f.kind
        fs.nullable = f.nullable
        fs.list = listWord(f.list)
        fs.access = accessWord(f.access)
        fs.obsolete = f.obsolete
        if f.holds != none
            let v = f.holds
            let o = v.owner
            fs.typeName = o.name
            fs.typeVersion = v.number
        if f.keyOf != none
            let k = f.keyOf
            fs.typeName = k.name
        specs = specs + [fs]
    return Fcdm.eventCode(spec, specs)

// A row of the tree for something that asks for a review: its label, marked.
function reviewLabel(label: text, review: text) -> text
    if review == ""
        return label
    return @reviewMark(label = label)

// Where the adapter's generator reads an API version.
function apiPath(major: integer) -> text
    return "Fontys.Adapter.FcdmApi.Generator/Configuration/FcdmApi-v{major}.json"

action writeApi(v: ApiVersion)
    effects db.read, files.write
    write apiJsonOf(v) to adapter apiPath(v.major)

// Copies the entities of one API version into another, with their relations and enum columns.
action copyApi(from: ApiVersion, into: ApiVersion)
    effects db.read, db.write
    for e in find x in ApiView where x.api == from order by x.position
        let c = new ApiView
        c.api = into
        c.position = e.position
        c.adapterTable = e.adapterTable
        c.entity = e.entity
        c.roles = e.roles
        c.className = e.className
        c.propertyName = e.propertyName
        c.propertyPluralName = e.propertyPluralName
        c.viewProperties = e.viewProperties
        c.primaryKey = e.primaryKey
        save c
        for r in find x in ApiRelation where x.owner == e order by x.position
            let cr = new ApiRelation
            cr.owner = c
            cr.position = r.position
            cr.kind = r.kind
            cr.foreignEntity = r.foreignEntity
            cr.foreignKey = r.foreignKey
            cr.propertyName = r.propertyName
            cr.omitProperty = r.omitProperty
            save cr
        for n in find x in ApiEnum where x.owner == e order by x.position
            let cn = new ApiEnum
            cn.owner = c
            cn.position = n.position
            cn.propertyName = n.propertyName
            cn.propertyType = n.propertyType
            cn.sourcePath = n.sourcePath
            save cn

// An API version's FcdmApi-vN.json, laid out as the adapter keeps it: two
// spaces, the roles on one line (a list only when there are several), an
// empty relations list open over two lines.
action apiJsonOf(v: ApiVersion) -> text
    effects db.read
    let out = "{{\n  \"version\": " + quoted(v.version) + ",\n  \"entities\": ["
    let entities = find x in ApiView where x.api == v order by x.position
    let first = true
    for e in entities
        if first
            out = out + "\n"
        else
            out = out + ",\n"
        first = false
        let roles = "[ " + join(quotedAll(e.roles), ", ") + " ]"
        if count(e.roles) == 1
            roles = quoted(e.roles[1])
        out = out + "    {{\n"
        out = out + "      \"entity\": " + quoted(e.entity) + ",\n"
        out = out + "      \"entityRole\": {roles},\n"
        out = out + "      \"className\": " + quoted(e.className) + ",\n"
        out = out + "      \"propertyName\": " + quoted(e.propertyName) + ",\n"
        out = out + "      \"propertyPluralName\": " + quoted(e.propertyPluralName) + ",\n"
        let table = e.adapterTable
        out = out + "      \"tableName\": " + quoted(table.name) + ",\n"
        out = out + "      \"viewProperties\": " + quoted(e.viewProperties) + ",\n"
        out = out + "      \"primaryKey\": " + quoted(e.primaryKey) + ",\n"
        let blocks: list<text> = []
        for r in find x in ApiRelation where x.owner == e order by x.position
            let fields = ["\"type\": " + quoted(relationWord(r.kind)), "\"foreignEntity\": " + quoted(r.foreignEntity)]
            if r.foreignKey != ""
                fields = fields + ["\"foreignKey\": " + quoted(r.foreignKey)]
            if r.propertyName != ""
                fields = fields + ["\"propertyName\": " + quoted(r.propertyName)]
            if r.omitProperty
                fields = fields + ["\"omitRelationProperty\": \"true\""]
            blocks = blocks + [jsonBlock(fields)]
        out = out + "      \"relations\": [\n" + jsonList(blocks) + "      ]"
        let enumBlocks: list<text> = []
        for n in find x in ApiEnum where x.owner == e order by x.position
            enumBlocks = enumBlocks + [jsonBlock(["\"propertyName\": " + quoted(n.propertyName), "\"propertyType\": " + quoted(n.propertyType), "\"propertySourcePath\": " + quoted(n.sourcePath)])]
        if count(enumBlocks) > 0
            out = out + ",\n      \"enumProperties\": [\n" + jsonList(enumBlocks) + "      ]"
        out = out + "\n    }}"
    if count(entities) == 0
        return out + "]\n}}\n"
    return out + "\n  ]\n}}\n"

// A JSON string of a text.
function quoted(t: text) -> text
    return "\"" + replace(replace(t, "\\", "\\\\"), "\"", "\\\"") + "\""

function quotedAll(texts: list<text>) -> list<text>
    let all: list<text> = []
    for t in texts
        all = all + [quoted(t)]
    return all

// An object of a list inside an entity, its fields one per line.
function jsonBlock(fields: list<text>) -> text
    let lines: list<text> = []
    for f in fields
        lines = lines + ["          " + f]
    return "        {{\n" + join(lines, ",\n") + "\n        }}"

function jsonList(items: list<text>) -> text
    if count(items) == 0
        return ""
    return join(items, ",\n") + "\n"

// A relation's kind as the generator names it.
function relationWord(kind: RelationKind) -> text
    if kind == RelatedByMany
        return "relatedByMany"
    if kind == RelatedByOne
        return "relatedByOne"
    return "relatesTo"

// The number of the newest version of a data object up to `level`; 0 when it has none yet.
function newestNumber(versions: list<ClassDefinition>, owner: integer, level: integer) -> integer
    let best = 0
    for v in versions
        if v.owner.id == owner and v.number <= level and v.number > best
            best = v.number
    return best

// The data objects as they are at a version of their domain: each at its newest version up to it.
function asIn(objects: list<DataObject>, versions: list<ClassDefinition>, level: integer) -> list<ClassDefinition>
    let found: list<ClassDefinition> = []
    for o in objects
        let at = newestNumber(versions, o.id, level)
        for v in versions
            if v.owner.id == o.id and v.number == at
                found = found + [v]
    return found

// The C# class of a version, as the engine writes it.
function classText(o: DataObject, v: ClassDefinition, properties: list<Property>) -> text
    let versions = find x in ClassDefinition order by x.number
    return Fcdm.classCode(objectSpec(o, v), propertySpecs(properties, versions, v.number))

// The interface of a root's version; a child has none.
function interfaceText(o: DataObject, v: ClassDefinition, properties: list<Property>) -> text
    if o.kind != Root
        return ""
    let versions = find x in ClassDefinition order by x.number
    return Fcdm.interfaceCode(objectSpec(o, v), propertySpecs(properties, versions, v.number))

function enumText(e: EnumType, values: list<EnumValue>) -> text
    let spec = new EnumSpec
    let owner = e.domain
    spec.domain = owner.name
    spec.name = e.name
    let specs: list<EnumValueSpec> = []
    for v in values
        let s = new EnumValueSpec
        s.name = v.name
        s.number = v.number
        specs = specs + [s]
    return Fcdm.enumCode(spec, specs)

function objectSpec(o: DataObject, v: ClassDefinition) -> ObjectSpec
    let spec = new ObjectSpec
    let owner = o.domain
    spec.domain = owner.name
    spec.name = o.name
    spec.root = o.kind == Root
    spec.keyed = o.keyed
    spec.newtonsoft = owner.newtonsoft
    spec.version = v.number
    spec.summary = o.summary
    spec.obsolete = v.obsolete
    return spec

// The properties as the engine takes them: a held object at its newest version up to this one.
function propertySpecs(properties: list<Property>, versions: list<ClassDefinition>, own: integer) -> list<PropertySpec>
    let specs: list<PropertySpec> = []
    for p in properties
        let s = new PropertySpec
        s.name = p.name
        s.kind = p.kind
        s.nullable = p.nullable
        s.initial = p.initial
        s.computed = p.computed
        s.obsolete = p.obsolete
        if p.kind == EnumChoice
            let e = p.choice
            s.typeName = e.name
        if p.kind == HeldObject or p.kind == HeldObjects
            let t = p.target
            s.typeName = t.name
            s.typeVersion = newestNumber(versions, t.id, own)
        specs = specs + [s]
    return specs

function versionLabel(number: integer, obsolete: text) -> text
    if obsolete != ""
        return @obsoleteVersionMark(number = number)
    return "v{number}"

function versionTitle(name: text, number: integer) -> text
    if number > 1
        return "{name} v{number}"
    return name

// The table of a class definition on the ERD: the adapter's table filled
// from it, the last by name when there are more (CursussenV2 after
// Cursussen); empty when none is, so it is no table there.
function tableTitle(v: ClassDefinition, tables: list<AdapterTable>) -> text
    let best = ""
    for t in tables
        if t.blueprint != none and t.blueprint.id == v.id
            best = t.name
    return best

// What a kind of property is written as on the diagrams.
function kindWord(kind: PropertyKind) -> text
    if kind == WholeNumber
        return "int"
    if kind == DecimalNumber
        return "decimal"
    if kind == YesNo
        return "bool"
    if kind == Moment
        return "DateTime"
    if kind == MomentWithOffset
        return "DateTimeOffset"
    if kind == DayOnly
        return "DateOnly"
    if kind == EnumChoice
        return "enum"
    if kind == HeldObject
        return "object"
    if kind == HeldObjects
        return "list"
    if kind == BusinessKey
        return "key"
    return "string"

// A line of a box: its name and kind, a question mark when it may be empty.
function propertyLine(name: text, kind: text, nullable: bool) -> text
    if nullable
        return "{name}: {kind}?"
    return "{name}: {kind}"

// The lines of a data object's box on the class diagram: its business key, then its properties.
function classLines(v: ClassDefinition, all: list<Property>) -> list<text>
    let lines: list<text> = []
    if v.owner.kind == Root and v.owner.keyed
        lines = lines + ["Bk: string"]
    for p in all
        if p.owner.id == v.id
            let kindText = kindWord(p.kind)
            if p.kind == EnumChoice and p.choice != none
                kindText = p.choice.name
            lines = lines + [propertyLine(p.name, kindText, p.nullable)]
    return lines

// The lines of a table on the ERD, as the adapter keeps it: its business key
// first, its stored values, and its two moments.
function erdLines(v: ClassDefinition, all: list<Property>) -> list<text>
    let lines: list<text> = ["PK  Bk"]
    for p in all
        if p.owner.id == v.id and p.kind != HeldObjects and p.kind != HeldObject and p.computed == ""
            if p.kind == EnumChoice and p.choice != none
                // The adapter keeps an enum as its number: an int column, no table.
                lines = lines + ["    {p.name}: int ({p.choice.name})"]
            else
                lines = lines + [columnLine(p.name, p.kind)]
    return lines + ["    LastModified", "    LastProcessed"]

// How wide a box is, in the canvas's units: room for its bold title (13) and
// its longest line in the mono font (11), at least 160, on the grid of 20.
function boxWidth(title: text, lines: list<text>) -> integer
    let widest = length(title) * 8
    for line in lines
        if length(line) * 7 > widest
            widest = length(line) * 7
    let w = widest + 24
    if w < 160
        w = 160
    return snapped(w + 10, 20)

// A column of a table: a foreign key for a business key, the value itself otherwise.
function columnLine(name: text, kind: PropertyKind) -> text
    if kind == BusinessKey
        return "FK  {name}"
    return "    {name}"

// A name no domain has yet: the word, or the word with the first number free.
function freeDomainName(word: text, domains: list<Domain>) -> text
    let name = word
    let n = 1
    for step in 1 to 1000
        let taken = false
        for d in domains
            if d.name == name
                taken = true
        if not taken
            return name
        n = n + 1
        name = "{word}{n}"
    return name

// The boxes of a domain's diagrams: its data objects, then its enums; an
// enum not yet moved stands in rows below the data objects.
function diagramBoxes(objects: list<DataObject>, enums: list<EnumType>) -> list<DiagramBox>
    let found: list<DiagramBox> = []
    let below = 0
    for o in objects
        let b = new DiagramBox
        b.id = o.id
        b.key = "o{o.id}"
        b.x = o.x
        b.y = o.y
        b.dataObject = o
        found = found + [b]
        if o.y + 300 > below
            below = o.y + 300
    let placed = 0
    for e in enums
        let b = new DiagramBox
        b.id = 1000000 + e.id
        b.key = "e{e.id}"
        b.x = e.x
        b.y = e.y
        if e.x == 0 and e.y == 0
            b.x = 40 + 320 * columnOf(placed)
            b.y = below + 260 * rowOf(placed)
            placed = placed + 1
        b.enumType = e
        found = found + [b]
    return found

// The box of a data object among the boxes.
function boxFor(all: list<DiagramBox>, o: DataObject) -> DiagramBox
    for b in all
        if b.dataObject != none and b.dataObject.id == o.id
            return b
    let alone = new DiagramBox
    alone.x = o.x
    alone.y = o.y
    alone.dataObject = o
    return alone

// The adapter's tables filled from a data object's class definitions, for
// its tables tab: each with the API versions that make a view on it.
action apiUsesOf(o: DataObject) -> list<ApiUse>
    effects db.read
    let uses: list<ApiUse> = []
    for t in find x in AdapterTable order by x.name
        if t.blueprint != none and t.blueprint.owner.id == o.id
            let u = new ApiUse
            u.version = t.blueprint.number
            u.table = t.name
            let majors: list<text> = []
            for w in find x in ApiView where x.adapterTable == t order by x.position
                let a = w.api
                majors = majors + ["v{a.major}"]
            u.apis = join(majors, ", ")
            uses = uses + [u]
    return uses

// The boxes of the diagram shown, each as large as it is drawn: a data
// object's (on the ERD only when an API version serves it), and an enum's
// on the class diagram.
function laidOutBoxes(boxes: list<DiagramBox>, shown: list<ClassDefinition>, members: list<Property>, enumValues: list<EnumValue>, tables: list<AdapterTable>, erd: bool) -> list<LayoutBox>
    let wanted: list<LayoutBox> = []
    for b in boxes
        let box = new LayoutBox
        box.id = b.id
        box.x = b.x
        box.y = b.y
        let lines: list<text> = []
        let title = ""
        if b.dataObject != none
            for v in shown
                if v.owner.id == b.dataObject.id
                    if erd
                        title = tableTitle(v, tables)
                        lines = erdLines(v, members)
                    else
                        title = versionTitle(v.owner.name, v.number)
                        lines = classLines(v, members)
        if b.enumType != none and not erd
            let e = b.enumType
            title = e.name
            lines = enumLines(e, enumValues)
        if title != ""
            box.width = boxWidth(title, lines)
            box.height = 40 + 22 * count(lines)
            wanted = wanted + [box]
    return wanted

// Where a line between two boxes starts and ends: from the bottom of the
// upper box to the top of the lower one, or between the sides that face
// each other when they stand beside each other; x1, y1, x2, y2.
function lineEnds(ax: integer, ay: integer, aw: integer, ah: integer, bx: integer, by: integer, bw: integer, bh: integer) -> list<integer>
    if by >= ay + ah
        return [ax + aw div 2, ay + ah, bx + bw div 2, by]
    if ay >= by + bh
        return [ax + aw div 2, ay, bx + bw div 2, by + bh]
    if bx >= ax + aw
        return [ax + aw, ay + 20, bx, by + 20]
    if ax >= bx + bw
        return [ax, ay + 20, bx + bw, by + 20]
    return [ax + aw div 2, ay + 20, bx + bw div 2, by + 20]

// The id of the box at a point of the canvas; 0 on the paper.
function boxAt(laid: list<LayoutBox>, x: integer, y: integer) -> integer
    for b in laid
        if x >= b.x and x <= b.x + b.width and y >= b.y and y <= b.y + b.height
            return b.id
    return 0

// The lines of an enum's box: its values with the numbers they are kept as.
function enumLines(e: EnumType, all: list<EnumValue>) -> list<text>
    let lines: list<text> = []
    for v in all
        if v.owner.id == e.id
            lines = lines + ["{v.name} = {v.number}"]
    return lines

// Where the n-th box of a domain goes, from 0: five to a row.
function columnOf(n: integer) -> integer
    let left = n
    for step in 1 to 1000
        if left >= 5
            left = left - 5
    return left

function rowOf(n: integer) -> integer
    let left = n
    let row = 0
    for step in 1 to 1000
        if left >= 5
            left = left - 5
            row = row + 1
    return row
