<?xml version="1.0" encoding="UTF-8"?>
<!-- What the window Main shows: its parts, data and code. -->
<View class="mp3player.MainView">
  <Data name="tracks" type="list&lt;Track&gt;" />
  <Data name="current" type="integer" />
  <Data name="volume" type="integer" default="80" />
  <Data name="muted" type="bool" default="false" />
  <Data name="played" type="decimal" />
  <Data name="nowPlaying" type="text" />
  <Data name="chosen" type="text" />
  <Sound name="music" at="1,1" span="1" volume="80" onend="songEnded" onfail="songFailed" />
  <Timer name="ticker" at="1,1" span="1" every="0.5" ontick="tickerTicked" />
  <Label name="folderLabel" at="1,1" span="2" caption="@folderLabel" for="musicFolderBox" />
  <Folder name="musicFolderBox" at="3,1" span="10" bind="settings.musicFolder" onchange="folderChanged" />
  <Table name="trackTable" at="1,2" span="12" rows="5" bind="tracks" columns="title" resizable="true" sortable="true" onselect="trackSelected" onopen="playClicked" />
  <Text name="nowPlayingText" at="1,7" span="12" bind="nowPlaying" />
  <Slider name="progressSlider" at="1,8" span="12" bind="played" max="1000" min="0" onchange="progressMoved" />
  <Label name="volumeLabel" at="1,9" span="1" caption="@volumeLabel" for="volumeSlider" />
  <Slider name="volumeSlider" at="2,9" span="3" bind="volume" max="100" min="0" onchange="volumeChanged" />
  <Text name="volumeValue" at="5,9" span="1" bind="volume" />
  <Button name="muteButton" at="1,10" span="1" caption="@muteCaption" onclick="muteClicked" />
  <Button name="nextTrack" at="8,10" span="1" caption="@nextCaption" onclick="nextClicked" />
  <Button name="playTrack" at="9,10" span="1" caption="@playCaption" default="true" onclick="playClicked" />
  <Button name="stopTrack" at="10,10" span="1" caption="@stopCaption" onclick="stopClicked" />
  <Button name="pauseTrack" at="11,10" span="1" caption="@pauseCaption" onclick="pauseClicked" />
  <Button name="previousTrack" at="12,10" span="1" caption="@previousCaption" onclick="previousClicked" />
</View>
