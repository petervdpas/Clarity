<?xml version="1.0" encoding="UTF-8"?>
<App class="mp3player.Mp3player" title="@mp3playerTitle" main="Main">
  <Menu name="mainMenu">
    <Item caption="@fileItem" name="fileItem">
      <Item caption="@preferencesItem" name="preferencesItem" opens="Preferences" />
      <Item caption="@quitItem" name="quitItem" opens="quit" />
    </Item>
  </Menu>
</App>
