module mp3player

// A song found in the music folder: its name and where its file is.
record Track
    title: text
    path: text

// What the person sets for themselves: the folder their music is in.
settings
    musicFolder: folder, label @musicFolderSetting

app Mp3player
    title @mp3playerTitle
    main Main

page Main: window
    title @mainTitle
    data tracks: list<Track>
    data current: integer
    data volume: integer, default 80
    data played: decimal
    data nowPlaying: text
    data chosen: text
    on open: windowOpened

    // The songs play through the sound part: mp3, flac, ogg and wav files of the folder.
    sound name music volume 80 on end: songEnded on fail: songFailed
    // Moves the progress bar along while a song plays.
    timer name ticker every 0.5 on tick: tickerTicked

    label @folderLabel name folderLabel at 1,1 span 2 for musicFolderBox
    folder name musicFolderBox at 3,1 span 10 bind settings.musicFolder on change: folderChanged
    table name trackTable at 1,2 span 12 rows 9 bind tracks columns title resizable sortable on select: trackSelected on open: playClicked
    text name nowPlayingText at 1,11 span 12 bind nowPlaying
    slider name progressSlider at 1,12 span 12 bind played min 0 max 1000 on change: progressMoved
    label @volumeLabel name volumeLabel at 1,13 span 1 for volumeSlider
    slider name volumeSlider at 2,13 span 3 bind volume min 0 max 100 on change: volumeChanged
    button @previousCaption name previousTrack at 5,13 span 2 on click: previousClicked
    button @playCaption name playTrack at 7,13 span 2 default on click: playClicked
    button @pauseCaption name pauseTrack at 9,13 span 1 on click: pauseClicked
    button @stopCaption name stopTrack at 10,13 span 1 on click: stopClicked
    button @nextCaption name nextTrack at 11,13 span 2 on click: nextClicked

code Main
    handler windowOpened
        music.volume(volume)
        loadTracks()

    handler folderChanged
        stopClicked()
        loadTracks()

    // Lists the songs of the folder, with their folders below it.
    handler loadTracks
        let found: list<Track> = []
        if settings.musicFolder != ""
            let songs = files f in music where f.extension == "mp3" or f.extension == "flac" or f.extension == "ogg" or f.extension == "wav" order by f.path
            for f in songs
                let t = new Track
                t.title = f.path
                t.path = settings.musicFolder + "/" + f.path
                found = found + [t]
        tracks = found
        current = 0
        chosen = ""

    handler trackSelected
        chosen = trackTable.selected.path

    // Plays the song at a place of the list.
    handler startAt(position: integer)
        if position < 1 or position > count(tracks)
            return
        let t = tracks[position]
        music.play(t.path)
        current = position
        played = 0
        nowPlaying = @nowPlayingTitle(title = t.title)
        chosen = t.path
        trackTable.selected = t

    // Plays the song picked in the table, or the first one; a held song plays on.
    handler playClicked
        if music.paused
            music.resume()
            return
        if count(tracks) == 0
            message @noSongs
            return
        let position = 1
        if chosen != ""
            for i in 1 to count(tracks)
                if tracks[i].path == chosen
                    position = i
        startAt(position)

    handler pauseClicked
        if music.paused
            music.resume()
        else
            music.pause()

    handler stopClicked
        music.stop()
        played = 0
        nowPlaying = ""

    handler nextClicked
        if current < count(tracks)
            startAt(current + 1)

    handler previousClicked
        if current > 1
            startAt(current - 1)

    handler volumeChanged
        music.volume(volume)

    // The progress bar runs from 0 to 1000 over the song; moving it moves the song.
    handler progressMoved
        if music.length > 0
            music.seek(played * music.length / 1000)

    // While a song plays: the bar follows it, and the line shows what its file says of it.
    handler tickerTicked
        if music.playing and music.length > 0
            played = round(music.position * 1000 / music.length, 0)
            if music.title != ""
                nowPlaying = @nowPlayingTags(title = music.title, artist = music.artist)

    // When a song has ended, the next one starts.
    handler songEnded
        if current < count(tracks)
            startAt(current + 1)
        else
            stopClicked()

    handler songFailed
        message error @cannotPlay(why = music.problem)
