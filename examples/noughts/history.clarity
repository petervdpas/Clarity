module history

// The data of played games: who played, each game and its moves.
// Not used by the windows yet; it is the first draft of the ERD.

enum Mark
    Cross label @markCross
    Nought label @markNought

enum GameResult
    Playing label @resultPlaying
    Won label @resultWon
    Lost label @resultLost
    Draw label @resultDraw

entity Player
    name: text(40), required, unique, label @playerNameLabel
    created: datetime, label @playerCreatedLabel
    games: list<Game>, label @playerGamesLabel

entity Game
    player: ref Player, required, label @gamePlayerLabel
    started: datetime, label @gameStartedLabel
    result: GameResult, default Playing, label @gameResultLabel
    moves: list<Move>, owned, label @gameMovesLabel

entity Move
    game: ref Game, required, label @moveGameLabel
    number: integer, required, min 1, max 9, label @moveNumberLabel
    square: integer, required, min 1, max 9, label @moveSquareLabel
    mark: Mark, required, label @moveMarkLabel
