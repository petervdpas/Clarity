module noughts

// A game of noughts and crosses, one board for each open window; its source
// is in engines/board.
engine Board from "board.wasm"
    uses random
    state per window
    on open
    function play(square: integer) -> text
    function mark(square: integer) -> text
    function restart() -> text

app Noughts
    title "Noughts and crosses"
    main Game
    menu name mainMenu
        item "Game" name gameItem
            item "Another window" name anotherWindowItem on click -> Game in new window
            separator
            item "Quit" name quitItem key "Ctrl+Q" on click -> quit

page Game: window
    title "Noughts and crosses"
    size 405 x 510
    data status: text, default "Your move"
    data rules: text, default "Click a square to put your cross there; the computer answers with a nought. Three in a row wins."
    // How to play: folded to a button until the person opens it.
    sidebar right name help width 260 min 200 max 420 resizable collapsible collapsed maximizable
        heading "How to play" name helpHeading at 1,1 span 3
        text name rulesText at 1,2 span 3 rows 4 bind rules
    canvas name board at 1,1 span 12 rows 8 units 300 x 300 on draw: drawBoard on click: boardClicked
    text name statusText at 1,9 span 12 bind status
    button "New game" name newGame at 1,10 span 12 key "Ctrl+N" on click: restartClicked

code Game
    // A click on a square plays it: three columns and three rows of 100.
    handler boardClicked
        let square = 1
        if board.x >= 200
            square = 3
        else if board.x >= 100
            square = 2
        if board.y >= 200
            square = square + 6
        else if board.y >= 100
            square = square + 3
        status = Board.play(square)

    handler restartClicked
        status = Board.restart()

    // The grid, and on each square its mark.
    handler drawBoard
        board.clear("panel")
        board.line(100, 15, 100, 285, "border", 4)
        board.line(200, 15, 200, 285, "border", 4)
        board.line(15, 100, 285, 100, "border", 4)
        board.line(15, 200, 285, 200, "border", 4)
        drawMark(1, 0, 0)
        drawMark(2, 100, 0)
        drawMark(3, 200, 0)
        drawMark(4, 0, 100)
        drawMark(5, 100, 100)
        drawMark(6, 200, 100)
        drawMark(7, 0, 200)
        drawMark(8, 100, 200)
        drawMark(9, 200, 200)

    // A cross is two lines, a nought a ring, in the square from left, top.
    handler drawMark(square: integer, left: integer, top: integer)
        let mark = Board.mark(square)
        if mark == "X"
            board.line(left + 25, top + 25, left + 75, top + 75, "accent", 8)
            board.line(left + 75, top + 25, left + 25, top + 75, "accent", 8)
        else if mark == "O"
            board.ring(left + 50, top + 50, 27, "text", 8)
