<?xml version="1.0" encoding="UTF-8"?>
<Window class="orbs.Play" title="@playTitle" width="980" height="640">
  <Content name="main" at="1,1" span="12" rows="12">
    <View name="PlayView" />
  </Content>
  <Slideout name="bestPanel" at="1,1" span="6" rows="12" caption="@bestSlideout" resizable="true" slideWidth="360" pinnable="true" max="700" min="260">
    <Content name="bestPanelContent" at="1,1" span="6" rows="12">
      <View name="BestScores" />
    </Content>
  </Slideout>
</Window>
