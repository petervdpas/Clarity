<?xml version="1.0" encoding="UTF-8"?>
<!-- What the window AlbumBrowse shows: its parts, data and code. -->
<View class="music.AlbumBrowseView">
  <Data name="albums" type="list&lt;Album&gt;" />
  <Heading name="collectionHeading" at="1,1" span="6" caption="@collectionHeadingCaption" />
  <Image name="collectionLogo" at="12,1" span="1" source="logo.png" tooltip="@collectionLogoTooltip" />
  <Label name="searchLabel" at="1,2" span="2" caption="@searchLabel" for="searchBox" />
  <Textbox name="searchBox" at="3,2" span="10" placeholder="@searchPlaceholder" onchange="filterChanged" />
  <Table name="grid" at="1,3" span="12" rows="8" bind="albums" columns="title, artist, year, format, rating, price, tags" resizable="true" sortable="true" add="true" remove="true" confirm="true" page="25" onadd="newClicked" onremove="removeClicked" onopen="openClicked" />
  <Button name="exportList" at="1,11" span="2" caption="@exportListCaption" onclick="exportClicked" />
</View>
