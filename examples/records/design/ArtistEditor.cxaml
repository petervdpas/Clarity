<?xml version="1.0" encoding="UTF-8"?>
<!-- An artist: name, country, since when, website and photo. -->
<View class="music.ArtistEditor">
  <Data name="artist" type="Artist" />
  <Tells message="saved" />
  <Image name="photo" at="10,1" span="3" rows="4" bind="artist.photo" />
  <Form name="artistForm" at="1,1" span="9" rows="4" bind="artist">
    <Label name="nameLabel" at="1,1" span="3" caption="@nameLabel" for="name" />
    <Textbox name="name" at="4,1" span="6" bind="artist.name" />
    <Label name="countryLabel" at="1,2" span="3" caption="@countryLabel" for="country" />
    <Dropdown name="country" at="4,2" span="6" bind="artist.country" typed="true" />
    <Label name="formedLabel" at="1,3" span="3" caption="@formedLabel" for="formed" />
    <Number name="formed" at="4,3" span="2" bind="artist.formed" />
    <Label name="websiteLabel" at="1,4" span="3" caption="@websiteLabel" for="website" />
    <Textbox name="website" at="4,4" span="6" bind="artist.website" placeholder="@websitePlaceholder" />
  </Form>
  <Button name="saveArtist" at="11,6" span="2" caption="@saveCaption" style="primary" default="true" onclick="saveClicked" />
</View>
