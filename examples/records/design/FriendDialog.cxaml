<?xml version="1.0" encoding="UTF-8"?>
<Dialog class="loans.FriendDialog" title="@friendDialogTitle">
  <Data name="friend" type="Friend" />
  <Label name="nameLabel" at="1,1" span="3" caption="@nameLabel" for="name" />
  <Textbox name="name" at="4,1" span="9" bind="friend.name" />
  <Label name="phoneLabel" at="1,2" span="3" caption="@phoneLabel" for="phone" />
  <Textbox name="phone" at="4,2" span="4" bind="friend.phone" />
  <Label name="emailLabel" at="1,3" span="3" caption="@emailLabel" for="email" />
  <Textbox name="email" at="4,3" span="9" bind="friend.email" />
  <Button name="saveFriend" at="9,5" span="2" caption="@saveCaption" style="primary" default="true" onclick="saveClicked" />
  <Button name="cancelFriend" at="11,5" span="2" caption="@cancelCaption" opens="close" cancel="true" />
</Dialog>
