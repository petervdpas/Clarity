<?xml version="1.0" encoding="UTF-8"?>
<!-- What the window GenreBrowse shows: its parts, data and code. -->
<View class="music.GenreBrowseView">
  <Data name="genres" type="list&lt;Genre&gt;" />
  <TreeTable name="genreTree" at="1,1" span="12" rows="9" bind="genres" columns="name" add="true" remove="true" confirm="true" childList="children" onadd="newClicked" onremove="removeClicked" onopen="openClicked" />
</View>
