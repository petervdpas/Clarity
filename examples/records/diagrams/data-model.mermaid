erDiagram
    Friend {
        text(80) name UK "required"
        text(20) phone
        email email
    }
    Loan {
        Album album FK "required"
        Friend friend FK "required"
        date lent_on "required"
        date returned_on
    }
    Genre {
        text(40) name UK "required"
        Genre parent FK
    }
    Artist {
        text(80) name UK "required"
        text(40) country
        integer formed
        url website
        image photo
    }
    Album {
        text(120) title "required"
        Artist artist FK "required"
        Genre genre FK
        integer year
        Format format
        text(60) record_label
        date bought_on
        money price
        integer rating
        image cover
        text notes
    }
    Track {
        Album album FK "required"
        integer number
        text(120) title "required"
        duration length
    }
    Loan }o..|| Album : album
    Loan }o..|| Friend : friend
