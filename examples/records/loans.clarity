module loans

use music

entity Friend
    name: text(80), required, unique
    phone: text(20)
    email: email

// An album lent to a friend, until it comes back.
entity Loan
    album: ref Album, required
    friend: ref Friend, required
    lent_on: date, required
    returned_on: date, help "Empty while the friend has it"

// Whether an album is with a friend now, other than in `loan`.
function lent_elsewhere(loan: Loan) -> bool
    let open = find l in Loan where l.album == loan.album and l.returned_on == none
    for other in open
        if other.id != loan.id
            return true
    return false

action bring_back(loan: Loan)
    require loan.returned_on == none
    effects db.write
    loan.returned_on = today()
    save loan

page LoanBrowse: window
    title "On loan"
    data loans: list<Loan>
    on open: window_returned
    on return: window_returned

    heading "Albums with friends" at 1,1 span 6
    checkbox "Show returned loans" name show_returned at 9,1 span 4 on change: window_returned
    table name loan_grid at 1,2 span 12 rows 8 bind loans columns album, friend, lent_on, returned_on on open: open_clicked
    button "Friends" at 1,10 span 2 on click -> FriendBrowse
    button "Lend" at 7,10 span 2 on click -> LoanDialog
    button "Brought back" name back_button at 9,10 span 2 on click: back_clicked
    button "Open" at 11,10 span 2 on click: open_clicked

page LoanDialog: dialog
    title "Lend an album"
    data loan: Loan
    on open: dialog_opened

    label "Album" at 1,1 span 3 for album
    dropdown name album at 4,1 span 6 bind loan.album
    label "Friend" at 1,2 span 3 for friend
    dropdown name friend at 4,2 span 6 bind loan.friend
    label "Lent on" at 1,3 span 3 for lent_on
    date name lent_on at 4,3 span 4 bind loan.lent_on
    label "Returned on" at 1,4 span 3 for returned_on
    date name returned_on at 4,4 span 4 bind loan.returned_on
    help at 8,4 span 5 for returned_on
    button "Save" at 9,6 span 2 style primary default on click: save_clicked
    button "Cancel" at 11,6 span 2 cancel on click -> close

page FriendBrowse: window
    title "Friends"
    data friends: list<Friend>
    on return: window_returned

    table name friend_grid at 1,1 span 12 rows 8 bind friends columns name, phone, email on open: open_clicked
    button "New friend" at 9,9 span 2 on click -> FriendDialog
    button "Open" at 11,9 span 2 on click: open_clicked

page FriendDialog: dialog
    title "Friend"
    data friend: Friend

    label "Name" at 1,1 span 3 for name
    textbox name name at 4,1 span 6 bind friend.name
    label "Phone" at 1,2 span 3 for phone
    textbox name phone at 4,2 span 4 bind friend.phone
    label "E-mail" at 1,3 span 3 for email
    textbox name email at 4,3 span 6 bind friend.email
    button "Save" at 9,5 span 2 style primary default on click: save_clicked
    button "Cancel" at 11,5 span 2 cancel on click -> close

code LoanBrowse
    handler window_returned
        if show_returned.checked
            loans = find l in Loan order by l.lent_on desc
        else
            loans = find l in Loan where l.returned_on == none order by l.lent_on

    handler open_clicked
        open LoanDialog with loan = loan_grid.selected

    handler back_clicked
        bring_back(loan_grid.selected)
        message "{loan_grid.selected.album.title} is back"
        window_returned()

code LoanDialog
    handler dialog_opened
        // A new loan starts today.
        if loan.lent_on == none
            loan.lent_on = today()

    handler save_clicked
        album.error = ""
        friend.error = ""
        if loan.album == none
            album.error = "Choose the album"
            return
        if loan.friend == none
            friend.error = "Choose who borrows it"
            return
        save loan
        message "Lent {loan.album.title} to {loan.friend.name}"
        close

code FriendBrowse
    handler window_returned
        reload friends

    handler open_clicked
        open FriendDialog with friend = friend_grid.selected

code FriendDialog
    handler save_clicked
        name.error = ""
        if friend.name == ""
            name.error = "A friend needs a name"
            return
        save friend
        close

code Loan
    before save
        if loan.returned_on == none and lent_elsewhere(loan)
            refuse "{loan.album.title} is with another friend already"
