module loans

use music

entity Friend
    name: text(80), required, unique
    phone: text(20)
    email: email

// An album lent to a friend, until it comes back.
entity Loan
    album: ref Album, required
    friend: ref Friend, required
    lent_on: date, required
    returned_on: date, help "Empty while the friend has it"

// Whether an album is with a friend now, other than in `loan`.
function lent_elsewhere(loan: Loan) -> bool
    let open = find l in Loan where l.album == loan.album and l.returned_on == none
    for other in open
        if other.id != loan.id
            return true
    return false

action bring_back(loan: Loan)
    require loan.returned_on == none
    effects db.write
    loan.returned_on = today()
    save loan

page LoanBrowse: window
    title "On loan"
    data loans: list<Loan>
    on open: windowReturned
    on return: windowReturned

    heading "Albums with friends" name heading1 at 1,1 span 6
    checkbox "Show returned loans" name showReturned at 9,1 span 4 on change: windowReturned
    table name loanGrid at 1,2 span 12 rows 8 bind loans columns album, friend, lent_on, returned_on on open: openClicked
    button "Friends" name button1 at 1,10 span 2 on click -> FriendBrowse
    button "Lend" name button2 at 7,10 span 2 on click -> LoanDialog
    button "Brought back" name backButton at 9,10 span 2 on click: backClicked
    button "Open" name button3 at 11,10 span 2 on click: openClicked

page LoanDialog: dialog
    title "Lend an album"
    data loan: Loan
    on open: dialogOpened

    label "Album" name label1 at 1,1 span 3 for album
    dropdown name album at 4,1 span 9 bind loan.album
    label "Friend" name label2 at 1,2 span 3 for friend
    dropdown name friend at 4,2 span 9 bind loan.friend
    label "Lent on" name label3 at 1,3 span 3 for lentOn
    date name lentOn at 4,3 span 4 bind loan.lent_on
    label "Returned on" name label4 at 1,4 span 3 for returnedOn
    date name returnedOn at 4,4 span 4 bind loan.returned_on
    help name help1 at 8,4 span 5 for returnedOn
    button "Save" name button1 at 9,6 span 2 style primary default on click: saveClicked
    button "Cancel" name button2 at 11,6 span 2 cancel on click -> close

page FriendBrowse: window
    title "Friends"
    data friends: list<Friend>
    on return: windowReturned

    table name friendGrid at 1,1 span 12 rows 8 bind friends columns name, phone, email on open: openClicked
    button "New friend" name button1 at 9,9 span 2 on click -> FriendDialog
    button "Open" name button2 at 11,9 span 2 on click: openClicked

page FriendDialog: dialog
    title "Friend"
    data friend: Friend

    label "Name" name label1 at 1,1 span 3 for name
    textbox name name at 4,1 span 9 bind friend.name
    label "Phone" name label2 at 1,2 span 3 for phone
    textbox name phone at 4,2 span 4 bind friend.phone
    label "E-mail" name label3 at 1,3 span 3 for email
    textbox name email at 4,3 span 9 bind friend.email
    button "Save" name button1 at 9,5 span 2 style primary default on click: saveClicked
    button "Cancel" name button2 at 11,5 span 2 cancel on click -> close

code LoanBrowse
    handler windowReturned
        if showReturned.checked
            loans = find l in Loan order by l.lent_on desc
        else
            loans = find l in Loan where l.returned_on == none order by l.lent_on

    handler openClicked
        open LoanDialog with loan = loanGrid.selected

    handler backClicked
        bring_back(loanGrid.selected)
        message "{loanGrid.selected.album.title} is back"
        windowReturned()

code LoanDialog
    handler dialogOpened
        // A new loan starts today.
        if loan.lent_on == none
            loan.lent_on = today()

    handler saveClicked
        album.error = ""
        friend.error = ""
        if loan.album == none
            album.error = "Choose the album"
            return
        if loan.friend == none
            friend.error = "Choose who borrows it"
            return
        save loan
        message "Lent {loan.album.title} to {loan.friend.name}"
        close

code FriendBrowse
    handler windowReturned
        reload friends

    handler openClicked
        open FriendDialog with friend = friendGrid.selected

code FriendDialog
    handler saveClicked
        name.error = ""
        if friend.name == ""
            name.error = "A friend needs a name"
            return
        save friend
        close

code Loan
    before save
        if loan.returned_on == none and lent_elsewhere(loan)
            refuse "{loan.album.title} is with another friend already"
