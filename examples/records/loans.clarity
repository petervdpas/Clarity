module loans

use music

entity Friend
    name: text(80), required, unique, label @friendNameLabel
    phone: text(20), label @friendPhoneLabel
    email: email, label @friendEmailLabel

// An album lent to a friend, until it comes back.
entity Loan
    album: ref Album, required, label @loanAlbumLabel
    friend: ref Friend, required, label @loanFriendLabel
    lentOn: date, required, label @loanLentOnLabel
    returnedOn: date, help @loanReturnedOnHelp, label @loanReturnedOnLabel

// Whether an album is with a friend now, other than in `loan`.
function lentElsewhere(loan: Loan) -> bool
    let open = find l in Loan where l.album == loan.album and l.returnedOn == none
    for other in open
        if other.id != loan.id
            return true
    return false

action bringBack(loan: Loan)
    require loan.returnedOn == none
    effects db.write
    loan.returnedOn = today()
    save loan

page LoanBrowse: window
    title @loanBrowseTitle
    data loans: list<Loan>
    on open: windowReturned
    on return: windowReturned

    heading @loansHeadingCaption name loansHeading at 1,1 span 6
    checkbox @showReturnedCaption name showReturned at 9,1 span 4 on change: windowReturned
    // Add lends an album in the dialog; the trash takes a loan away for good.
    table name loanGrid at 1,2 span 12 rows 8 bind loans columns album, friend, lentOn, returnedOn sortable add remove confirm on add: lendClicked on remove: removeClicked on open: openClicked
    button @friendsCaption name friends at 1,10 span 2 on click -> FriendBrowse
    button @backButtonCaption name backButton at 11,10 span 2 on click: backClicked

page LoanDialog: dialog
    title @loanDialogTitle
    data loan: Loan
    on open: dialogOpened

    label @albumLabel name albumLabel at 1,1 span 3 for album
    dropdown name album at 4,1 span 9 bind loan.album search show title, year
    label @friendLabel name friendLabel at 1,2 span 3 for friend
    dropdown name friend at 4,2 span 9 bind loan.friend search show name, phone
    label @lentOnLabel name lentOnLabel at 1,3 span 3 for lentOn
    date name lentOn at 4,3 span 4 bind loan.lentOn
    label @returnedOnLabel name returnedOnLabel at 1,4 span 3 for returnedOn
    date name returnedOn at 4,4 span 4 bind loan.returnedOn
    help name returnedOnHelp at 8,4 span 5 for returnedOn
    button @saveCaption name saveLoan at 9,6 span 2 style primary default on click: saveClicked
    button @cancelCaption name cancelLoan at 11,6 span 2 cancel on click -> close

page FriendBrowse: window
    title @friendBrowseTitle
    data friends: list<Friend>
    on return: windowReturned

    table name friendGrid at 1,1 span 12 rows 9 bind friends columns name, phone, email add remove confirm on add: newClicked on remove: removeClicked on open: openClicked

page FriendDialog: dialog
    title @friendDialogTitle
    data friend: Friend

    label @nameLabel name nameLabel at 1,1 span 3 for name
    textbox name name at 4,1 span 9 bind friend.name
    label @phoneLabel name phoneLabel at 1,2 span 3 for phone
    textbox name phone at 4,2 span 4 bind friend.phone
    label @emailLabel name emailLabel at 1,3 span 3 for email
    textbox name email at 4,3 span 9 bind friend.email
    button @saveCaption name saveFriend at 9,5 span 2 style primary default on click: saveClicked
    button @cancelCaption name cancelFriend at 11,5 span 2 cancel on click -> close

code LoanBrowse
    handler windowReturned
        if showReturned.checked
            loans = find l in Loan order by l.lentOn desc
        else
            loans = find l in Loan where l.returnedOn == none order by l.lentOn

    handler openClicked
        open LoanDialog with loan = loanGrid.selected

    handler lendClicked
        open LoanDialog

    handler removeClicked
        delete loanGrid.selected
        windowReturned()

    handler backClicked
        bringBack(loanGrid.selected)
        message @titleIsBack(title = loanGrid.selected.album.title)
        windowReturned()

code LoanDialog
    handler dialogOpened
        // A new loan starts today.
        if loan.lentOn == none
            loan.lentOn = today()

    handler saveClicked
        album.error = ""
        friend.error = ""
        if loan.album == none
            album.error = @chooseTheAlbum
            return
        if loan.friend == none
            friend.error = @chooseWhoBorrowsIt
            return
        save loan
        message @lentTitleToName(title = loan.album.title, name = loan.friend.name)
        close

code FriendBrowse
    handler windowReturned
        reload friends

    handler openClicked
        open FriendDialog with friend = friendGrid.selected

    handler newClicked
        open FriendDialog

    // A friend who borrowed albums stays, and says so.
    handler removeClicked
        delete friendGrid.selected
        reload friends

code FriendDialog
    handler saveClicked
        name.error = ""
        if friend.name == ""
            name.error = @aFriendNeedsAName
            return
        save friend
        close

code Loan
    before save
        if loan.returnedOn == none and lentElsewhere(loan)
            refuse @titleIsWithAnotherFriend(title = loan.album.title)
