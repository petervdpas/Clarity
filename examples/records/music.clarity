module music

// What an album came out on.
enum Format
    Vinyl label @formatVinyl
    Single label @formatSingle
    Cd label @formatCd
    Cassette label @formatCassette
    Digital label @formatDigital

// Genres form a tree: Bebop belongs to Jazz.
entity Genre
    name: text(40), required, unique, label @genreNameLabel
    parent: ref Genre, help @genreParentHelp, label @genreParentLabel
    children: list<Genre>, label @genreChildrenLabel

entity Artist
    name: text(80), required, unique, label @artistNameLabel
    country: text(40), label @artistCountryLabel
    formed: integer, format plain, label @artistFormedLabel
    website: url, label @artistWebsiteLabel
    photo: image, store photos, label @artistPhotoLabel

entity Album
    title: text(120), required, label @albumTitleLabel
    artist: ref Artist, required, label @albumArtistLabel
    genre: ref Genre, label @albumGenreLabel
    year: integer, format plain, min 1900, max 2100, label @albumYearLabel
    format: Format, default Cd, label @albumFormatLabel
    record_label: text(60), label @albumRecordLabelLabel
    bought_on: date, label @albumBoughtOnLabel
    price: money, min 0, label @albumPriceLabel
    rating: integer, min 0, max 5, help @albumRatingHelp, label @albumRatingLabel
    cover: image, help @albumCoverHelp, label @albumCoverLabel
    notes: text, label @albumNotesLabel
    tags: list<text>, label @albumTagsLabel
    booklet: file, label @albumBookletLabel

// A track of an album; the album form lists them in order.
entity Track
    album: ref Album, required, label @trackAlbumLabel
    number: integer, min 1, label @trackNumberLabel
    title: text(120), required, label @trackTitleLabel
    length: duration, min 0, label @trackLengthLabel

// The length of a set of tracks.
function total_length(tracks: list<Track>) -> duration
    ensure result >= 0
    let total: duration = 0
    for track in tracks
        total = total + track.length
    return total

// Reads the size of a picture from the first bytes of its file; its
// source is in engines/images.
engine Images from "images.wasm"
    function width(picture: bytes) -> integer
    function height(picture: bytes) -> integer

// Photos dropped in the photos folder, named after the artist
// (Miles Davis.jpg), become the photos of artists that have none, when
// they are at least 200 pixels on each side.
action find_artist_photos()
    effects db.write, files.read
    let found = files f in photos where f.extension == "jpg" or f.extension == "png"
    let artists = find a in Artist where a.photo == none
    for artist in artists
        for f in found
            if f.name == artist.name + "." + f.extension
                let picture = read bytes of f
                if Images.width(picture) >= 200 and Images.height(picture) >= 200
                    artist.photo = f
                    save artist

// A copy of every photo in the exports folder, byte for byte.
action back_up_photos()
    effects files.read, files.write
    let found = files f in photos
    for f in found
        let content: bytes = read bytes of f
        write content to exports "photos/" + f.path

// The collection as a text file in the exports folder.
action export_collection()
    effects files.write
    let albums = find a in Album order by a.artist.name, a.title
    let lines = ""
    for album in albums
        lines = lines + album.title + "\n"
    write lines to exports "collection.txt"

page AlbumBrowse: window
    title @albumBrowseTitle
    data albums: list<Album>
    on return: windowReturned

    heading @collectionHeadingCaption name collectionHeading at 1,1 span 6
    image name collectionLogo at 12,1 span 1 rows 1 source "logo.png" tooltip @collectionLogoTooltip
    label @titleFilterLabel name titleFilterLabel at 1,2 span 2 for titleFilter
    textbox name titleFilter at 3,2 span 10 placeholder @titleFilterPlaceholder on change: filterChanged
    table name grid at 1,3 span 12 rows 8 bind albums columns title, artist, year, format, rating, price, tags resizable sortable page 25 on open: openClicked
    button @exportListCaption name exportList at 1,11 span 2 on click: exportClicked
    button @newAlbumCaption name newAlbum at 9,11 span 2 on click -> AlbumForm
    button @openCaption name openAlbum at 11,11 span 2 on click: openClicked

page AlbumForm: window
    title @albumFormTitle
    data album: Album
    data tracks: list<Track>
    on open: albumOpened
    on return: albumOpened

    splitter name albumSplitter at 1,1 span 12 rows 10 horizontal
        pane
            panel @albumPanelCaption name albumPanel at 1,1 span 12 rows 9
                label @titleLabel name titleLabel at 1,1 span 3 for title
                textbox name title at 4,1 span 9 bind album.title
                label @artistLabel name artistLabel at 1,2 span 3 for artist
                dropdown name artist at 4,2 span 9 bind album.artist search show name, country
                label @genreLabel name genreLabel at 1,3 span 3 for genre
                dropdown name genre at 4,3 span 9 bind album.genre
                label @yearLabel name yearLabel at 1,4 span 3 for year
                number name year at 4,4 span 3 bind album.year
                label @formatLabel name formatLabel at 1,5 span 3 for format
                radio name format at 4,5 span 9 bind album.format vertical rows 3
                label @recordLabelLabel name recordLabelLabel at 1,8 span 3 for recordLabel
                dropdown name recordLabel at 4,8 span 9 bind album.record_label typed
                label @tagsLabel name tagsLabel at 1,9 span 3 for tags
                tags name tags at 4,9 span 9 bind album.tags
        pane
            tabs name albumTabs at 1,1 span 12 rows 9
                tab @albumFormTracksTab
                    table name trackGrid at 1,1 span 12 rows 6 bind tracks columns number, title, length on open: trackOpened
                    label name length at 1,7 span 9
                    button @addTrackCaption name addTrack at 10,7 span 3 on click: addTrackClicked
                tab @albumFormPurchaseTab
                    label @boughtOnLabel name boughtOnLabel at 1,1 span 3 for boughtOn
                    date name boughtOn at 4,1 span 4 bind album.bought_on
                    label @priceLabel name priceLabel at 1,2 span 3 for price
                    number name price at 4,2 span 4 bind album.price
                    label @ratingLabel name ratingLabel at 1,3 span 3 for rating
                    slider name rating at 4,3 span 5 bind album.rating
                    help name ratingHelp at 9,3 span 4 for rating
                    label @bookletLabel name bookletLabel at 1,4 span 3 for booklet
                    file name booklet at 4,4 span 9 bind album.booklet
                tab @albumFormCoverTab
                    image name cover at 1,1 span 12 rows 6 bind album.cover
                    help name coverHelp at 1,7 span 12 for cover
                tab @albumFormNotesTab
                    memo name albumNotes at 1,1 span 12 rows 7 bind album.notes
    button @saveCaption name save at 9,11 span 2 style primary key "Ctrl+S" default on click: saveClicked
    button @closeCaption name closeAlbum at 11,11 span 2 cancel on click -> close

// One track, in a dialog over the album.
page TrackDialog: dialog
    title @trackDialogTitle
    data album: Album
    data track: Track

    label @numberLabel name numberLabel at 1,1 span 3 for number
    number name number at 4,1 span 2 bind track.number
    label @titleLabel name titleLabel at 1,2 span 3 for title
    textbox name title at 4,2 span 9 bind track.title
    label @lengthLabel name lengthLabel at 1,3 span 3 for length
    number name length at 4,3 span 3 bind track.length placeholder "3:45"
    button @deleteButtonCaption name deleteButton at 1,5 span 2 on click: deleteClicked
    button @saveCaption name saveTrack at 9,5 span 2 style primary default on click: saveClicked
    button @cancelCaption name cancelTrack at 11,5 span 2 cancel on click -> close

page ArtistBrowse: window
    title @artistBrowseTitle
    data artists: list<Artist>
    on return: windowReturned

    label @nameFilterLabel name nameFilterLabel at 1,1 span 2 for nameFilter
    textbox name nameFilter at 3,1 span 10 on change: filterChanged
    list name artistList at 1,2 span 12 rows 8 bind artists show name, country, formed on open: openClicked
    button @findPhotosCaption name findPhotos at 1,10 span 2 on click: photosClicked
    button @backUpPhotosCaption name backUpPhotos at 3,10 span 2 on click: backupClicked
    button @newArtistCaption name newArtist at 9,10 span 2 on click -> ArtistForm
    button @openCaption name openArtist at 11,10 span 2 on click: openClicked

page ArtistForm: window
    title @artistFormTitle
    data artist: Artist

    image name photo at 10,1 span 3 rows 4 bind artist.photo
    form name artistForm at 1,1 span 9 rows 4 bind artist
        label @nameLabel name nameLabel at 1,1 span 3 for name
        textbox name name at 4,1 span 6 bind artist.name
        label @countryLabel name countryLabel at 1,2 span 3 for country
        dropdown name country at 4,2 span 6 bind artist.country typed
        label @formedLabel name formedLabel at 1,3 span 3 for formed
        number name formed at 4,3 span 2 bind artist.formed
        label @websiteLabel name websiteLabel at 1,4 span 3 for website
        textbox name website at 4,4 span 6 bind artist.website placeholder @websitePlaceholder
    button @saveCaption name saveArtist at 9,6 span 2 style primary default on click: saveClicked
    button @closeCaption name closeArtist at 11,6 span 2 cancel on click -> close

page GenreBrowse: window
    title @genreBrowseTitle
    data genres: list<Genre>
    on return: windowReturned

    treetable name genreTree at 1,1 span 10 rows 8 bind genres children children columns name on open: openClicked
    button @newGenreCaption name newGenre at 11,1 span 2 on click -> GenreDialog
    button @openCaption name openGenre at 11,2 span 2 on click: openClicked

// The collection at a glance: what it is on, when it is from, where the money went.
page CollectionOverview: window
    title @collectionOverviewTitle
    data albums: list<Album>
    on open: overviewOpened
    on return: overviewOpened

    heading @albumsPerFormatHeading name albumsPerFormatHeading at 1,1 span 6
    heading @albumsPerYearHeading name albumsPerYearHeading at 7,1 span 6
    chart bar name formatChart at 1,2 span 6 rows 6 bind albums by format count
    chart line name yearChart at 7,2 span 6 rows 6 bind albums by year count
    heading @spentPerGenreHeading name spentPerGenreHeading at 1,8 span 12
    chart pie name genreChart at 1,9 span 12 rows 6 bind albums by genre sum price

page GenreDialog: dialog
    title @genreDialogTitle
    data genre: Genre

    label @nameLabel name nameLabel at 1,1 span 3 for name
    textbox name name at 4,1 span 9 bind genre.name
    label @parentLabel name parentLabel at 1,2 span 3 for parent
    dropdown name parent at 4,2 span 9 bind genre.parent
    help name parentHelp at 4,3 span 9 for parent
    button @saveCaption name saveGenre at 9,5 span 2 style primary default on click: saveClicked
    button @cancelCaption name cancelGenre at 11,5 span 2 cancel on click -> close

code AlbumBrowse
    handler windowReturned
        filterChanged()

    handler filterChanged
        albums = find a in Album where a.title contains titleFilter.text or a.artist.name contains titleFilter.text order by a.artist.name, a.title

    handler openClicked
        open AlbumForm with album = grid.selected

    handler exportClicked
        export_collection()
        message @savedTheListInCollection

code AlbumForm
    handler albumOpened
        tracks = find t in Track where t.album == album order by t.number
        let total = total_length(tracks)
        let count = count(tracks)
        length.caption = @countTracksTotal(count = count, total = total)

    handler trackOpened
        open TrackDialog with album = album, track = trackGrid.selected

    handler addTrackClicked
        if album.title == ""
            message warning @saveTheAlbumBeforeAdding
            return
        save album
        open TrackDialog with album = album

    handler saveClicked
        title.error = ""
        if album.title == ""
            title.error = @anAlbumNeedsATitle
            return
        save album
        message @savedTitle(title = album.title)
        close

code TrackDialog
    handler saveClicked
        title.error = ""
        if track.title == ""
            title.error = @aTrackNeedsATitle
            return
        track.album = album
        save track
        close

    handler deleteClicked
        delete track
        close

code ArtistBrowse
    handler windowReturned
        filterChanged()

    handler filterChanged
        artists = find a in Artist where a.name contains nameFilter.text order by a.name

    handler openClicked
        open ArtistForm with artist = artistList.selected

    handler photosClicked
        find_artist_photos()
        filterChanged()

    handler backupClicked
        back_up_photos()
        message @copiedThePhotosToThe

code ArtistForm
    handler saveClicked
        name.error = ""
        if artist.name == ""
            name.error = @anArtistNeedsAName
            return
        save artist
        message @savedName(name = artist.name)
        close

code GenreBrowse
    handler windowReturned
        reload genres

    handler openClicked
        open GenreDialog with genre = genreTree.selected

code CollectionOverview
    handler overviewOpened
        albums = find a in Album

code GenreDialog
    handler saveClicked
        name.error = ""
        if genre.name == ""
            name.error = @aGenreNeedsAName
            return
        save genre
        close

code Track
    before save
        if track.length > 7200
            refuse @trackNumberIsLongerThan(number = track.number)

code Genre
    before delete
        let below = find g in Genre where g.parent == genre
        if count(below) > 0
            refuse @nameStillHasGenresBelow(name = genre.name)
