module records

use music
use loans

// The application frame, shared by every window.
app Records
    title @recordsTitle
    main AlbumBrowse
    menu name mainMenu
        item @fileItem name fileItem
            item @albumsItem name albumsItem key "Ctrl+1" on click -> AlbumBrowse
            item @newAlbumItem name newAlbumItem key "Ctrl+N" on click -> AlbumForm
            separator
            item @languageItem name languageItem on click -> language
            item @themeItem name themeItem on click -> theme
            item @quitItem name quitItem key "Ctrl+Q" on click -> quit
        item @collectionItem name collectionItem
            item @artistsItem name artistsItem on click -> ArtistBrowse
            item @genresItem name genresItem on click -> GenreBrowse
            item @overviewItem name overviewItem on click -> CollectionOverview
        item @loansItem name loansItem
            item @onLoanItem name onLoanItem on click -> LoanBrowse
            item @friendsItem name friendsItem on click -> FriendBrowse
    toolbar name mainToolbar
        button @albums2Caption name albums2 on click -> AlbumBrowse
        button @artists2Caption name artists2 on click -> ArtistBrowse
        separator
        button @onLoan2Caption name onLoan2 on click -> LoanBrowse
    footer
        status @recordsStatus

// Grey and square, like a desktop program of 2003.
theme Classic
    title @classicTheme
    mode light
    color background "#d4d0c8"
    color panel "#ece9d8"
    color raised "#f1efe2"
    color frame "#d4d0c8"
    color accent "#0a246a"
    color accent_soft "#c1d2ee"
    color selection "#316ac5"
    color border "#aca899"
    color strong_border "#716f64"
    font "Tahoma, Verdana, sans-serif"
    size 12
    size heading 16
    radius 0
    padding 3
    shadow none
    part button background raised, border strong_border
    part button hover background accent_soft
    part header background frame, text text, weight bold
    style primary background accent, text "#ffffff", border accent

// The music player look: dark, with a green display.
theme Midnight
    title @midnightTheme
    mode dark
    color accent "#2fd25a"
    color accent_soft "#1d3a25"
    font mono "Lucida Console, monospace"
    radius 2
    style primary background accent, text "#0b0b0b", border accent, weight bold
