// The shop example: customers and their orders, with browse windows, editors,
// a customer card, a sales dashboard and a supplier price list kept in a CSV
// file, in five modules and a window or view per file in design/, in the shop
// folder next to this file.
project Shop
    stack rust desktop
    language "en"
    currency EUR
    theme Shop Night Day
    signin Clerk on desktop
        password name passwordHash
            minimum 8
        account name
        language picker
        remember 30 days when asked
    datasource main sqlite "data/shop.db"
    datasource prices csv "data/prices.csv" external
        separator ";"
