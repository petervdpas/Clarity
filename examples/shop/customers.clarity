module customers

enum CustomerKind
    Private label "Private person"
    Business

entity Customer
    name: text(80), required, label "Name"
    email: email, unique, label "E-mail"
    kind: CustomerKind, default Private
    vat_number: text(14), help "Only for business customers"
    credit_limit: money, min 0, default 0
    active: bool, default true
    since: date
    notes: text, help "Internal notes, not shown to the customer"

page CustomerBrowse: window
    title "Customers"
    data customers: list<Customer>
    on return: window_returned

    label "Name" at 1,1 span 2 for name_filter
    textbox name name_filter at 3,1 span 4 placeholder "Part of the name" on change: filter_changed
    label "E-mail" at 7,1 span 2 for email_filter
    textbox name email_filter at 9,1 span 4 on change: filter_changed
    table name grid at 1,2 span 12 rows 8 bind customers columns name, email, kind, credit_limit, active on open: open_clicked
    button "New" at 9,10 span 2 on click -> CustomerForm
    button "Open" name open_button at 11,10 span 2 on click: open_clicked

page CustomerForm: window
    title "Customer"
    data customer: Customer

    form name customer_form at 1,1 span 12 rows 7 bind customer
        tabs at 1,1 span 12 rows 7
            tab "General"
                panel "Identity" at 1,1 span 12 rows 6
                    label "Name" at 1,1 span 3 for name
                    textbox name name at 4,1 span 6 bind customer.name placeholder "Full name"
                    help at 10,1 span 3 for name
                    label "Kind" at 1,2 span 3 for kind
                    radio name kind at 4,2 span 6 bind customer.kind on change: kind_changed
                    label "E-mail" at 1,3 span 3 for email
                    textbox name email at 4,3 span 6 bind customer.email placeholder "name@example.com"
                    label "Since" at 1,4 span 3 for since
                    date name since at 4,4 span 3 bind customer.since
                    label "Active" at 1,5 span 3 for active
                    switch name active at 4,5 span 3 bind customer.active
            tab "Finance"
                panel "Credit" at 1,1 span 12 rows 3
                    label "Credit limit" at 1,1 span 3 for credit_limit
                    number name credit_limit at 4,1 span 3 bind customer.credit_limit
                    label "Vat number" at 1,2 span 3 for vat_number
                    textbox name vat_number at 4,2 span 4 bind customer.vat_number
                    help at 8,2 span 5 for vat_number
            tab "Notes"
                label "Notes" at 1,1 span 3 for notes
                memo name notes at 4,1 span 9 rows 4 bind customer.notes
                help at 4,5 span 9 for notes
    button "Save" name save at 9,9 span 2 tooltip "Save and close (Ctrl+S)" key "Ctrl+S" default on click: save_clicked
    button "Close" name close_form at 11,9 span 2 cancel on click: close_clicked

code CustomerBrowse
    handler window_returned
        // A form opened from here may have saved a customer.
        filter_changed()

    handler filter_changed
        customers = find c in Customer where c.name contains name_filter.text and c.email contains email_filter.text order by c.name

    handler open_clicked
        open CustomerForm with customer = grid.selected

code CustomerForm
    handler kind_changed
        // Only business customers have a VAT number.
        vat_number.enabled = customer.kind == Business

    handler save_clicked
        // Problems show at the input they are about.
        name.error = ""
        vat_number.error = ""
        if customer.name == ""
            name.error = "Name is required"
            return
        if customer.kind == Business and customer.vat_number == ""
            vat_number.error = "Needed for business customers"
            message warning "A business customer needs a VAT number (Finance tab)"
            return
        save customer
        message "Saved " + customer.name
        close

    handler close_clicked
        close

// Data events run whenever a customer is saved or deleted, from any window
// or action.
code Customer
    before save
        if customer.kind == Private and customer.credit_limit > 1000
            refuse "A private customer's credit limit is at most 1000"
