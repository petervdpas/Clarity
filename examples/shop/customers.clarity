module customers

enum CustomerKind
    Private label "Private person"
    Business

entity Customer
    name: text(80), required, label "Name"
    email: email, unique, label "E-mail"
    kind: CustomerKind, default Private
    vat_number: text(14), help "Only for business customers"
    credit_limit: money, min 0, default 0
    active: bool, default true
    since: date
    notes: text, help "Internal notes, not shown to the customer"

page CustomerBrowse: window
    title "Customers"
    data customers: list<Customer>
    on return: window_returned

    label "Name" at 1,1 span 2
    textbox at 3,1 span 4
    label "E-mail" at 7,1 span 2
    textbox at 9,1 span 4
    table name grid at 1,2 span 12 rows 8 bind customers columns name, email, kind, credit_limit, active on open: open_clicked
    button "New" at 9,10 span 2 on click -> CustomerForm
    button "Open" name open_button at 11,10 span 2 on click: open_clicked

page CustomerForm: window
    title "Customer"
    data customer: Customer

    tabs at 1,1 span 12 rows 6
        tab "General"
            panel "Identity" at 1,1 span 12 rows 4
                label "Name" at 1,1 span 3
                textbox at 4,1 span 6 bind customer.name
                label "Kind" at 1,2 span 3
                dropdown name kind at 4,2 span 4 bind customer.kind on change: kind_changed
                label "E-mail" at 1,3 span 2
                textbox at 3,3 span 4 bind customer.email
                label "Since" at 7,3 span 2
                date at 9,3 span 3 bind customer.since
            label "Active" at 1,5 span 3
            checkbox at 4,5 span 3 bind customer.active
        tab "Finance"
            panel "Credit" at 1,1 span 12 rows 3
                label "Credit limit" at 1,1 span 3
                number at 4,1 span 3 bind customer.credit_limit
                label "Vat number" at 1,2 span 3
                textbox name vat_number at 4,2 span 4 bind customer.vat_number
        tab "Notes"
            label "Notes" at 1,1 span 3
            textbox at 4,1 span 6 bind customer.notes
    button "Save" name save at 9,8 span 2 on click: save_clicked
    button "Close" name close_form at 11,8 span 2 on click: close_clicked

code CustomerBrowse
    handler window_returned
        // A form opened from here may have saved a customer.
        reload customers

    handler open_clicked
        open CustomerForm with customer = grid.selected

code CustomerForm
    handler kind_changed
        // Only business customers have a VAT number.
        vat_number.enabled = customer.kind == Business

    handler save_clicked
        if customer.name == ""
            message error "Name is required"
            return
        if customer.kind == Business and customer.vat_number == ""
            message warning "A business customer needs a VAT number"
            return
        save customer
        message "Saved " + customer.name
        close

    handler close_clicked
        close
