module customers

enum CustomerKind
    Private label "Private person"
    Business

entity Customer
    name: text(80), required, label "Name"
    email: email, unique, label "E-mail"
    kind: CustomerKind, default Private
    vat_number: text(14), help "Only for business customers"
    credit_limit: money, min 0, default 0
    active: bool, default true
    since: date
    notes: text, help "Internal notes, not shown to the customer"

page CustomerBrowse: window
    title "Customers"
    data customers: list<Customer>
    on return: windowReturned

    label "Name" name label1 at 1,1 span 2 for nameFilter
    textbox name nameFilter at 3,1 span 4 placeholder "Part of the name" on change: filterChanged
    label "E-mail" name label2 at 7,1 span 2 for emailFilter
    textbox name emailFilter at 9,1 span 4 on change: filterChanged
    table name grid at 1,2 span 12 rows 8 bind customers columns name, email, kind, credit_limit, active on open: openClicked
    button "New" name button1 at 9,10 span 2 on click -> CustomerForm
    button "Open" name openButton at 11,10 span 2 on click: openClicked

page CustomerForm: window
    title "Customer"
    data customer: Customer

    form name customerForm at 1,1 span 12 rows 7 bind customer
        tabs name tabs1 at 1,1 span 12 rows 7
            tab "General"
                panel "Identity" name panel1 at 1,1 span 12 rows 6
                    label "Name" name label1 at 1,1 span 3 for name
                    textbox name name at 4,1 span 6 bind customer.name placeholder "Full name"
                    help name help1 at 10,1 span 3 for name
                    label "Kind" name label2 at 1,2 span 3 for kind
                    radio name kind at 4,2 span 6 bind customer.kind on change: kindChanged
                    label "E-mail" name label3 at 1,3 span 3 for email
                    textbox name email at 4,3 span 6 bind customer.email placeholder "name@example.com"
                    label "Since" name label4 at 1,4 span 3 for since
                    date name since at 4,4 span 3 bind customer.since
                    label "Active" name label5 at 1,5 span 3 for active
                    switch name active at 4,5 span 3 bind customer.active
            tab "Finance"
                panel "Credit" name panel2 at 1,1 span 12 rows 3 foldable
                    label "Credit limit" name label6 at 1,1 span 3 for creditLimit
                    number name creditLimit at 4,1 span 3 bind customer.credit_limit
                    label "Vat number" name label7 at 1,2 span 3 for vatNumber
                    textbox name vatNumber at 4,2 span 4 bind customer.vat_number
                    help name help2 at 8,2 span 5 for vatNumber
            tab "Notes"
                label "Notes" name label8 at 1,1 span 3 for notes
                memo name notes at 4,1 span 9 rows 4 bind customer.notes
                help name help3 at 4,5 span 9 for notes
    button "Save" name save at 9,9 span 2 tooltip "Save and close (Ctrl+S)" style primary key "Ctrl+S" default on click: saveClicked
    button "Close" name closeForm at 11,9 span 2 cancel on click: closeClicked

code CustomerBrowse
    handler windowReturned
        // A form opened from here may have saved a customer.
        filterChanged()

    handler filterChanged
        customers = find c in Customer where c.name contains nameFilter.text and c.email contains emailFilter.text order by c.name

    handler openClicked
        open CustomerForm with customer = grid.selected

code CustomerForm
    handler kindChanged
        // Only business customers have a VAT number.
        vatNumber.enabled = customer.kind == Business

    handler saveClicked
        // Problems show at the input they are about.
        name.error = ""
        vatNumber.error = ""
        if customer.name == ""
            name.error = "Name is required"
            return
        if customer.kind == Business and customer.vat_number == ""
            vatNumber.error = "Needed for business customers"
            message warning "A business customer needs a VAT number (Finance tab)"
            return
        save customer
        message "Saved {customer.name}"
        close

    handler closeClicked
        close

// Data events run whenever a customer is saved or deleted, from any window
// or action.
code Customer
    before save
        if customer.kind == Private and customer.credit_limit > 1000
            refuse "A private customer's credit limit is at most 1000"
