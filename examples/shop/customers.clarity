module customers

enum CustomerKind
    Private label @customerKindPrivate
    Business label @customerKindBusiness

entity Customer
    name: text(80), required, label @customerNameLabel
    email: email, unique, label @customerEmailLabel
    kind: CustomerKind, default Private, label @customerKindLabel
    vat_number: text(14), help @customerVatNumberHelp, label @customerVatNumberLabel
    credit_limit: money, min 0, default 0, label @customerCreditLimitLabel
    active: bool, default true, label @customerActiveLabel
    since: date, label @customerSinceLabel
    notes: text, help @customerNotesHelp, label @customerNotesLabel
    tags: list<text>, label @customerTagsLabel
    contract: file, label @customerContractLabel

page CustomerBrowse: window
    title @customerBrowseTitle
    data customers: list<Customer>
    on return: windowReturned

    label @nameFilterLabel name nameFilterLabel at 1,1 span 2 for nameFilter
    textbox name nameFilter at 3,1 span 4 placeholder @nameFilterPlaceholder on change: filterChanged
    label @emailFilterLabel name emailFilterLabel at 7,1 span 2 for emailFilter
    textbox name emailFilter at 9,1 span 4 on change: filterChanged
    table name grid at 1,2 span 12 rows 8 bind customers columns name, email, kind, credit_limit, active, tags sortable page 20 on open: openClicked
    button @newCaption name newCustomer at 9,10 span 2 on click -> CustomerForm
    button @openButtonCaption name openButton at 11,10 span 2 on click: openClicked

page CustomerForm: window
    title @customerFormTitle
    data customer: Customer

    form name customerForm at 1,1 span 12 rows 8 bind customer
        tabs name customerTabs at 1,1 span 12 rows 8
            tab @customerFormGeneralTab
                panel @identityPanelCaption name identityPanel at 1,1 span 12 rows 7
                    label @nameLabel name nameLabel at 1,1 span 3 for name
                    textbox name name at 4,1 span 6 bind customer.name placeholder @namePlaceholder
                    help name nameHelp at 10,1 span 3 for name
                    label @kindLabel name kindLabel at 1,2 span 3 for kind
                    radio name kind at 4,2 span 6 bind customer.kind on change: kindChanged
                    label @emailLabel name emailLabel at 1,3 span 3 for email
                    textbox name email at 4,3 span 6 bind customer.email placeholder @emailPlaceholder
                    label @sinceLabel name sinceLabel at 1,4 span 3 for since
                    date name since at 4,4 span 3 bind customer.since
                    label @activeLabel name activeLabel at 1,5 span 3 for active
                    switch name active at 4,5 span 3 bind customer.active
                    label @tagsLabel name tagsLabel at 1,6 span 3 for tags
                    tags name tags at 4,6 span 9 bind customer.tags
            tab @customerFormFinanceTab
                panel @creditPanelCaption name creditPanel at 1,1 span 12 rows 3 foldable
                    label @creditLimitLabel name creditLimitLabel at 1,1 span 3 for creditLimit
                    number name creditLimit at 4,1 span 3 bind customer.credit_limit
                    label @vatNumberLabel name vatNumberLabel at 1,2 span 3 for vatNumber
                    textbox name vatNumber at 4,2 span 4 bind customer.vat_number
                    help name vatNumberHelp at 8,2 span 5 for vatNumber
                label @contractLabel name contractLabel at 1,5 span 3 for contract
                file name contract at 4,5 span 9 bind customer.contract
            tab @customerFormNotesTab
                label @notesLabel name notesLabel at 1,1 span 3 for notes
                memo name notes at 4,1 span 9 rows 4 bind customer.notes
                help name notesHelp at 4,5 span 9 for notes
    button @saveCaption name save at 9,10 span 2 tooltip @saveTooltip style primary key "Ctrl+S" default on click: saveClicked
    button @closeFormCaption name closeForm at 11,10 span 2 cancel on click: closeClicked

code CustomerBrowse
    handler windowReturned
        // A form opened from here may have saved a customer.
        filterChanged()

    handler filterChanged
        customers = find c in Customer where c.name contains nameFilter.text and c.email contains emailFilter.text order by c.name

    handler openClicked
        open CustomerForm with customer = grid.selected

code CustomerForm
    handler kindChanged
        // Only business customers have a VAT number.
        vatNumber.enabled = customer.kind == Business

    handler saveClicked
        // Problems show at the input they are about.
        name.error = ""
        vatNumber.error = ""
        if customer.name == ""
            name.error = @nameIsRequired
            return
        if customer.kind == Business and customer.vat_number == ""
            vatNumber.error = @neededForBusinessCustomers
            message warning @aBusinessCustomerNeedsA
            return
        save customer
        message @savedName(name = customer.name)
        close

    handler closeClicked
        close

// Data events run whenever a customer is saved or deleted, from any window
// or action.
code Customer
    before save
        if customer.kind == Private and customer.credit_limit > 1000
            refuse @aPrivateCustomerSCredit
