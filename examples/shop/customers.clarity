module customers

enum CustomerKind
    Private label @customerKindPrivate
    Business label @customerKindBusiness

entity Customer
    name: text(80), required, search, label @customerNameLabel
    email: email, unique, search, label @customerEmailLabel
    kind: CustomerKind, default Private, label @customerKindLabel
    vatNumber: text(14), help @customerVatNumberHelp, label @customerVatNumberLabel
    creditLimit: money, min 0, default 0, label @customerCreditLimitLabel
    active: bool, default true, label @customerActiveLabel
    since: date, label @customerSinceLabel
    notes: text, search, help @customerNotesHelp, label @customerNotesLabel
    tags: list<text>, search, label @customerTagsLabel
    contract: file, label @customerContractLabel

code CustomerBrowse
    handler filterChanged
        // Every word typed, at the start of a word of the name, e-mail, notes or tags.
        customers = find c in Customer where c matches searchBox.text order by c.name

code CustomerBrowseView
    handler openClicked
        customer = grid.selected
        vatNumber.enabled = customer.kind == Business
        customerPanel.visible = true

    handler newClicked
        customer = new Customer
        vatNumber.enabled = false
        customerPanel.visible = true

    handler removeClicked
        delete grid.selected
        customerPanel.visible = false
        filterChanged()

code CustomerEditor
    handler kindChanged
        // Only business customers have a VAT number.
        vatNumber.enabled = customer.kind == Business

    handler saveClicked
        // Problems show at the input they are about.
        name.error = ""
        vatNumber.error = ""
        if customer.name == ""
            name.error = @nameIsRequired
            return
        if customer.kind == Business and customer.vatNumber == ""
            vatNumber.error = @neededForBusinessCustomers
            message warning @aBusinessCustomerNeedsA
            return
        save customer
        tell saved()
        message @savedName(name = customer.name)

// Data events run whenever a customer is saved or deleted, from any window
// or action.
code Customer
    before save
        if customer.kind == Private and customer.creditLimit > 1000
            refuse @aPrivateCustomerSCredit
