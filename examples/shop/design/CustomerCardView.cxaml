<?xml version="1.0" encoding="UTF-8"?>
<!-- What the window CustomerCard shows: its parts, data and code. -->
<View class="counter.CustomerCardView">
  <Data name="customer" type="Customer" />
  <Data name="orders" type="list&lt;Order&gt;" />
  <Label name="nameLabel" at="1,1" span="2" caption="@nameLabel" />
  <Textbox name="customerName" at="3,1" span="6" bind="customer.name" />
  <Label name="kindLabel" at="1,2" span="2" caption="@kindLabel" />
  <Dropdown name="customerKind" at="3,2" span="4" bind="customer.kind" />
  <Checkbox name="customerActive" at="7,2" span="3" caption="@activeLabel" bind="customer.active" />
  <Label name="creditLimitLabel" at="1,3" span="2" caption="@creditLimitLabel" />
  <Number name="creditLimit" at="3,3" span="3" bind="customer.creditLimit" />
  <Image name="shopLogo" at="10,1" span="3" rows="3" source="logo.png" />
  <Tabs name="cardTabs" at="1,5" span="12" rows="7">
    <Tab title="@customerCardOrdersTab">
      <Table name="ordersTable" at="1,1" span="12" rows="5" bind="orders" columns="number, orderedOn, status, total" />
    </Tab>
    <Tab title="@customerCardNotesTab">
      <Text name="notesText" at="1,1" span="12" bind="customer.notes" />
    </Tab>
  </Tabs>
  <Button name="allCustomers" at="1,13" span="3" caption="@allCustomersCaption" opens="CustomerBrowse" />
  <Button name="closeCard" at="11,13" span="2" caption="@closeCaption" opens="CustomerBrowse" />
</View>
