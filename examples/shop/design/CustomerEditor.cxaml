<?xml version="1.0" encoding="UTF-8"?>
<!-- A customer: who they are, their money, and notes. -->
<View class="customers.CustomerEditor">
  <Data name="customer" type="Customer" />
  <Tells message="saved" />
  <Form name="customerForm" at="1,1" span="12" rows="8" bind="customer">
    <Tabs name="customerTabs" at="1,1" span="12" rows="8">
      <Tab title="@customerFormGeneralTab">
        <Panel name="identityPanel" at="1,1" span="12" rows="7" caption="@identityPanelCaption">
          <Label name="nameLabel" at="1,1" span="3" caption="@nameLabel" for="name" />
          <Textbox name="name" at="4,1" span="6" bind="customer.name" placeholder="@namePlaceholder" />
          <Help name="nameHelp" at="10,1" span="3" for="name" />
          <Label name="kindLabel" at="1,2" span="3" caption="@kindLabel" for="kind" />
          <Radio name="kind" at="4,2" span="6" bind="customer.kind" none="orientation" onchange="kindChanged" />
          <Label name="emailLabel" at="1,3" span="3" caption="@emailLabel" for="email" />
          <Textbox name="email" at="4,3" span="6" bind="customer.email" placeholder="@emailPlaceholder" />
          <Label name="sinceLabel" at="1,4" span="3" caption="@sinceLabel" for="since" />
          <Date name="since" at="4,4" span="3" bind="customer.since" />
          <Label name="activeLabel" at="1,5" span="3" caption="@activeLabel" for="active" />
          <Switch name="active" at="4,5" span="3" bind="customer.active" none="caption" />
          <Label name="tagsLabel" at="1,6" span="3" caption="@tagsLabel" for="tags" />
          <Tags name="tags" at="4,6" span="9" bind="customer.tags" />
        </Panel>
      </Tab>
      <Tab title="@customerFormFinanceTab">
        <Panel name="creditPanel" at="1,1" span="12" rows="3" caption="@creditPanelCaption" foldable="true">
          <Label name="creditLimitLabel" at="1,1" span="3" caption="@creditLimitLabel" for="creditLimit" />
          <Number name="creditLimit" at="4,1" span="3" bind="customer.creditLimit" />
          <Label name="vatNumberLabel" at="1,2" span="3" caption="@vatNumberLabel" for="vatNumber" />
          <Textbox name="vatNumber" at="4,2" span="4" bind="customer.vatNumber" />
          <Help name="vatNumberHelp" at="8,2" span="5" for="vatNumber" />
        </Panel>
        <Label name="contractLabel" at="1,5" span="3" caption="@contractLabel" for="contract" />
        <File name="contract" at="4,5" span="9" bind="customer.contract" />
      </Tab>
      <Tab title="@customerFormNotesTab">
        <Label name="notesLabel" at="1,1" span="3" caption="@notesLabel" for="notes" />
        <Memo name="notes" at="4,1" span="9" rows="4" bind="customer.notes" />
        <Help name="notesHelp" at="4,5" span="9" for="notes" />
      </Tab>
    </Tabs>
  </Form>
  <Button name="save" at="11,9" span="2" caption="@saveCaption" tooltip="@saveTooltip" style="primary" key="Ctrl+S" default="true" onclick="saveClicked" />
</View>
