<!-- How sales go: orders by status, money per day, and who spends it. -->
<Window class="sales.SalesDashboard" title="@salesDashboardTitle" onopen="dashboardOpened" onreturn="dashboardOpened">
  <Content name="main" at="1,1" span="12" rows="14">
    <View name="SalesDashboardView" />
  </Content>
</Window>
