<?xml version="1.0" encoding="UTF-8"?>
<View class="suppliers.SupplierEditorView">
  <Data name="supplier" type="Supplier" />
  <Form name="supplierForm" at="1,1" span="12" rows="4" bind="supplier">
    <Label name="nameLabel" at="1,1" span="3" caption="@supplierNameLabel" for="name" />
    <Textbox name="name" at="4,1" span="9" bind="supplier.name" />
    <Label name="emailLabel" at="1,2" span="3" caption="@supplierEmailLabel" for="email" />
    <Textbox name="email" at="4,2" span="9" bind="supplier.email" />
    <Label name="phoneLabel" at="1,3" span="3" caption="@supplierPhoneLabel" for="phone" />
    <Textbox name="phone" at="4,3" span="9" bind="supplier.phone" />
    <Label name="websiteLabel" at="1,4" span="3" caption="@supplierWebsiteLabel" for="website" />
    <Textbox name="website" at="4,4" span="9" bind="supplier.website" />
  </Form>
  <Button name="saveSupplier" at="9,5" span="2" caption="@saveCaption" default="true" onclick="saveClicked" />
  <Button name="closeEditor" at="11,5" span="2" caption="@closeCaption" cancel="true" onclick="closeClicked" />
</View>
