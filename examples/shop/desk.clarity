module desk

use customers
use sales

// A widget-first page: placed on a 12-column snap grid.
page CustomerCard: window
    title @customerCardTitle
    data customer: Customer
    data orders: list<Order>

    label @nameLabel name nameLabel at 1,1 span 2
    textbox name customerName at 3,1 span 6 bind customer.name
    label @kindLabel name kindLabel at 1,2 span 2
    dropdown name customerKind at 3,2 span 4 bind customer.kind
    checkbox @activeLabel name customerActive at 7,2 span 3 bind customer.active
    label @creditLimitLabel name creditLimitLabel at 1,3 span 2
    number name creditLimit at 3,3 span 3 bind customer.credit_limit
    image name shopLogo at 10,1 span 3 rows 3 source "logo.png"
    tabs name cardTabs at 1,5 span 12 rows 7
        tab @customerCardOrdersTab
            table name ordersTable at 1,1 span 12 rows 5 bind orders columns number, ordered_on, status, total
        tab @customerCardNotesTab
            text name notesText at 1,1 span 12 bind customer.notes
    button @allCustomersCaption name allCustomers at 1,13 span 3 on click -> CustomerBrowse
    button @closeCaption name closeCard at 11,13 span 2 on click -> CustomerBrowse
