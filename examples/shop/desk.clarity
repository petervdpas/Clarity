module desk

use customers
use sales

// A widget-first page: placed on a 12-column snap grid.
page CustomerCard: window
    title "Customer card"
    data customer: Customer
    data orders: list<Order>

    label "Name" at 1,1 span 2
    textbox at 3,1 span 6 bind customer.name
    label "Kind" at 1,2 span 2
    dropdown at 3,2 span 4 bind customer.kind
    checkbox "Active" at 7,2 span 3 bind customer.active
    label "Credit limit" at 1,3 span 2
    number at 3,3 span 3 bind customer.credit_limit
    image at 10,1 span 3 rows 3 source "logo.png"
    tabs at 1,5 span 12 rows 7
        tab "Orders"
            table at 1,1 span 12 rows 5 bind orders columns number, ordered_on, status, total
        tab "Notes"
            text at 1,1 span 12 bind customer.notes
    button "All customers" at 1,13 span 3 on click -> CustomerBrowse
    button "Close" at 11,13 span 2 on click -> CustomerBrowse
