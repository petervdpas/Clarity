module desk

use customers
use sales

// A widget-first page: placed on a 12-column snap grid.
page CustomerCard: window
    title "Customer card"
    data customer: Customer
    data orders: list<Order>

    label "Name" name label1 at 1,1 span 2
    textbox name textbox1 at 3,1 span 6 bind customer.name
    label "Kind" name label2 at 1,2 span 2
    dropdown name dropdown1 at 3,2 span 4 bind customer.kind
    checkbox "Active" name checkbox1 at 7,2 span 3 bind customer.active
    label "Credit limit" name label3 at 1,3 span 2
    number name number1 at 3,3 span 3 bind customer.credit_limit
    image name image1 at 10,1 span 3 rows 3 source "logo.png"
    tabs name tabs1 at 1,5 span 12 rows 7
        tab "Orders"
            table name table1 at 1,1 span 12 rows 5 bind orders columns number, ordered_on, status, total
        tab "Notes"
            text name text1 at 1,1 span 12 bind customer.notes
    button "All customers" name button1 at 1,13 span 3 on click -> CustomerBrowse
    button "Close" name button2 at 11,13 span 2 on click -> CustomerBrowse
