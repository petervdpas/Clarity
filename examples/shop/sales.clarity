module sales

use customers

enum OrderStatus
    Pending
    Approved
    Shipped
    Cancelled

entity Order
    number: text(12), unique, required, pattern "^ORD-[0-9]{8}$"
    customer: ref Customer, required
    status: OrderStatus, default Pending
    ordered_on: date, required
    total: money, computed
    remarks: text(200)

page OrderBrowse: window
    title "Orders"
    data orders: list<Order>

    label "Number" at 1,1 span 2
    textbox at 3,1 span 4
    label "Customer" at 7,1 span 2
    textbox at 9,1 span 4
    label "Status" at 1,2 span 2
    textbox at 3,2 span 4
    table at 1,3 span 12 rows 8 bind orders columns number, customer, ordered_on, status, total
    button "New" at 9,11 span 2 on click -> OrderForm
    button "Open" at 11,11 span 2 on click -> OrderForm

page OrderForm: window
    title "Order"
    data order: Order

    panel "Order" at 1,1 span 12 rows 4
        label "Number" at 1,1 span 2
        textbox at 3,1 span 4 bind order.number
        label "Ordered on" at 7,1 span 2
        date at 9,1 span 3 bind order.ordered_on
        label "Customer" at 1,2 span 3
        dropdown at 4,2 span 4 bind order.customer
        label "Status" at 1,3 span 3
        dropdown at 4,3 span 4 bind order.status
    panel "Amounts" at 1,5 span 12 rows 2
        label "Total" at 1,1 span 3
        number at 4,1 span 3 bind order.total
    label "Remarks" at 1,7 span 3
    textbox at 4,7 span 6 bind order.remarks
    button "Approve" name approve_button at 7,9 span 2 on click: approve_clicked
    button "Save" at 9,9 span 2
    button "Close" at 11,9 span 2

function within_credit(order: Order) -> bool
    return order.total <= order.customer.credit_limit

action approve(order: Order)
    require order.status == Pending
    require within_credit(order)
    effects db.write
    order.status = Approved
    save order

code OrderForm
    handler approve_clicked
        if not within_credit(order)
            message warning "The total is above the customer's credit limit"
            return
        approve(order)
        message "Order " + order.number + " is approved"
