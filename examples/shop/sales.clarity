module sales

use customers

enum OrderStatus
    Pending label @orderStatusPending
    Approved label @orderStatusApproved
    Shipped label @orderStatusShipped
    Cancelled label @orderStatusCancelled

entity Order
    number: text(12), unique, required, pattern "^ORD-[0-9]{8}$", label @orderNumberLabel
    customer: ref Customer, required, label @orderCustomerLabel
    status: OrderStatus, default Pending, label @orderStatusLabel
    orderedOn: date, required, label @orderOrderedOnLabel
    total: money, computed, label @orderTotalLabel
    remarks: text(200), label @orderRemarksLabel

entity OrderLine
    order: ref Order, required, label @orderLineOrderLabel
    product: text(80), required, label @orderLineProductLabel
    quantity: integer, default 1, min 1, label @orderLineQuantityLabel
    price: money, label @orderLinePriceLabel

// Prices an order from its lines, with volume discounts; its source is in
// engines/pricing.
engine Pricing from "pricing.wasm"
    function total(lines: list<OrderLine>) -> money

function withinCredit(order: Order) -> bool
    return order.total <= order.customer.creditLimit

// Says how an order stands against its customer's credit, in the person's
// language: a text with slots is translated wherever code makes it.
function creditNote(order: Order) -> text
    if withinCredit(order)
        return @orderNumberIsWithinThe(number = order.number)
    return @orderNumberIsAboveThe(number = order.number)

action approve(order: Order)
    require order.status == Pending
    require withinCredit(order)
    effects db.write
    order.status = Approved
    save order

code OrderBrowse
    handler filterChanged
        orders = find o in Order where o.number contains numberFilter.text order by o.number

code OrderBrowseView
    handler openOrderClicked
        order = ordersTable.selected
        lines = find l in OrderLine where l.order == order
        orderSlide.visible = true

    // A new order is stored once it has a number and a customer: Save, or its first line.
    handler newOrderClicked
        order = new Order
        order.orderedOn = today()
        lines = find l in OrderLine where l.order == order
        orderSlide.visible = true

    handler removeOrderClicked
        delete ordersTable.selected
        orderSlide.visible = false
        filterChanged()

code SalesDashboard
    handler dashboardOpened
        orders = find o in Order where o.status != Cancelled

code OrderEditor
    // A line belongs to a stored order, so the order is saved first.
    handler addLineClicked
        save order
        let line = new OrderLine
        line.order = order
        line.product = "New product"
        save line
        lines = find l in OrderLine where l.order == order
        tell saved()

    handler removeLineClicked
        delete linesGrid.selected
        lines = find l in OrderLine where l.order == order
        order.total = Pricing.total(lines)
        tell saved()

    handler lineChanged
        save linesGrid.selected
        order.total = Pricing.total(lines)
        tell saved()

    handler saveOrderClicked
        save order
        tell saved()
        message @savedName(name = order.number)

    handler approveClicked
        if not withinCredit(order)
            message warning creditNote(order)
            return
        approve(order)
        tell saved()
        message @orderNumberIsApproved(number = order.number)

code Order
    before save
        // The total is always what the stored lines cost.
        order.total = Pricing.total(find l in OrderLine where l.order == order)
        if order.status == Approved and not withinCredit(order)
            refuse @orderNumberIsOverIts(number = order.number)

    before delete
        if order.status != Pending
            refuse @onlyPendingOrdersCanBe
        for line in find l in OrderLine where l.order == order
            delete line
