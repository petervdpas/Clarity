module sales

use customers

enum OrderStatus
    Pending label @orderStatusPending
    Approved label @orderStatusApproved
    Shipped label @orderStatusShipped
    Cancelled label @orderStatusCancelled

entity Order
    number: text(12), unique, required, pattern "^ORD-[0-9]{8}$", label @orderNumberLabel
    customer: ref Customer, required, label @orderCustomerLabel
    status: OrderStatus, default Pending, label @orderStatusLabel
    ordered_on: date, required, label @orderOrderedOnLabel
    total: money, computed, label @orderTotalLabel
    remarks: text(200), label @orderRemarksLabel

entity OrderLine
    order: ref Order, required, label @orderLineOrderLabel
    product: text(80), required, label @orderLineProductLabel
    quantity: integer, default 1, min 1, label @orderLineQuantityLabel
    price: money, label @orderLinePriceLabel

// Prices an order from its lines, with volume discounts; its source is in
// engines/pricing.
engine Pricing from "pricing.wasm"
    function total(lines: list<OrderLine>) -> money

page OrderBrowse: window
    title @orderBrowseTitle
    data orders: list<Order>
    on return: windowReturned

    label @numberFilterLabel name numberFilterLabel at 1,1 span 2 for numberFilter
    textbox name numberFilter at 3,1 span 4 placeholder @numberFilterPlaceholder on change: filterChanged
    table name ordersTable at 1,2 span 12 rows 8 bind orders columns number, customer, ordered_on, status, total sortable order by ordered_on desc page 20
    button @newCaption name newOrder at 9,10 span 2 on click -> OrderForm
    button @openCaption name openOrder at 11,10 span 2 on click -> OrderForm

page OrderForm: window
    title @orderFormTitle
    data order: Order
    data lines: list<OrderLine>
    on open: orderOpened

    panel @orderPanelCaption name orderPanel at 1,1 span 12 rows 4
        label @orderNumberLabel name numberLabel at 1,1 span 2
        textbox name orderNumber at 3,1 span 4 bind order.number
        label @orderOrderedOnLabel name orderedOnLabel at 7,1 span 2
        date name orderedOn at 9,1 span 3 bind order.ordered_on
        label @orderCustomerLabel name customerLabel at 1,2 span 3
        dropdown name orderCustomer at 4,2 span 8 bind order.customer search show name, email
        label @orderStatusLabel name statusLabel at 1,3 span 3
        dropdown name orderStatus at 4,3 span 4 bind order.status
    table name linesGrid at 1,5 span 12 rows 4 bind lines columns product, quantity, price edit product, quantity, price on change: lineChanged
    button @addLineCaption name addLine at 1,9 span 2 on click: addLineClicked
    label @orderTotalLabel name totalLabel at 7,9 span 2
    number name orderTotal at 9,9 span 3 bind order.total readonly
    label @orderRemarksLabel name remarksLabel at 1,10 span 3
    textbox name orderRemarks at 4,10 span 6 bind order.remarks
    button @approveButtonCaption name approveButton at 7,11 span 2 on click: approveClicked
    button @saveCaption name saveOrder at 9,11 span 2
    button @closeCaption name closeOrder at 11,11 span 2

// How sales go: orders by status, money per day, and who spends it.
page SalesDashboard: window
    title @salesDashboardTitle
    data orders: list<Order>
    on open: dashboardOpened
    on return: dashboardOpened

    heading @ordersByStatusHeading name ordersByStatusHeading at 1,1 span 6
    heading @salesPerDayHeading name salesPerDayHeading at 7,1 span 6
    chart bar name statusChart at 1,2 span 6 rows 6 bind orders by status count
    chart line name salesChart at 7,2 span 6 rows 6 bind orders by ordered_on sum total
    heading @salesPerCustomerHeading name salesPerCustomerHeading at 1,8 span 12
    chart pie name customerChart at 1,9 span 12 rows 6 bind orders by customer sum total

function within_credit(order: Order) -> bool
    return order.total <= order.customer.credit_limit

// Says how an order stands against its customer's credit, in the person's
// language: a text with slots is translated wherever code makes it.
function credit_note(order: Order) -> text
    if within_credit(order)
        return @orderNumberIsWithinThe(number = order.number)
    return @orderNumberIsAboveThe(number = order.number)

action approve(order: Order)
    require order.status == Pending
    require within_credit(order)
    effects db.write
    order.status = Approved
    save order

code OrderBrowse
    handler windowReturned
        filterChanged()

    handler filterChanged
        orders = find o in Order where o.number contains numberFilter.text order by o.number

code SalesDashboard
    handler dashboardOpened
        orders = find o in Order where o.status != Cancelled

code OrderForm
    handler orderOpened
        lines = find l in OrderLine where l.order == order

    // A line belongs to a stored order, so the order is saved first.
    handler addLineClicked
        save order
        let line = new OrderLine
        line.order = order
        line.product = "New product"
        save line
        lines = find l in OrderLine where l.order == order

    handler lineChanged
        save linesGrid.selected
        order.total = Pricing.total(lines)

    handler approveClicked
        if not within_credit(order)
            message warning credit_note(order)
            return
        approve(order)
        message @orderNumberIsApproved(number = order.number)

code Order
    before save
        // The total is always what the stored lines cost.
        order.total = Pricing.total(find l in OrderLine where l.order == order)
        if order.status == Approved and not within_credit(order)
            refuse @orderNumberIsOverIts(number = order.number)

    before delete
        if order.status != Pending
            refuse @onlyPendingOrdersCanBe
        for line in find l in OrderLine where l.order == order
            delete line
