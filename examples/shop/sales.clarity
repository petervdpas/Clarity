module sales

use customers

enum OrderStatus
    Pending
    Approved
    Shipped
    Cancelled

entity Order
    number: text(12), unique, required, pattern "^ORD-[0-9]{8}$"
    customer: ref Customer, required
    status: OrderStatus, default Pending
    ordered_on: date, required
    total: money, computed
    remarks: text(200)

entity OrderLine
    order: ref Order, required
    product: text(80), required, label "Product"
    quantity: integer, default 1, min 1, label "Quantity"
    price: money, label "Price"

// Prices an order from its lines, with volume discounts; its source is in
// engines/pricing.
engine Pricing from "pricing.wasm"
    function total(lines: list<OrderLine>) -> money

page OrderBrowse: window
    title "Orders"
    data orders: list<Order>
    on return: window_returned

    label "Number" at 1,1 span 2 for number_filter
    textbox name number_filter at 3,1 span 4 placeholder "Part of the number" on change: filter_changed
    table at 1,2 span 12 rows 8 bind orders columns number, customer, ordered_on, status, total
    button "New" at 9,10 span 2 on click -> OrderForm
    button "Open" at 11,10 span 2 on click -> OrderForm

page OrderForm: window
    title "Order"
    data order: Order
    data lines: list<OrderLine>
    on open: order_opened

    panel "Order" at 1,1 span 12 rows 4
        label "Number" at 1,1 span 2
        textbox at 3,1 span 4 bind order.number
        label "Ordered on" at 7,1 span 2
        date at 9,1 span 3 bind order.ordered_on
        label "Customer" at 1,2 span 3
        dropdown at 4,2 span 4 bind order.customer
        label "Status" at 1,3 span 3
        dropdown at 4,3 span 4 bind order.status
    table name lines_grid at 1,5 span 12 rows 4 bind lines columns product, quantity, price edit product, quantity, price on change: line_changed
    button "Add line" at 1,9 span 2 on click: add_line_clicked
    label "Total" at 7,9 span 2
    number at 9,9 span 3 bind order.total readonly
    label "Remarks" at 1,10 span 3
    textbox at 4,10 span 6 bind order.remarks
    button "Approve" name approve_button at 7,11 span 2 on click: approve_clicked
    button "Save" at 9,11 span 2
    button "Close" at 11,11 span 2

function within_credit(order: Order) -> bool
    return order.total <= order.customer.credit_limit

action approve(order: Order)
    require order.status == Pending
    require within_credit(order)
    effects db.write
    order.status = Approved
    save order

code OrderBrowse
    handler window_returned
        filter_changed()

    handler filter_changed
        orders = find o in Order where o.number contains number_filter.text order by o.number

code OrderForm
    handler order_opened
        lines = find l in OrderLine where l.order == order

    // A line belongs to a stored order, so the order is saved first.
    handler add_line_clicked
        save order
        let line = new OrderLine
        line.order = order
        line.product = "New product"
        save line
        lines = find l in OrderLine where l.order == order

    handler line_changed
        save lines_grid.selected
        order.total = Pricing.total(lines)

    handler approve_clicked
        if not within_credit(order)
            message warning "The total is above the customer's credit limit"
            return
        approve(order)
        message "Order {order.number} is approved"

code Order
    before save
        // The total is always what the stored lines cost.
        order.total = Pricing.total(find l in OrderLine where l.order == order)
        if order.status == Approved and not within_credit(order)
            refuse "Order {order.number} is over its customer's credit limit"

    before delete
        if order.status != Pending
            refuse "Only pending orders can be deleted"
        for line in find l in OrderLine where l.order == order
            delete line
