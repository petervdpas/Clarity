module shop

use customers
use sales
use desk

// The application frame: shared by every window that has no region of its own.
app Shop
    title "Shop"
    main CustomerCard
    menu
        item "File"
            item "Customer card" key "Ctrl+K" on click -> CustomerCard
            separator
            item "Language" on click -> language
            item "Theme" on click -> theme
            item "Quit" key "Ctrl+Q" on click -> quit
        item "Customers"
            item "All customers" on click -> CustomerBrowse
            item "New customer" on click -> CustomerForm
        item "Orders"
            item "All orders" on click -> OrderBrowse
    toolbar
        button "Customers" icon "people" on click -> CustomerBrowse
        button "Orders" icon "cart" on click -> OrderBrowse
        separator
        button "Card" icon "card" on click -> CustomerCard
    footer
        status "Ready"

// How the shop looks. The project file names it with: theme Shop
theme Shop
    mode system
    color accent "#1f6f5c" dark "#4fb393"
    radius 4
    style primary background accent, text "#ffffff", border accent

// A second look for the shop: always dark, with a warmer accent.
theme Night
    title "Night"
    mode dark
    color accent "#e0a030"
    radius 8
    style primary background accent, text "#1a1a1a", border accent

// A bright look for daytime: always light, with a blue accent.
theme Day
    title "Day"
    mode light
    color background "#f4f6f9"
    color panel "#ffffff"
    color accent "#1f5fbf"
    color accent_soft "#e4edfb"
    font heading "Georgia, serif"
    size heading 20
    radius input 3
    radius button 14
    radius panel 10
    padding 5
    shadow flat
    part button background panel, border accent, text accent
    part button hover background accent_soft
    part input focus border accent
    part header background accent_soft, text accent
    part tab background background, text muted
    style primary background accent, text on_accent, border accent, weight bold
