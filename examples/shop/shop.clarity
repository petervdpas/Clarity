module shop

use customers
use sales
use desk

// The application frame: shared by every window that has no region of its own.
app Shop
    title @shopTitle
    main CustomerCard
    menu name mainMenu
        item @fileItem name fileItem
            item @customerCardItem name customerCardItem key "Ctrl+K" on click -> CustomerCard
            separator
            item @languageItem name languageItem on click -> language
            item @themeItem name themeItem on click -> theme
            item @quitItem name quitItem key "Ctrl+Q" on click -> quit
        item @customersItem name customersItem
            item @allCustomersItem name allCustomersItem on click -> CustomerBrowse
            item @newCustomerItem name newCustomerItem on click -> CustomerForm in new window
        item @ordersItem name ordersItem
            item @allOrdersItem name allOrdersItem on click -> OrderBrowse
    toolbar name mainToolbar
        button @customers2Caption name customers2 icon "users" on click -> CustomerBrowse
        button @orders2Caption name orders2 icon "shopping-cart" on click -> OrderBrowse
        separator
        button @cardButtonCaption name cardButton icon "credit-card" on click -> CustomerCard
    footer
        status @shopStatus

// How the shop looks. The project file names it with: theme Shop
theme Shop
    mode system
    color accent "#1f6f5c" dark "#4fb393"
    radius 4
    style primary background accent, text "#ffffff", border accent

// A second look for the shop: always dark, with a warmer accent.
theme Night
    title @nightTheme
    mode dark
    color accent "#e0a030"
    radius 8
    style primary background accent, text "#1a1a1a", border accent

// A bright look for daytime: always light, with a blue accent.
theme Day
    title @dayTheme
    mode light
    color background "#f4f6f9"
    color panel "#ffffff"
    color accent "#1f5fbf"
    color accent_soft "#e4edfb"
    font heading "Georgia, serif"
    size heading 20
    radius input 3
    radius button 14
    radius panel 10
    padding 5
    shadow flat
    part button background panel, border accent, text accent
    part button hover background accent_soft
    part input focus border accent
    part header background accent_soft, text accent
    part tab background background, text muted
    style primary background accent, text on_accent, border accent, weight bold
