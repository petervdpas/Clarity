<?xml version="1.0" encoding="UTF-8"?>
<!-- The window and the command line work on the same items. The table adds,
     edits and removes them itself: Add above it, the trash on each row. -->
<Window class="stock.Items" title="@itemsTitle" onopen="itemsOpened">
  <Content name="main" at="1,1" span="12" rows="10">
    <View name="ItemsView" />
  </Content>
</Window>
