module stock

// What the shop keeps, how many there are, and when to order more.
entity Item
    name: text(80), required, unique, label @itemNameLabel
    count: integer, min 0, label @itemCountLabel
    low: integer, default 5, min 0, label @itemLowLabel

/// Whether there are so few that more should be ordered.
function runsLow(item: Item) -> bool
    return item.count <= item.low

app Stock
    title @stockTitle
    main Items

// The window and the command line work on the same items. The table adds,
// edits and removes them itself: Add above it, the trash on each row.
page Items: window
    title @itemsTitle
    data items: list<Item>
    on open: itemsOpened

    table name grid at 1,1 span 12 rows 10 bind items columns name, count, low resizable sortable edit name, count, low add remove confirm on add: addClicked on remove: deleteClicked on change: itemChanged

code Items
    handler itemsOpened
        items = find i in Item order by i.name

    // A new item gets a name no other item has; the person types its own over it.
    handler addClicked
        let item = new Item
        item.name = freeName(@newItemName, find i in Item order by i.name)
        save item
        items = find i in Item order by i.name

    handler itemChanged
        save grid.selected

    handler deleteClicked
        delete grid.selected
        items = find i in Item order by i.name

// The word, or the word with the first number no item has.
function freeName(word: text, all: list<Item>) -> text
    let name = word
    let n = 1
    for step in 1 to 1000
        let taken = false
        for i in all
            if i.name == name
                taken = true
        if not taken
            return name
        n = n + 1
        name = "{word} {n}"
    return name

cli Stock
    help @stockHelp

command list
    help @listHelp
    option low: bool, help @listLowHelp
    let all = find i in Item order by i.name
    if low
        for item in all
            if runsLow(item)
                print @itemLine(name = item.name, count = item.count)
        return
    print all columns name, count, low

command add(name: text)
    help @addHelp
    option count: integer, min 0, help @addCountHelp
    option low: integer, default 5, min 0, help @addLowHelp
    let found = find i in Item where i.name == name
    if count(found) > 0
        refuse @itemExists(name = name)
    let item = new Item
    item.name = name
    item.count = count
    item.low = low
    save item
    print @itemAdded(name = name)

// Changes how many there are: `take` and `bring` with a number, both whole.
command take(name: text, number: integer)
    help @takeHelp
    let found = find i in Item where i.name == name
    if count(found) == 0
        refuse @noSuchItem(name = name)
    let item = found[1]
    if number > item.count
        refuse @tooFewLeft(name = name, left = item.count)
    item.count = item.count - number
    save item
    print @itemCountIs(name = name, count = item.count)
    if runsLow(item)
        message warning @itemRunsLow(name = name)

command bring(name: text, number: integer)
    help @bringHelp
    let found = find i in Item where i.name == name
    if count(found) == 0
        refuse @noSuchItem(name = name)
    let item = found[1]
    item.count = item.count + number
    save item
    print @itemCountIs(name = name, count = item.count)

// For scripts: ends with exit code 3 when any item runs low.
command check
    help @checkHelp
    let all = find i in Item order by i.name
    let short = false
    for item in all
        if runsLow(item)
            print item.name
            short = true
    if short
        exit 3
