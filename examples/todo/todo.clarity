module todo

entity Person
    name: text(80), required, unique, label @personNameLabel
    color: color, default "#3b82f6", label @personColorLabel

entity Task
    title: text(120), required, search, label @taskTitleLabel
    done: bool, default false, label @taskDoneLabel
    finished_by: ref Person, label @taskFinishedByLabel

// What each person sets for themselves, kept on their machine.
settings
    language
    theme
    showDone: bool, default true, label @settingsShowDoneLabel

app Todo
    title @todoTitle
    main Main
    menu name mainMenu
        item @fileItem name fileItem
            item @usersItem name usersItem on click -> Users
            separator
            item @languageItem name languageItem on click -> language
            item @themeItem name themeItem on click -> theme
            item @preferencesItem name preferencesItem on click -> Preferences
            separator
            item @quitItem name quitItem key "Ctrl+Q" on click -> quit
    // A ribbon the person folds to its tabs with a double click.
    ribbon name mainRibbon collapsible
        tab @homeTab name homeTab
            group @peopleGroup name peopleGroup
                button @usersButtonCaption name usersButton icon "list" large on click -> Users
            group @settingsGroup name settingsGroup
                button @languageButtonCaption name languageButton icon "languages" large on click -> language
                button @themeButtonCaption name themeButton large on click -> theme

page Main: window
    title @mainTitle
    data tasks: list<Task>
    on open: windowOpened
    on return: windowReturned

    label @searchLabel name searchLabel at 1,1 span 2 for searchBox
    textbox name searchBox at 3,1 span 10 placeholder @searchPlaceholder on change: showTasks
    // The table adds and removes its tasks itself: Add above it, the trash on each row.
    table name grid at 1,2 span 12 rows 9 bind tasks columns title, done, finished_by resizable edit title, done as switch, finished_by add remove confirm on add: addClicked on remove: deleteClicked on change: taskChanged
    button @usersButtonCaption name usersButton at 1,12 span 2 on click -> Users

page Users: window
    title @usersTitle
    data people: list<Person>
    on open: usersOpened
    // This window has its own menu and ribbon: they lead back to Main, not to Users.
    menu name usersMenu
        item @fileItem name usersFileItem
            item @mainItem name mainItem on click -> close
            separator
            item @languageItem name usersLanguageItem on click -> language
            item @themeItem name usersThemeItem on click -> theme
            separator
            item @quitItem name usersQuitItem key "Ctrl+Q" on click -> quit
    ribbon name usersRibbon collapsible
        tab @homeTab name usersHomeTab
            group @peopleGroup name usersPeopleGroup
                button @mainButtonCaption name mainButton icon "list" large on click -> close
            group @settingsGroup name usersSettingsGroup
                button @languageButtonCaption name usersLanguageButton icon "languages" large on click -> language
                button @themeButtonCaption name usersThemeButton large on click -> theme

    // A person picked opens in the editor that slides out from the right.
    table name peopleGrid at 1,1 span 12 rows 9 bind people columns name, color resizable sortable add remove on add: newClicked on remove: deletePersonClicked on select: personSelected
    slideout @personSlideout name personPanel view PersonEditor width 460 pinnable span 6 rows 4 on close: personPanelClosed
    button @closeButtonCaption name closeButton at 11,11 span 2 cancel on click: closeClicked

// A person: their name and the color their tasks show in.
page PersonEditor: view
    data person: Person

    form name personForm at 1,1 span 6 rows 2 bind person
        label @nameLabel name nameLabel at 1,1 span 2 for name
        textbox name name at 3,1 span 4 bind person.name placeholder @namePlaceholder
        label @colorLabel name colorLabel at 1,2 span 2 for colorBox
        color name colorBox at 3,2 span 3 bind person.color
    help name nameHelp at 3,3 span 4 for name
    button @saveButtonCaption name saveButton at 5,4 span 2 key "Ctrl+S" default on click: saveClicked

page Preferences: dialog
    title @preferencesTitle

    form name settingsForm at 1,1 span 12 rows 3 bind settings labels 3
        dropdown name languageBox at 4,1 span 6 bind settings.language
        dropdown name themeBox at 4,2 span 6 bind settings.theme
        checkbox @settingsShowDoneLabel name showDoneBox at 4,3 span 6 bind settings.showDone
    button @closeButtonCaption name closeButton at 11,5 span 2 cancel on click -> close

code Main
    handler windowOpened
        showTasks()

    handler windowReturned
        // Users may have been added, changed or removed, and the settings changed.
        showTasks()

    handler showTasks
        // Done tasks show while the person's settings say so; the search
        // box keeps the tasks with every word typed in their title.
        if settings.showDone
            tasks = find t in Task where t matches searchBox.text
        else
            tasks = find t in Task where t.done == false and t matches searchBox.text

    // A new task gets a title the person types over in its row.
    handler addClicked
        let task = new Task
        task.title = @newTaskTitle
        save task
        showTasks()

    handler taskChanged
        save grid.selected

    handler deleteClicked
        let task = grid.selected
        delete task
        showTasks()

code Users
    handler usersOpened
        reload people

    handler personSelected
        person = peopleGrid.selected
        name.error = ""
        personPanel.visible = true

    handler newClicked
        person = new Person
        name.error = ""
        personPanel.visible = true

    // A person who finished tasks stays; any other is removed after the question, asked here in code.
    handler deletePersonClicked
        let gone = peopleGrid.selected
        let tasks = find t in Task where t.finished_by == gone
        if count(tasks) > 0
            message error @nameHasFinishedTasksAnd(name = gone.name)
            return
        ask @deletePerson(name = gone.name) yes @deletePersonYes no @keepPerson then deleteConfirmed

    handler deleteConfirmed
        delete peopleGrid.selected
        reload people
        person = new Person
        personPanel.visible = false

    // What the editor saved shows in the table once it slides away.
    handler personPanelClosed
        reload people

    handler closeClicked
        close

code PersonEditor
    handler saveClicked
        name.error = ""
        if person.name == ""
            name.error = @nameIsRequired
            return
        save person
        message @savedName(name = person.name)
