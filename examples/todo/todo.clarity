module todo

entity Person
    name: text(80), required, unique, label @personNameLabel

entity Task
    title: text(120), required, label @taskTitleLabel
    done: bool, default false, label @taskDoneLabel
    finished_by: ref Person, label @taskFinishedByLabel

app Todo
    title @todoTitle
    main Main
    menu name mainMenu
        item @fileItem name fileItem
            item @usersItem name usersItem on click -> Users
            separator
            item @languageItem name languageItem on click -> language
            separator
            item @quitItem name quitItem key "Ctrl+Q" on click -> quit
    // A ribbon the person folds to its tabs with a double click.
    ribbon name mainRibbon collapsible
        tab @homeTab name homeTab
            group @peopleGroup name peopleGroup
                button @usersButtonCaption name usersButton icon "list" large on click -> Users
            group @settingsGroup name settingsGroup
                button @languageButtonCaption name languageButton icon "language" large on click -> language

page Main: window
    title @mainTitle
    data tasks: list<Task>
    on open: windowOpened
    on return: windowReturned

    label @newTitleLabel name newTitleLabel at 1,1 span 2 for newTitle
    textbox name newTitle at 3,1 span 8 placeholder @newTitlePlaceholder
    button @addButtonCaption name addButton at 11,1 span 2 default on click: addClicked
    table name grid at 1,2 span 12 rows 8 bind tasks columns title, done, finished_by edit title, done as switch, finished_by on select: rowSelected on change: taskChanged
    button @usersButtonCaption name usersButton at 1,10 span 2 on click -> Users
    button @deleteButtonCaption name deleteButton at 11,10 span 2 on click: deleteClicked

page Users: window
    title @usersTitle
    data people: list<Person>
    data person: Person
    on open: usersOpened

    table name peopleGrid at 1,1 span 12 rows 6 bind people columns name on select: personSelected
    form name personForm at 1,7 span 12 rows 1 bind person
        label @nameLabel name nameLabel at 1,1 span 2 for name
        textbox name name at 3,1 span 8 bind person.name placeholder @namePlaceholder
        help name nameHelp at 11,1 span 2 for name
    button @newButtonCaption name newButton at 5,9 span 2 on click: newClicked
    button @saveButtonCaption name saveButton at 7,9 span 2 key "Ctrl+S" default on click: saveClicked
    button @deletePersonButtonCaption name deletePersonButton at 9,9 span 2 on click: deletePersonClicked
    button @closeButtonCaption name closeButton at 11,9 span 2 cancel on click: closeClicked

code Main
    handler windowOpened
        deleteButton.enabled = false

    handler windowReturned
        // Users may have been added, changed or removed.
        reload tasks
        deleteButton.enabled = false

    handler rowSelected
        deleteButton.enabled = true

    handler addClicked
        if newTitle.text == ""
            message warning @pleaseTypeATaskFirst
            return
        let task = new Task
        task.title = newTitle.text
        save task
        newTitle.text = ""
        reload tasks

    handler taskChanged
        save grid.selected

    handler deleteClicked
        let task = grid.selected
        delete task
        reload tasks
        deleteButton.enabled = false

code Users
    handler usersOpened
        deletePersonButton.enabled = false

    handler personSelected
        person = peopleGrid.selected
        name.error = ""
        deletePersonButton.enabled = true

    handler newClicked
        person = new Person
        name.error = ""
        deletePersonButton.enabled = false

    handler saveClicked
        name.error = ""
        if person.name == ""
            name.error = @nameIsRequired
            return
        save person
        reload people
        message @savedName(name = person.name)

    handler deletePersonClicked
        let tasks = find t in Task where t.finished_by == person
        if count(tasks) > 0
            message error @nameHasFinishedTasksAnd(name = person.name)
            return
        delete person
        reload people
        person = new Person
        deletePersonButton.enabled = false

    handler closeClicked
        close
