module waves

// A swell worth keeping: how high the water stood and when it was seen.
entity Swell
    height: integer, label @swellHeightLabel
    seen: datetime, label @swellSeenLabel

// Water drawn by a Go package: waves run out from a few sources and meet,
// and the part colours every pixel by how high the water stands there. The
// part draws into a buffer of its own and puts it on Clarity.UI's canvas.
part WaveField
    go "parts/WaveField"
    speed: integer, min 1, max 10, default 4
    sources: integer, min 1, max 5, default 3
    tells swelled(height: integer)
    hears calm
    size 8 x 10

code WaterView
    handler waterSwelled(height: integer)
        highest = height
        let swell = new Swell
        swell.height = height
        swell.seen = now()
        save swell
        reload swells

    handler speedChanged
        waveField.speed = speed

    handler sourcesChanged
        waveField.sources = sources

    handler calmClicked
        highest = 0
        waveField.calm()
