<!-- The desktop's own of the runtime of C# applications generated by Clarity
     (DESIGN 7.6): native windows through Avalonia.Desktop, sound through
     SoundFlow, the shell that shows the windows in desktop windows, quitting
     and the keys window. A generated desktop program references it; it
     brings Clarity.Avalonia. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Avalonia</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The NuGet package, made on every build; its shared settings are in ../Directory.Build.props. -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Clarity.Avalonia.Desktop</PackageId>
    <Description>The desktop's own of the C# applications generated by Clarity: native windows on Windows, macOS and Linux, sound through SoundFlow, the shell that shows the windows, quitting and the keys window. Brings Clarity.Avalonia.</Description>
    <PackageTags>clarity;avalonia;ui;desktop</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <!-- The sound part's output (DESIGN 5.22): miniaudio for Windows, macOS and Linux, MIT. -->
    <PackageReference Include="SoundFlow" Version="1.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Avalonia/Clarity.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="../assets/LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
</Project>
