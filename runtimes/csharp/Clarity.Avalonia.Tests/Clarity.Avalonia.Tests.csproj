    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Avalonia/Clarity.Avalonia.csproj" />
    <ProjectReference Include="../Clarity.Runtime.Sqlite/Clarity.Runtime.Sqlite.csproj" />
    <ProjectReference Include="../Clarity.Avalonia.Desktop/Clarity.Avalonia.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The cases every stack shares. -->
    <None Include="../../../conformance/*.json" LinkBase="conformance" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
