<!-- The Avalonia half of the runtime of C# applications generated by
     Clarity: part state, the base of every window's ViewModel, opening and
     closing windows, and messages. Copied into every generated project with
     Clarity.Runtime, so a project builds on its own. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Avalonia</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The NuGet package. -->
    <PackageId>Clarity.Avalonia</PackageId>
    <Version>0.1.0</Version>
    <Authors>Peter van de Pas</Authors>
    <Description>The Avalonia half of the runtime of C# applications generated by Clarity: Clarity's own parts (table, choice box, date and time), window view models, opening and closing windows, languages, themes and messages.</Description>
    <PackageTags>clarity;avalonia;ui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Runtime/Clarity.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
