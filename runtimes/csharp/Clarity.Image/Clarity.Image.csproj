<!-- Clarity.Image for C# (docs/IMAGE-PLAN.md): the native Clarity.Image
     library and the picture functions of code on it (resize, crop, rotate,
     flip, blend, adjust, a picture's size). Clarity's generator adds it to a
     program whose code calls one. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Image</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Clarity.Image</PackageId>
    <Description>Clarity.Image for C#: the picture functions of applications generated by Clarity (resize, crop, rotate, flip, blend, adjust), giving the same pixels as every other stack, on Linux, Windows and macOS.</Description>
    <PackageTags>clarity;image;picture</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Runtime/Clarity.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="../assets/LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>

  <!-- The native Clarity.Image library (runtimes/rust-image-ffi), one
       per system, as Clarity.Ui carries Clarity.UI's. The package carries the folder
       runtimes/<rid>/native/ of this project as it is, and .NET loads the
       file for the system the program runs on. The release workflow
       (.github/workflows/release-csharp-runtime.yml) fills all six systems;
       a local Release build copies the one cargo built here (package
       clarity-image-ffi, release profile) into this system's folder, so a local
       package carries that one system. Every build also puts this
       system's library next to the output, from target/release or
       target/debug (else from this folder), for the tests and for programs
       built on the projects (ClarityRuntime). -->
  <PropertyGroup>
    <ClarityNativeName>clarity_image</ClarityNativeName>
    <ClarityCargoTarget>$(MSBuildThisFileDirectory)../../../target/</ClarityCargoTarget>
    <ClarityNativeRid>$(NETCoreSdkRuntimeIdentifier)</ClarityNativeRid>
    <ClarityNativeFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(ClarityNativeName).dll</ClarityNativeFile>
    <ClarityNativeFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">lib$(ClarityNativeName).dylib</ClarityNativeFile>
    <ClarityNativeFile Condition="'$(ClarityNativeFile)' == ''">lib$(ClarityNativeName).so</ClarityNativeFile>
    <ClarityNativeProfile Condition="'$(Configuration)' == 'Release'">release</ClarityNativeProfile>
    <ClarityNativeProfile Condition="'$(Configuration)' != 'Release'">debug</ClarityNativeProfile>
    <ClarityNativeBuilt>$(ClarityCargoTarget)$(ClarityNativeProfile)/$(ClarityNativeFile)</ClarityNativeBuilt>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The library next to the output: cargo's, else the one placed for packing (as the release workflow does). -->
    <ClarityNativeOutput Condition="Exists('$(ClarityNativeBuilt)')">$(ClarityNativeBuilt)</ClarityNativeOutput>
    <ClarityNativeOutput Condition="'$(ClarityNativeOutput)' == '' And Exists('$(MSBuildThisFileDirectory)runtimes/$(ClarityNativeRid)/native/$(ClarityNativeFile)')">$(MSBuildThisFileDirectory)runtimes/$(ClarityNativeRid)/native/$(ClarityNativeFile)</ClarityNativeOutput>
  </PropertyGroup>
  <ItemGroup Condition="'$(ClarityNativeOutput)' != ''">
    <None Include="$(ClarityNativeOutput)" Link="$(ClarityNativeFile)" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
  <Target Name="ClarityNativeFromCargo" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' And Exists('$(ClarityNativeBuilt)')">
    <Copy SourceFiles="$(ClarityNativeBuilt)" DestinationFolder="$(MSBuildThisFileDirectory)runtimes/$(ClarityNativeRid)/native" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="ClarityNativeInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <ClarityNativePacked Include="$(MSBuildThisFileDirectory)runtimes/**/*" />
      <None Include="@(ClarityNativePacked)" Pack="true" PackagePath="runtimes/" />
    </ItemGroup>
    <Warning Condition="'@(ClarityNativePacked)' == '' And '$(Configuration)' == 'Release'" Text="Clarity.Image is packed without its native library: build runtimes/rust-image-ffi first (cargo build --release -p clarity-image-ffi)." />
  </Target>
</Project>
