<!-- PostgreSQL for C# applications generated by Clarity: the driver,
     through Npgsql, which a program turns on with PostgreSql.Use(). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Runtime</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The NuGet package, made by dotnet pack (which builds first); its shared settings are in ../Directory.Build.props. -->
    <IsPackable>true</IsPackable>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Clarity.Runtime.PostgreSql</PackageId>
    <Description>PostgreSQL for C# applications generated by Clarity: the database driver of Clarity.Runtime, through Npgsql.</Description>
    <PackageTags>clarity;postgresql;postgres;database</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Runtime/Clarity.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="../assets/LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
</Project>
