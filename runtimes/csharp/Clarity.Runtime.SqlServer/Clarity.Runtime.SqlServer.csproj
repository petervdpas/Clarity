<!-- SQL Server for C# applications generated by Clarity: the driver,
     through Microsoft.Data.SqlClient, which a program turns on with SqlServer.Use(). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Runtime</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The NuGet package, made on every build; its shared settings are in ../Directory.Build.props. -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Clarity.Runtime.SqlServer</PackageId>
    <Description>SQL Server for C# applications generated by Clarity: the database driver of Clarity.Runtime, through Microsoft.Data.SqlClient.</Description>
    <PackageTags>clarity;sqlserver;mssql;database</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient's own pick has known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Runtime/Clarity.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="../assets/LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
</Project>
