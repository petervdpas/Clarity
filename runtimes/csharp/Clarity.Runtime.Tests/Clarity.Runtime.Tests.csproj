<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Runtime/Clarity.Runtime.csproj" />
    <ProjectReference Include="../Clarity.Runtime.Sqlite/Clarity.Runtime.Sqlite.csproj" />
    <ProjectReference Include="../Clarity.Runtime.PostgreSql/Clarity.Runtime.PostgreSql.csproj" />
    <ProjectReference Include="../Clarity.Runtime.MySql/Clarity.Runtime.MySql.csproj" />
    <ProjectReference Include="../Clarity.Runtime.SqlServer/Clarity.Runtime.SqlServer.csproj" />
    <ProjectReference Include="../Clarity.Runtime.Engines/Clarity.Runtime.Engines.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The cases every stack's runtime shares. -->
    <None Include="../../../conformance/*.json" LinkBase="conformance" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../conformance/engines/*.wasm" LinkBase="conformance/engines" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
