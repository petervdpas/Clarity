<!-- The runtime library of C# applications generated by Clarity: records,
     storage, queries, migrations and contract checks. Written by hand once
     and copied into every generated project, so a project builds on its own. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Runtime</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The NuGet package, made on every build; its shared settings are in ../Directory.Build.props. -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not every public member has its own doc comment yet. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Clarity.Runtime</PackageId>
    <Description>The runtime of C# applications generated by Clarity: records, storage on SQLite (and on PostgreSQL, MySQL and SQL Server with their Clarity.Runtime packages), queries, migrations, formats and contract checks.</Description>
    <PackageTags>clarity;runtime;database;migrations</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- The server drivers, each a package of its own, build on the runtime's storage. -->
    <InternalsVisibleTo Include="Clarity.Runtime.PostgreSql" />
    <InternalsVisibleTo Include="Clarity.Runtime.MySql" />
    <InternalsVisibleTo Include="Clarity.Runtime.SqlServer" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="../assets/LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
</Project>
