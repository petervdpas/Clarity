<!-- The runtime library of C# applications generated by Clarity: records,
     storage, queries, migrations and contract checks. Written by hand once
     and copied into every generated project, so a project builds on its own. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Runtime</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The NuGet package. -->
    <PackageId>Clarity.Runtime</PackageId>
    <Description>The runtime of C# applications generated by Clarity: records, storage on SQLite, PostgreSQL, MySQL and SQL Server, queries, migrations, formats and contract checks.</Description>
    <PackageTags>clarity;runtime;database;migrations</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Every server driver, for the runtime's own tests; a generated project
         defines only those its data sources use. -->
    <DefineConstants>$(DefineConstants);CLARITY_POSTGRES;CLARITY_MYSQL;CLARITY_MSSQL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient's own pick has known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
