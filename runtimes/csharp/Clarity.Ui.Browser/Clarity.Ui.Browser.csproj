<!-- Clarity.UI in a browser page (DESIGN 7.9): the same screen, compiled to
     WebAssembly, drawn by Skia's WebAssembly build onto the page's canvas. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Clarity.Ui.Browser</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Clarity.Ui.Browser</PackageId>
    <Description>Clarity.UI in a browser page: a screen of Clarity's UI framework compiled to WebAssembly and drawn by Skia onto the page's canvas, as on the desktop.</Description>
    <PackageTags>clarity;ui;skia;webassembly;browser</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <!-- Skia for WebAssembly, linked into the page's program. -->
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.148.0" />
    <!-- HarfBuzz for WebAssembly, so the page shapes text as the desktop does. -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Clarity.UI's drawing in C# (the folder Clarity.Ui.Drawing), until the native library is built for
         the browser (DESIGN 7.9, R2): compiled into this assembly, so it is no package of its own, and
         nothing else uses it. What it draws with, and HarfBuzz and SVG pictures, as before. -->
    <Compile Include="../Clarity.Ui.Drawing/**/*.cs" Exclude="../Clarity.Ui.Drawing/bin/**;../Clarity.Ui.Drawing/obj/**" LinkBase="Drawing" />
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.148.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <ProjectReference Include="../Clarity.Runtime/Clarity.Runtime.csproj" />
    <EmbeddedResource Include="../Clarity.Ui.Drawing/Themes/*.json" LogicalName="Clarity.Ui.Themes.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Clarity.Ui.Drawing/Fonts/*.ttf" LogicalName="Clarity.Ui.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../web/src/generated/part-defaults.json;../../web/src/generated/part-fields.json;../../web/src/generated/command-defaults.json;../../web/src/generated/command-fields.json;../../web/src/generated/sidebar-defaults.json;../../web/src/generated/sidebar-fields.json" LogicalName="Clarity.Ui.Catalog.%(Filename)%(Extension)" />
    <None Include="../Clarity.Ui.Drawing/Fonts/Inter-LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
  <ItemGroup>
    <!-- What the page runs beside the program: the canvas, and what the person does on it. -->
    <EmbeddedResource Include="clarity-ui.js" LogicalName="Clarity.Ui.Browser.clarity-ui.js" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clarity.Ui.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="../assets/LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
</Project>
