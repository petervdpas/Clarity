<!-- Clarity.UI on the desktop (DESIGN 7.9): a screen in the system's own
     window, drawn by Skia through OpenGL, on Linux, Windows and macOS. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Ui.Desktop</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Clarity.Ui.Desktop</PackageId>
    <Description>Clarity.UI on the desktop: a screen of Clarity's UI framework in the system's own window, drawn by Skia, on Linux, Windows and macOS.</Description>
    <PackageTags>clarity;ui;skia;desktop</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- The system's window, its OpenGL and its input, on every desktop. -->
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <!-- Skia's native library on each system. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.148.0" />
    <!-- The sound part's output (DESIGN 5.22): miniaudio on Windows, macOS and Linux, MIT. -->
    <PackageReference Include="SoundFlow" Version="1.4.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clarity.Ui.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Ui/Clarity.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="../assets/LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
</Project>
