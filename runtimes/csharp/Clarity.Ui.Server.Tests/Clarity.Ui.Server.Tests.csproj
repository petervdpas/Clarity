<!-- The tests of a program served to browsers (DESIGN 7.6, 7.9): the server
     (Clarity.Ui.Server), which serves the browser files and the program's
     files and answers Clarity.UI's commands in the browser through the
     runtime's ProgramWire, as the desktop does. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Ui.Server/Clarity.Ui.Server.csproj" />
    <!-- A served program whose people sign in (WebServerSigninTests): its session cookie. -->
    <ProjectReference Include="../Clarity.Auth/Clarity.Auth.csproj" />
    <ProjectReference Include="../Clarity.Runtime.Sqlite/Clarity.Runtime.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- What a generated application carries: the windows' markup, a theme,
         the model, a resource and (small stand-ins of) the browser files. -->
    <EmbeddedResource Include="Windows/*.cxaml" LogicalName="Windows/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Carried/**" LogicalName="$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
