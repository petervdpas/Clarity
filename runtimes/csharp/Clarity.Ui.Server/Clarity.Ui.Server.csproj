<!-- The server of a Clarity.UI program shown in browsers (DESIGN 7.6, 7.9):
     the library in the browser asks the program here, which answers through
     the runtime's ProgramWire as on the desktop; it serves the browser files
     and the program's files. It draws nothing, so it takes the runtime alone,
     not the native library. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Ui.Server</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Clarity.Ui.Server</PackageId>
    <Description>The server of a Clarity.UI program shown in browsers: Clarity.UI runs in the browser and asks the program on the server, where the windows' handlers run against the server's databases; it serves the browser files and the program's files over HTTP.</Description>
    <PackageTags>clarity;ui;server;browser</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Runtime/Clarity.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clarity.Ui.Server.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="../assets/LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
</Project>
