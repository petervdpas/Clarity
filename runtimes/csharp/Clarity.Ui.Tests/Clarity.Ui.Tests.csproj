<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Skia's native library, to draw in the tests as the desktop does. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The C# drawing the browser host keeps until the browser build (R2); the desktop is the native library's, tested in Rust. -->
    <ProjectReference Include="../Clarity.Ui.Browser/Clarity.Ui.Browser.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The cases every stack shares. -->
    <None Include="../../../conformance/*.json" LinkBase="conformance" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fonts with Arabic and Hebrew (Noto, SIL Open Font License, see Fonts/Noto-LICENSE.txt), so shaping is tested alike on every machine. -->
    <None Include="Fonts/*.ttf;Fonts/Noto-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Clarity.Ui" />
    <Using Include="SkiaSharp" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
