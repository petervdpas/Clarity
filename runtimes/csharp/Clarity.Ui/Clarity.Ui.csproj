<!-- Clarity.UI for C# (DESIGN 7.9): Clarity's own UI framework, drawing
     with Skia as Avalonia does. So far its model half: the base of every
     window's view model, the state of its parts, and what the runtime
     decides. Clarity.Avalonia, the alternative and reference, draws the same
     model. It brings Clarity.Runtime. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clarity.Ui</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The NuGet package, made on every build; its shared settings are in ../Directory.Build.props. -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>bin/$(Configuration)</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not every public member has its own doc comment yet. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Clarity.Ui</PackageId>
    <Description>Clarity.UI for C#: the UI framework of applications generated by Clarity, drawing with Skia. So far its model half: window view models, the state of their parts, and what the runtime decides. Clarity.Avalonia draws the same model with Avalonia.</Description>
    <PackageTags>clarity;ui;skia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- What it draws with, on every system and in the browser (DESIGN 7.9); the hosts bring the native library. -->
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Clarity.Runtime/Clarity.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Clarity.Avalonia" />
    <InternalsVisibleTo Include="Clarity.Avalonia.Desktop" />
    <InternalsVisibleTo Include="Clarity.Avalonia.Tests" />
    <InternalsVisibleTo Include="Clarity.Web" />
  </ItemGroup>
  <ItemGroup>
    <!-- Clarity's own theme as Clarity resolves it, and the font for where the system has none. -->
    <EmbeddedResource Include="Themes/*.json" LogicalName="Clarity.Ui.Themes.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fonts/*.ttf" LogicalName="Clarity.Ui.Fonts.%(Filename)%(Extension)" />
    <None Include="Fonts/Inter-LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../assets/icon.png" Pack="true" PackagePath="assets/" />
    <None Include="../assets/LICENSE.txt" Pack="true" PackagePath="assets/" />
  </ItemGroup>
</Project>
